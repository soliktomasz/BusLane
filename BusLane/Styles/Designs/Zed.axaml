<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Zed design - element layer added after AppStyles.axaml while Design = Zed (App.ApplyTheme).
        Selectors repeat the AppStyles ones, so these setters win by order; everything not
        set here falls through to the base style. Colors, fonts and radii come from the Zed
        palettes (Styles/Themes/Zed*.axaml), so this file is only shape, density and type.

        Zed language, as on zed.dev and in the editor:
          - one monospace face (Lilex) at 12-13px, Regular weight on controls
          - 1px hairline borders, 4px controls, near-square panels, no drop shadows
          - ghost buttons transparent until hover; primary is an accent tint with accent border
          - dense chrome: ~28px controls, ~24px list rows, flush tabs
    -->

    <!-- ── Base type ─────────────────────────────────────────────────────── -->
    <Style Selector="Window">
        <Setter Property="FontSize" Value="13"/>
    </Style>

    <Style Selector="TextBlock.display"><Setter Property="FontSize" Value="28"/><Setter Property="LineHeight" Value="36"/></Style>
    <Style Selector="TextBlock.title-large"><Setter Property="FontSize" Value="20"/><Setter Property="LineHeight" Value="28"/></Style>
    <Style Selector="TextBlock.title"><Setter Property="FontSize" Value="18"/><Setter Property="LineHeight" Value="24"/></Style>
    <Style Selector="TextBlock.title-small"><Setter Property="FontSize" Value="16"/></Style>
    <Style Selector="TextBlock.heading-large"><Setter Property="FontSize" Value="15"/></Style>
    <Style Selector="TextBlock.heading"><Setter Property="FontSize" Value="14"/></Style>
    <Style Selector="TextBlock.entity-header-title"><Setter Property="FontSize" Value="16"/></Style>
    <Style Selector="TextBlock.body"><Setter Property="FontSize" Value="13"/></Style>
    <Style Selector="TextBlock.body-strong"><Setter Property="FontSize" Value="13"/></Style>
    <Style Selector="TextBlock.subtitle"><Setter Property="FontSize" Value="12"/></Style>
    <Style Selector="TextBlock.caption"><Setter Property="FontSize" Value="11"/></Style>
    <Style Selector="TextBlock.form-section-title"><Setter Property="FontSize" Value="13"/></Style>
    <Style Selector="TextBlock.overview-panel-title"><Setter Property="FontSize" Value="13"/></Style>
    <Style Selector="TextBlock.overview-row-title"><Setter Property="FontSize" Value="13"/></Style>
    <Style Selector="TextBlock.overview-metric-value"><Setter Property="FontSize" Value="20"/></Style>
    <Style Selector="TextBlock.workspace-tab-title"><Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="Regular"/></Style>
    <Style Selector="TextBlock.menu-item-label"><Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="Regular"/></Style>
    <Style Selector="TextBlock.message-preview-text"><Setter Property="FontSize" Value="12"/></Style>

    <!-- ── Buttons ───────────────────────────────────────────────────────── -->
    <!-- Primary: accent tint + accent hairline, regular weight, not a solid fill -->
    <Style Selector="Button.primary">
        <Setter Property="Background" Value="{DynamicResource AccentBrandSubtle}"/>
        <Setter Property="Foreground" Value="{DynamicResource AppForeground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrand}"/>
        <Setter Property="Padding" Value="10,4"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Regular"/>
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrandHover}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrand}"/>
        <Setter Property="Foreground" Value="{DynamicResource AppForeground}"/>
    </Style>
    <Style Selector="Button.primary:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SelectedBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrand}"/>
        <Setter Property="Foreground" Value="{DynamicResource AppForeground}"/>
    </Style>
    <Style Selector="Button.primary:focus-visible /template/ ContentPresenter">
        <Setter Property="BoxShadow" Value="{DynamicResource FocusRingAccent}"/>
    </Style>

    <!-- Secondary: filled element, hairline border -->
    <Style Selector="Button.secondary">
        <Setter Property="Background" Value="{DynamicResource LayerBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderDefault}"/>
        <Setter Property="Padding" Value="10,4"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>
    <Style Selector="Button.secondary:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource TabItemHover}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderDefault}"/>
    </Style>
    <Style Selector="Button.secondary:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ToolbarPressed}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderDefault}"/>
    </Style>

    <!-- Danger and warning follow the primary recipe in their semantic color -->
    <Style Selector="Button.danger">
        <Setter Property="Background" Value="{DynamicResource SurfaceDanger}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextDanger}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource TextDanger}"/>
        <Setter Property="Padding" Value="10,4"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Regular"/>
    </Style>
    <Style Selector="Button.danger:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource DangerSubtle}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextDangerHover}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource TextDangerHover}"/>
    </Style>
    <Style Selector="Button.danger:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SurfaceDanger}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextDanger}"/>
    </Style>
    <Style Selector="Button.danger:focus-visible /template/ ContentPresenter">
        <Setter Property="BoxShadow" Value="{DynamicResource FocusRingDanger}"/>
    </Style>

    <Style Selector="Button.warning">
        <Setter Property="Background" Value="{DynamicResource SurfaceWarning}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextWarning}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource TextWarning}"/>
        <Setter Property="Padding" Value="10,4"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Regular"/>
    </Style>
    <Style Selector="Button.warning:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource WarningSubtle}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextWarningHover}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource TextWarningHover}"/>
    </Style>
    <Style Selector="Button.warning:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SurfaceWarning}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextWarning}"/>
    </Style>

    <Style Selector="Button.danger-outline"><Setter Property="Padding" Value="10,4"/><Setter Property="FontSize" Value="12"/></Style>
    <Style Selector="Button.danger-subtle"><Setter Property="Padding" Value="8,4"/><Setter Property="FontSize" Value="12"/></Style>
    <Style Selector="Button.subtle"><Setter Property="Padding" Value="8,4"/><Setter Property="FontSize" Value="12"/></Style>
    <Style Selector="Button.small"><Setter Property="Padding" Value="6,2"/><Setter Property="FontSize" Value="11"/></Style>
    <Style Selector="Button.toolbar"><Setter Property="Padding" Value="6,3"/></Style>
    <Style Selector="Button.chip">
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusSmall}"/>
        <Setter Property="Padding" Value="8,3"/>
    </Style>

    <!-- Ghost icon buttons at Zed's 24-28px -->
    <Style Selector="Button.icon"><Setter Property="Padding" Value="5"/><Setter Property="MinHeight" Value="26"/></Style>
    <Style Selector="Button.icon-button"><Setter Property="Padding" Value="5"/><Setter Property="MinHeight" Value="28"/></Style>
    <Style Selector="ToggleButton.icon-button"><Setter Property="Padding" Value="5"/><Setter Property="MinHeight" Value="28"/></Style>
    <Style Selector="Button.panel-toggle"><Setter Property="Padding" Value="5"/><Setter Property="MinHeight" Value="28"/></Style>
    <Style Selector="Button.sidebar-utility-button"><Setter Property="Padding" Value="8,4"/><Setter Property="MinHeight" Value="28"/></Style>
    <Style Selector="ToggleButton.sidebar-more-tools-toggle"><Setter Property="Padding" Value="8,4"/><Setter Property="MinHeight" Value="28"/></Style>
    <Style Selector="Button.sidebar-disconnect-action"><Setter Property="MinHeight" Value="28"/></Style>
    <Style Selector="Button.sidebar-refresh-action"><Setter Property="MinHeight" Value="28"/></Style>
    <Style Selector="Button.dashboard-refresh-button">
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusSmall}"/>
        <Setter Property="MinHeight" Value="26"/>
        <Setter Property="Padding" Value="8,2"/>
    </Style>

    <Style Selector="Button.entity-header-action">
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Regular"/>
    </Style>
    <Style Selector="Button.entity-header-action.icon-only"><Setter Property="Padding" Value="0"/></Style>
    <Style Selector="Button.entity-header-action.outline"><Setter Property="FontWeight" Value="Regular"/></Style>
    <Style Selector="Button.entity-header-action.primary"><Setter Property="Padding" Value="10,0"/></Style>
    <Style Selector="Button.entity-pane-restore-command"><Setter Property="Height" Value="28"/></Style>

    <Style Selector="Button.message-header-utility, ToggleButton.message-header-select, Button.message-header-send">
        <Setter Property="MinHeight" Value="28"/>
    </Style>
    <Style Selector="ToggleButton.message-header-select">
        <Setter Property="Height" Value="28"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Regular"/>
        <Setter Property="Padding" Value="10,0"/>
    </Style>
    <Style Selector="Button.message-header-clear"><Setter Property="MinHeight" Value="26"/><Setter Property="Padding" Value="4"/></Style>

    <Style Selector="Button.overview-row-action">
        <Setter Property="MinHeight" Value="24"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="Padding" Value="8,0"/>
        <Setter Property="FontWeight" Value="Regular"/>
    </Style>
    <Style Selector="Button.overview-link"><Setter Property="Padding" Value="6,2"/><Setter Property="FontWeight" Value="Regular"/></Style>
    <Style Selector="Button.menu-input-action"><Setter Property="MinHeight" Value="26"/><Setter Property="Padding" Value="8,0"/></Style>
    <Style Selector="Button.workspace-new-tab"><Setter Property="MinHeight" Value="26"/><Setter Property="Padding" Value="6,4"/></Style>
    <Style Selector="Button.workspace-tab-close"><Setter Property="MinHeight" Value="20"/><Setter Property="Padding" Value="2"/></Style>

    <Style Selector="ToggleButton.pill">
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusSmall}"/>
        <Setter Property="Padding" Value="8,3"/>
    </Style>

    <!-- ── Menus ─────────────────────────────────────────────────────────── -->
    <Style Selector="Button.menu-item"><Setter Property="Padding" Value="8,4"/></Style>
    <Style Selector="Border.menu-item-static"><Setter Property="Padding" Value="8,4"/></Style>
    <Style Selector="MenuItem"><Setter Property="MinHeight" Value="26"/><Setter Property="Padding" Value="8,4"/></Style>
    <Style Selector="FlyoutPresenter.menu-flyout">
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusLarge}"/>
        <Setter Property="Padding" Value="4"/>
    </Style>
    <Style Selector="FlyoutPresenter.menu-flyout /template/ Border#LayoutRoot">
        <Setter Property="BoxShadow" Value="0 4 12 0 #26000000"/>
    </Style>

    <!-- ── Inputs ────────────────────────────────────────────────────────── -->
    <Style Selector="TextBox">
        <Setter Property="Padding" Value="8,5"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderDefault}"/>
    </Style>
    <!-- Zed marks focus with the border color alone, never a heavier edge -->
    <Style Selector="TextBox:focus"><Setter Property="BorderThickness" Value="1"/></Style>
    <Style Selector="TextBox.message-header-search"><Setter Property="MinHeight" Value="28"/><Setter Property="Padding" Value="6,4"/><Setter Property="FontSize" Value="12"/></Style>
    <Style Selector="TextBox.message-header-search:focus"><Setter Property="BorderThickness" Value="1"/></Style>
    <Style Selector="TextBox.menu-input"><Setter Property="MinHeight" Value="26"/><Setter Property="Padding" Value="6,4"/></Style>
    <Style Selector="TextBox.code-editor">
        <Setter Property="FontFamily" Value="{DynamicResource MonoFont}"/>
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusSmall}"/>
        <Setter Property="Padding" Value="8"/>
    </Style>
    <Style Selector="TextBox.code-editor:focus"><Setter Property="BorderThickness" Value="1"/></Style>

    <Style Selector="ComboBox">
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderDefault}"/>
    </Style>
    <Style Selector="ComboBox.overview-range"><Setter Property="MinHeight" Value="24"/><Setter Property="Padding" Value="6,0"/></Style>
    <Style Selector="CheckBox"><Setter Property="MinHeight" Value="26"/></Style>
    <Style Selector="ToggleSwitch"><Setter Property="MinHeight" Value="26"/></Style>

    <!-- ── Tabs ──────────────────────────────────────────────────────────── -->
    <!-- Workspace tabs sit flush and square like Zed's tab bar; the active tab merges
         with the pane below and the accent stripe gives way to hairline separators. -->
    <Style Selector="RadioButton.workspace-tab /template/ Border#PART_Border">
        <Setter Property="CornerRadius" Value="0"/>
    </Style>
    <Style Selector="RadioButton.workspace-tab:checked /template/ Border#PART_Accent">
        <Setter Property="Opacity" Value="0"/>
    </Style>

    <Style Selector="TabItem"><Setter Property="FontSize" Value="12"/><Setter Property="Padding" Value="12,6"/><Setter Property="MinHeight" Value="32"/></Style>
    <Style Selector="TabItem:selected"><Setter Property="FontWeight" Value="Regular"/></Style>
    <Style Selector="TabItem.message-tab, TabControl.message-inspector-tabs TabItem">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Regular"/>
        <Setter Property="MinHeight" Value="32"/>
    </Style>
    <Style Selector="TabItem.message-tab /template/ Border#PART_HoverSurface, TabControl.message-inspector-tabs TabItem /template/ Border#PART_HoverSurface">
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusSmall}"/>
        <Setter Property="Margin" Value="2,4"/>
    </Style>
    <Style Selector="TabControl.inspector-tabs TabItem"><Setter Property="MinHeight" Value="30"/><Setter Property="Padding" Value="6,6"/></Style>

    <Style Selector="RadioButton.section-tab">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Regular"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="Padding" Value="10,0"/>
    </Style>
    <Style Selector="RadioButton.section-tab /template/ Border#PART_HoverSurface">
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusSmall}"/>
        <Setter Property="Margin" Value="2,4"/>
    </Style>
    <Style Selector="RadioButton.tab-button"><Setter Property="Padding" Value="8,3"/><Setter Property="FontSize" Value="12"/></Style>
    <Style Selector="RadioButton.tab-button:checked"><Setter Property="FontWeight" Value="Regular"/></Style>
    <Style Selector="RadioButton.tab-item"><Setter Property="Padding" Value="10,4"/><Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="Regular"/></Style>
    <Style Selector="RadioButton.tab-item:checked"><Setter Property="FontWeight" Value="Regular"/></Style>
    <Style Selector="Border.tab-nav"><Setter Property="Padding" Value="2"/></Style>

    <!-- ── Lists and rows ────────────────────────────────────────────────── -->
    <Style Selector="ListBoxItem"><Setter Property="Padding" Value="8,4"/></Style>
    <Style Selector="Border.entity-item"><Setter Property="Padding" Value="8,5"/></Style>
    <Style Selector="Border.entity-item-selected"><Setter Property="Padding" Value="8,5"/></Style>
    <Style Selector="Border.entity-tree-row-surface"><Setter Property="Padding" Value="8,4"/></Style>
    <Style Selector="Border.entity-group-header"><Setter Property="Padding" Value="6,4"/></Style>
    <Style Selector="Border.namespace-item">
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusSmall}"/>
        <Setter Property="Padding" Value="8,5"/>
    </Style>
    <Style Selector="Border.message-row"><Setter Property="Padding" Value="10,5"/></Style>
    <Style Selector="Border.inbox-item-surface"><Setter Property="Padding" Value="12,8"/></Style>
    <Style Selector="Border.property-row">
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusSmall}"/>
        <Setter Property="Padding" Value="8,5"/>
    </Style>
    <Style Selector="Border.correlation-group-row"><Setter Property="Padding" Value="10,6"/></Style>
    <Style Selector="Border.timeline-event"><Setter Property="Padding" Value="8"/></Style>
    <Style Selector="Border.sidebar-quick-switch-item"><Setter Property="Padding" Value="6,4"/></Style>

    <!-- ── Badges: 4px labels, pills only for counters and dots ──────────── -->
    <Style Selector="Border.badge"><Setter Property="CornerRadius" Value="{DynamicResource RadiusSmall}"/><Setter Property="Padding" Value="5,1"/></Style>
    <Style Selector="Border.badge-danger"><Setter Property="CornerRadius" Value="{DynamicResource RadiusSmall}"/><Setter Property="Padding" Value="5,1"/></Style>
    <Style Selector="Border.badge-success"><Setter Property="CornerRadius" Value="{DynamicResource RadiusSmall}"/><Setter Property="Padding" Value="5,1"/></Style>
    <Style Selector="Border.badge-warning"><Setter Property="CornerRadius" Value="{DynamicResource RadiusSmall}"/><Setter Property="Padding" Value="5,1"/></Style>
    <Style Selector="Border.badge-muted"><Setter Property="CornerRadius" Value="{DynamicResource RadiusSmall}"/><Setter Property="Padding" Value="5,1"/></Style>
    <Style Selector="Border.badge-info"><Setter Property="CornerRadius" Value="{DynamicResource RadiusSmall}"/><Setter Property="Padding" Value="5,1"/></Style>
    <Style Selector="Border.badge-env"><Setter Property="CornerRadius" Value="{DynamicResource RadiusSmall}"/><Setter Property="Padding" Value="5,1"/></Style>
    <Style Selector="Border.badge-danger-soft"><Setter Property="CornerRadius" Value="{DynamicResource RadiusSmall}"/><Setter Property="Padding" Value="5,1"/></Style>
    <Style Selector="Border.badge-success-soft"><Setter Property="CornerRadius" Value="{DynamicResource RadiusSmall}"/><Setter Property="Padding" Value="5,1"/></Style>
    <Style Selector="Border.badge TextBlock"><Setter Property="FontWeight" Value="Medium"/></Style>
    <Style Selector="Border.badge-danger TextBlock"><Setter Property="FontWeight" Value="Medium"/></Style>
    <Style Selector="Border.badge-success TextBlock"><Setter Property="FontWeight" Value="Medium"/></Style>
    <Style Selector="Border.badge-warning TextBlock"><Setter Property="FontWeight" Value="Medium"/></Style>
    <Style Selector="Border.severity-pill"><Setter Property="CornerRadius" Value="{DynamicResource RadiusSmall}"/><Setter Property="Padding" Value="5,1"/></Style>
    <Style Selector="Border.overview-chip"><Setter Property="CornerRadius" Value="{DynamicResource RadiusSmall}"/><Setter Property="Padding" Value="5,1"/></Style>
    <Style Selector="Border.deadletter-reason-pill"><Setter Property="Padding" Value="5,2"/></Style>
    <Style Selector="Border.entity-tree-badge"><Setter Property="CornerRadius" Value="{DynamicResource RadiusSmall}"/><Setter Property="Padding" Value="4,1"/></Style>
    <Style Selector="Border.entity-tree-section-count"><Setter Property="CornerRadius" Value="{DynamicResource RadiusSmall}"/></Style>
    <Style Selector="Border.dashboard-control-chip"><Setter Property="CornerRadius" Value="{DynamicResource RadiusSmall}"/><Setter Property="Padding" Value="6,2"/></Style>
    <Style Selector="Border.sidebar-context-pill"><Setter Property="CornerRadius" Value="{DynamicResource RadiusSmall}"/><Setter Property="Padding" Value="8,5"/></Style>

    <!-- ── Surfaces: flat, hairline, no shadows ──────────────────────────── -->
    <Style Selector="Border.card"><Setter Property="Padding" Value="12"/><Setter Property="BoxShadow" Value="none"/></Style>
    <Style Selector="Border.card:pointerover"><Setter Property="BoxShadow" Value="none"/></Style>
    <Style Selector="Border.card-elevated"><Setter Property="Padding" Value="12"/><Setter Property="BoxShadow" Value="none"/></Style>
    <Style Selector="Border.card-elevated:pointerover"><Setter Property="BoxShadow" Value="none"/></Style>
    <Style Selector="Border.dashboard-card"><Setter Property="BoxShadow" Value="none"/></Style>
    <Style Selector="Border.dashboard-card:pointerover"><Setter Property="BoxShadow" Value="none"/></Style>
    <Style Selector="Border.dashboard-summary-surface"><Setter Property="Padding" Value="12"/><Setter Property="BoxShadow" Value="none"/></Style>
    <Style Selector="Border.section-header">
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusSmall}"/>
        <Setter Property="Padding" Value="8,5"/>
    </Style>
    <Style Selector="Border.form-section"><Setter Property="Padding" Value="12"/></Style>
    <Style Selector="Border.dialog-section-surface"><Setter Property="Padding" Value="12"/></Style>
    <Style Selector="Border.connection-library-command-bar"><Setter Property="Padding" Value="12"/></Style>
    <Style Selector="Border.dialog-command-bar"><Setter Property="Padding" Value="8"/></Style>
    <Style Selector="Border.infobar"><Setter Property="Padding" Value="8,6"/></Style>
    <Style Selector="Border.infobar-error"><Setter Property="Padding" Value="8,6"/></Style>
    <Style Selector="Border.infobar-success"><Setter Property="Padding" Value="8,6"/></Style>
    <Style Selector="Border.infobar-warning"><Setter Property="Padding" Value="8,6"/></Style>
    <Style Selector="Border.empty-state"><Setter Property="Padding" Value="16,24"/></Style>
    <Style Selector="Border.message-empty-state"><Setter Property="Padding" Value="16"/></Style>
    <Style Selector="Border.inline-loading-surface"><Setter Property="Padding" Value="10,8"/></Style>
    <Style Selector="Border.sidebar-hint-card"><Setter Property="Padding" Value="8"/></Style>
    <Style Selector="Border.subscription-picker"><Setter Property="Padding" Value="8,6"/></Style>
    <Style Selector="Border.inbox-stat-block"><Setter Property="Padding" Value="8"/></Style>
    <Style Selector="Border.welcome-primary-surface"><Setter Property="Padding" Value="20"/></Style>
    <Style Selector="Border.welcome-recent-surface"><Setter Property="Padding" Value="14"/></Style>
    <Style Selector="Border.entity-header-icon"><Setter Property="Height" Value="32"/></Style>

    <!-- Chrome bars -->
    <Style Selector="Border.page-header-surface"><Setter Property="Padding" Value="16,10"/></Style>
    <Style Selector="Border.message-command-bar"><Setter Property="Padding" Value="12,8"/></Style>
    <Style Selector="Border.message-search-bar"><Setter Property="Padding" Value="12,6"/></Style>
    <Style Selector="Border.pane-search-surface"><Setter Property="Padding" Value="12,6"/></Style>
    <Style Selector="Border.correlation-command-bar"><Setter Property="Padding" Value="12,8"/></Style>
    <Style Selector="Border.correlation-filter-surface"><Setter Property="Padding" Value="12"/></Style>
    <Style Selector="Border.correlation-inspector-header"><Setter Property="Padding" Value="12,8"/></Style>
    <Style Selector="Border.overview-panel-header"><Setter Property="Padding" Value="12,6"/><Setter Property="MinHeight" Value="34"/></Style>
    <Style Selector="Border.overview-metric-cell"><Setter Property="Padding" Value="12,10"/></Style>
    <Style Selector="Border.status-bar"><Setter Property="Padding" Value="8,2"/></Style>

    <!-- Dialogs: modest corner, a single soft shadow like Zed's popovers -->
    <Style Selector="Border.modal">
        <Setter Property="Padding" Value="16"/>
        <Setter Property="BoxShadow" Value="0 8 24 0 #33000000"/>
    </Style>
    <Style Selector="Border.send-message-panel"><Setter Property="BoxShadow" Value="0 8 24 0 #33000000"/></Style>
    <Style Selector="Border.dialog-header">
        <Setter Property="Padding" Value="16,12"/>
        <Setter Property="CornerRadius" Value="6,6,0,0"/>
    </Style>
    <Style Selector="Border.dialog-body"><Setter Property="Padding" Value="16,14"/></Style>
    <Style Selector="Border.dialog-footer">
        <Setter Property="Padding" Value="16,10"/>
        <Setter Property="CornerRadius" Value="0,0,6,6"/>
    </Style>
</Styles>
