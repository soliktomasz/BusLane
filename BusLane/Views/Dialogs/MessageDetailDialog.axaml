<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:BusLane.ViewModels"
             xmlns:controls="using:BusLane.Views.Controls"
             x:Class="BusLane.Views.Dialogs.MessageDetailDialog"
             x:DataType="vm:MainWindowViewModel"
             x:CompileBindings="False">
    <UserControl.Styles>
        <Style Selector="Border.message-detail-metadata">
            <Setter Property="BorderBrush" Value="{DynamicResource BorderDefault}"/>
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
        </Style>
        <Style Selector="TextBlock.message-detail-section">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Border.message-detail-divider">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource BorderDefault}"/>
        </Style>
        <Style Selector="Border.message-detail-alert">
            <Setter Property="Background" Value="{DynamicResource SurfaceDanger}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderDefault}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>
    </UserControl.Styles>

    <Border x:Name="ModalOverlay"
            Classes="modal-overlay"
            IsVisible="{Binding CurrentMessageOps.SelectedMessage, Converter={x:Static ObjectConverters.IsNotNull}}">
        <Border Background="{DynamicResource CardBackground}"
                CornerRadius="{StaticResource RadiusLarge}"
                BorderThickness="1"
                BorderBrush="{DynamicResource BorderDefault}"
                VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                Margin="32" ClipToBounds="True">
            <Grid RowDefinitions="Auto,Auto,*,Auto">
                <!-- Actions stay visible while payload and metadata scroll independently. -->
                <Border Grid.Row="0" Padding="20,14"
                        BorderBrush="{DynamicResource BorderDefault}" BorderThickness="0,0,0,1">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                        <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Text="{Binding CurrentMessageOps.SelectedMessage.Subject}"
                                       Classes="heading" TextTrimming="CharacterEllipsis"
                                       ToolTip.Tip="{Binding CurrentMessageOps.SelectedMessage.Subject}"
                                       IsVisible="{Binding CurrentMessageOps.SelectedMessage.Subject, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                            <TextBlock Text="Message details" Classes="heading"
                                       IsVisible="{Binding CurrentMessageOps.SelectedMessage.Subject, Converter={x:Static StringConverters.IsNullOrEmpty}}"/>
                            <TextBlock Text="{Binding CurrentMessageOps.SelectedMessage.SequenceNumber, StringFormat='Message details · Sequence {0}'}"
                                       Classes="caption"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Button Classes="subtle small" Command="{Binding ExportMessageCommand}"
                                    CommandParameter="{Binding CurrentMessageOps.SelectedMessage}"
                                    ToolTip.Tip="Export message to JSON file">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <LucideIcon Kind="Upload" Size="14"/>
                                    <TextBlock Text="Export"/>
                                </StackPanel>
                            </Button>
                            <Button Classes="primary small" Command="{Binding ResendMessageCommand}"
                                    CommandParameter="{Binding CurrentMessageOps.SelectedMessage}"
                                    ToolTip.Tip="Resend this message">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <LucideIcon Kind="Send" Size="14"/>
                                    <TextBlock Text="Resend"/>
                                </StackPanel>
                            </Button>
                            <Button Classes="icon-button" Command="{Binding CloneMessageCommand}"
                                    CommandParameter="{Binding CurrentMessageOps.SelectedMessage}"
                                    AutomationProperties.Name="Clone message" ToolTip.Tip="Clone to new message">
                                <LucideIcon Kind="Copy" Size="16"/>
                            </Button>
                            <Border Width="1" Margin="6,4" Background="{DynamicResource BorderDefault}"/>
                            <Button Classes="icon-button" Command="{Binding ClearSelectedMessageCommand}"
                                    AutomationProperties.Name="Close message details" ToolTip.Tip="Close">
                                <LucideIcon Kind="X" Size="16"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
                        <Border Grid.Row="1" Classes="message-detail-alert"
                                IsVisible="{Binding CurrentMessageOps.SelectedMessage.DeadLetterReason, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                            <ScrollViewer MaxHeight="144" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Spacing="10" Margin="20,12">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <LucideIcon Kind="TriangleAlert" Size="16" Foreground="{DynamicResource TextDanger}"/>
                                    <TextBlock Text="Dead Letter" FontWeight="SemiBold" Foreground="{DynamicResource TextDanger}"/>
                                </StackPanel>
                                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" Margin="24,0,0,0">
                                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,12,8"
                                                IsVisible="{Binding CurrentMessageOps.SelectedMessage.DeadLetterReason, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                        <TextBlock Text="Reason" Classes="caption" Margin="0,0,0,2"/>
                                        <SelectableTextBlock Text="{Binding CurrentMessageOps.SelectedMessage.DeadLetterReason}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,8"
                                                IsVisible="{Binding CurrentMessageOps.SelectedMessage.DeadLetterSource, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                        <TextBlock Text="Source" Classes="caption" Margin="0,0,0,2"/>
                                        <SelectableTextBlock Text="{Binding CurrentMessageOps.SelectedMessage.DeadLetterSource}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                                IsVisible="{Binding CurrentMessageOps.SelectedMessage.DeadLetterErrorDescription, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                        <TextBlock Text="Error" Classes="caption" Margin="0,0,0,2"/>
                                        <SelectableTextBlock Text="{Binding CurrentMessageOps.SelectedMessage.DeadLetterErrorDescription}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                            </ScrollViewer>
                        </Border>
                <Grid Grid.Row="2" ColumnDefinitions="260,*">
                    <Border Grid.Column="0" Classes="message-detail-metadata">
                        <ScrollViewer x:Name="ContentScrollViewer" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Spacing="16" Margin="20,18">
                                <TextBlock Text="Identity" Classes="message-detail-section"/>
                                <StackPanel Spacing="3">
                                    <TextBlock Text="Message ID" Classes="caption"/>
                                    <SelectableTextBlock Text="{Binding CurrentMessageOps.SelectedMessage.MessageId}" TextWrapping="Wrap" FontSize="12" FontFamily="Cascadia Code, Consolas, Monaco, monospace"/>
                                </StackPanel>
                                <StackPanel Spacing="3" IsVisible="{Binding CurrentMessageOps.SelectedMessage.CorrelationId, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                    <TextBlock Text="Correlation ID" Classes="caption"/>
                                    <SelectableTextBlock Text="{Binding CurrentMessageOps.SelectedMessage.CorrelationId}" TextWrapping="Wrap" FontSize="12" FontFamily="Cascadia Code, Consolas, Monaco, monospace"/>
                                </StackPanel>
                                <StackPanel Spacing="3" IsVisible="{Binding CurrentMessageOps.SelectedMessage.SessionId, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                    <TextBlock Text="Session ID" Classes="caption"/>
                                    <SelectableTextBlock Text="{Binding CurrentMessageOps.SelectedMessage.SessionId}" TextWrapping="Wrap" FontSize="12" FontFamily="Cascadia Code, Consolas, Monaco, monospace"/>
                                </StackPanel>
                                <StackPanel Spacing="3" IsVisible="{Binding CurrentMessageOps.SelectedMessage.Subject, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                    <TextBlock Text="Subject" Classes="caption"/>
                                    <SelectableTextBlock Text="{Binding CurrentMessageOps.SelectedMessage.Subject}" TextWrapping="Wrap" FontSize="12"/>
                                </StackPanel>
                                <Border Classes="message-detail-divider"/>
                                <TextBlock Text="Timing &amp; delivery" Classes="message-detail-section"/>
                                <StackPanel Spacing="3">
                                    <TextBlock Text="Enqueued" Classes="caption"/>
                                    <SelectableTextBlock Text="{Binding CurrentMessageOps.SelectedMessage.EnqueuedTime}" TextWrapping="Wrap" FontSize="12"/>
                                </StackPanel>
                                <StackPanel Spacing="3">
                                    <TextBlock Text="Expires" Classes="caption"/>
                                    <SelectableTextBlock Text="{Binding CurrentMessageOps.SelectedMessage.ExpiresAt}" TextWrapping="Wrap" FontSize="12"/>
                                </StackPanel>
                                <StackPanel Spacing="3">
                                    <TextBlock Text="Time to live" Classes="caption"/>
                                    <SelectableTextBlock Text="{Binding CurrentMessageOps.SelectedMessage.TimeToLive}" TextWrapping="Wrap" FontSize="12"/>
                                </StackPanel>
                                <StackPanel Spacing="3">
                                    <TextBlock Text="Delivery count" Classes="caption"/>
                                    <SelectableTextBlock Text="{Binding CurrentMessageOps.SelectedMessage.DeliveryCount}" TextWrapping="Wrap" FontSize="12"/>
                                </StackPanel>
                                <StackPanel Spacing="3" IsVisible="{Binding CurrentMessageOps.SelectedMessage.ScheduledEnqueueTime, Converter={x:Static ObjectConverters.IsNotNull}}">
                                    <TextBlock Text="Scheduled for" Classes="caption"/>
                                    <SelectableTextBlock Text="{Binding CurrentMessageOps.SelectedMessage.ScheduledEnqueueTime}" TextWrapping="Wrap" FontSize="12"/>
                                </StackPanel>
                                <StackPanel Spacing="16">
                                    <StackPanel.IsVisible>
                                        <MultiBinding Converter="{x:Static BoolConverters.Or}">
                                            <Binding Path="CurrentMessageOps.SelectedMessage.To" Converter="{x:Static StringConverters.IsNotNullOrEmpty}"/>
                                            <Binding Path="CurrentMessageOps.SelectedMessage.ReplyTo" Converter="{x:Static StringConverters.IsNotNullOrEmpty}"/>
                                            <Binding Path="CurrentMessageOps.SelectedMessage.PartitionKey" Converter="{x:Static StringConverters.IsNotNullOrEmpty}"/>
                                        </MultiBinding>
                                    </StackPanel.IsVisible>
                                    <Border Classes="message-detail-divider"/>
                                    <TextBlock Text="Routing" Classes="message-detail-section"/>
                                <StackPanel Spacing="3" IsVisible="{Binding CurrentMessageOps.SelectedMessage.To, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                    <TextBlock Text="To" Classes="caption"/>
                                    <SelectableTextBlock Text="{Binding CurrentMessageOps.SelectedMessage.To}" TextWrapping="Wrap" FontSize="12"/>
                                </StackPanel>
                                <StackPanel Spacing="3" IsVisible="{Binding CurrentMessageOps.SelectedMessage.ReplyTo, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                    <TextBlock Text="Reply to" Classes="caption"/>
                                    <SelectableTextBlock Text="{Binding CurrentMessageOps.SelectedMessage.ReplyTo}" TextWrapping="Wrap" FontSize="12"/>
                                </StackPanel>
                                <StackPanel Spacing="3" IsVisible="{Binding CurrentMessageOps.SelectedMessage.PartitionKey, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                    <TextBlock Text="Partition key" Classes="caption"/>
                                    <SelectableTextBlock Text="{Binding CurrentMessageOps.SelectedMessage.PartitionKey}" TextWrapping="Wrap" FontSize="12"/>
                                </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto">
                        <Border Grid.Row="0" Padding="16,10"
                                BorderBrush="{DynamicResource BorderDefault}" BorderThickness="0,0,0,1">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <TextBlock Text="Body" Classes="message-detail-section" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding CurrentMessageOps.SelectedMessage.ContentType}"
                                               Classes="caption" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="220"/>
                                    <Border Classes="badge-info" IsVisible="{Binding CurrentMessageOps.IsMessageBodyJson}">
                                        <TextBlock Text="JSON"/>
                                    </Border>
                                    <Border Classes="badge-info" IsVisible="{Binding CurrentMessageOps.IsMessageBodyXml}">
                                        <TextBlock Text="XML"/>
                                    </Border>
                                </StackPanel>
                                <Button Grid.Column="1" Classes="subtle small" Command="{Binding CopyMessageBodyCommand}"
                                        ToolTip.Tip="Copy body to clipboard">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <LucideIcon Kind="Copy" Size="14"/>
                                        <TextBlock Text="Copy body"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>
                        <controls:SyntaxHighlightedTextBox Grid.Row="1"
                                 Text="{Binding CurrentMessageOps.FormattedMessageBody, Mode=OneWay}"
                                 IsJson="{Binding CurrentMessageOps.IsMessageBodyJson}"
                                 IsXml="{Binding CurrentMessageOps.IsMessageBodyXml}"/>
                        <Border Grid.Row="2" BorderBrush="{DynamicResource BorderDefault}" BorderThickness="0,1,0,0"
                                IsVisible="{Binding CurrentMessageOps.FormattedApplicationProperties, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                            <Grid RowDefinitions="Auto,*" MaxHeight="180">
                                <TextBlock Grid.Row="0" Text="Application properties" Classes="message-detail-section" Margin="16,12,16,8"/>
                                <TextBox Grid.Row="1" Text="{Binding CurrentMessageOps.FormattedApplicationProperties, Mode=OneWay}"
                                         IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                                         FontFamily="Cascadia Code, Consolas, Monaco, monospace" FontSize="12"
                                         Background="Transparent" BorderThickness="0" Padding="16,0,16,12"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <Border Grid.Row="3" Padding="20,8"
                        BorderBrush="{DynamicResource BorderDefault}" BorderThickness="0,1,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <LucideIcon Kind="Eye" Size="13" Foreground="{DynamicResource SubtleForeground}" VerticalAlignment="Center"/>
                        <TextBlock Text="Read-only inspection" Classes="caption"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Border>
</UserControl>
