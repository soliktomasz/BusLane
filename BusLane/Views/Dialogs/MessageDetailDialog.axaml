<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:BusLane.ViewModels" xmlns:controls="using:BusLane.Views.Controls" x:Class="BusLane.Views.Dialogs.MessageDetailDialog" x:DataType="vm:MainWindowViewModel" x:CompileBindings="False">
    <UserControl.Styles>
        <Style Selector="TextBlock.message-detail-label">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource SubtleForeground}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="SelectableTextBlock.message-detail-value">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="Cascadia Code, Consolas, Monaco, monospace"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Border.message-detail-code">
            <Setter Property="Background" Value="{DynamicResource SurfaceSubtle}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderMuted}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="ClipToBounds" Value="True"/>
        </Style>
    </UserControl.Styles>
    <Border Classes="modal-overlay" IsVisible="{Binding CurrentMessageOps.SelectedMessage, Converter={x:Static ObjectConverters.IsNotNull}}" x:Name="ModalOverlay">
        <Border Width="560" MaxWidth="{Binding $parent[UserControl].Bounds.Width}" HorizontalAlignment="Right" VerticalAlignment="Stretch" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource BorderDefault}" BorderThickness="1,0,0,0" BoxShadow="-12 0 32 0 #30000000" ClipToBounds="True" KeyboardNavigation.TabNavigation="Cycle">
            <DockPanel>
                <Border Padding="20,16" BorderBrush="{DynamicResource BorderDefault}" BorderThickness="0,0,0,1" DockPanel.Dock="Top">
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12">
                        <LucideIcon Kind="Send" Size="20" Foreground="{DynamicResource AccentBrand}" VerticalAlignment="Center"/>
                        <TextBlock Text="Message detail" FontSize="17" FontWeight="Medium" VerticalAlignment="Center" Grid.Column="1"/>
                        <Button Classes="icon-button" Grid.Column="2" ToolTip.Tip="More message actions" AutomationProperties.Name="More message actions">
                            <LucideIcon Kind="Ellipsis" Size="16"/>
                            <Button.Flyout>
                                <Flyout Placement="BottomEdgeAlignedRight">
                                    <StackPanel Spacing="4">
                                        <Button Classes="subtle" Command="{Binding ExportMessageCommand}" CommandParameter="{Binding CurrentMessageOps.SelectedMessage}">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <LucideIcon Kind="Download" Size="16"/>
                                                <TextBlock Text="Export message"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Classes="subtle" Command="{Binding CloneMessageCommand}" CommandParameter="{Binding CurrentMessageOps.SelectedMessage}">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <LucideIcon Kind="Copy" Size="16"/>
                                                <TextBlock Text="Clone message"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                        <Button Classes="icon-button" Command="{Binding ClearSelectedMessageCommand}" Grid.Column="3" ToolTip.Tip="Close (Esc)" AutomationProperties.Name="Close message detail" x:Name="CloseButton">
                            <LucideIcon Kind="X" Size="16"/>
                        </Button>
                    </Grid>
                </Border>
                <Border Padding="16,14" BorderBrush="{DynamicResource BorderDefault}" BorderThickness="0,1,0,0" DockPanel.Dock="Bottom">
                    <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="8">
                        <Button Classes="subtle" Command="{Binding CopyMessageBodyCommand}" CommandParameter="{Binding CurrentMessageOps.SelectedMessage}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <LucideIcon Kind="Copy" Size="16"/>
                                <TextBlock Text="Copy body"/>
                            </StackPanel>
                        </Button>
                        <Button Classes="subtle" Command="{Binding ResendMessageCommand}" Grid.Column="1" CommandParameter="{Binding CurrentMessageOps.SelectedMessage}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <LucideIcon Kind="Send" Size="16"/>
                                <TextBlock Text="Resend"/>
                            </StackPanel>
                        </Button>
                        <Button Classes="subtle" Command="{Binding DeleteSelectedMessageCommand}" Foreground="{DynamicResource TextDanger}" Grid.Column="3">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <LucideIcon Kind="Trash2" Size="16"/>
                                <TextBlock Text="Delete"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" x:Name="ContentScrollViewer">
                    <StackPanel Spacing="22" Margin="20,24">
                        <Border Classes="infobar-error" IsVisible="{Binding CurrentMessageOps.SelectedMessage.DeadLetterReason, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                            <StackPanel Spacing="10">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <LucideIcon Kind="TriangleAlert" Size="16" Foreground="{DynamicResource TextDanger}"/>
                                    <TextBlock Text="Dead Letter" FontWeight="SemiBold" Foreground="{DynamicResource TextDanger}"/>
                                </StackPanel>
                                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" Margin="24,0,0,0">
                                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,12,8" IsVisible="{Binding CurrentMessageOps.SelectedMessage.DeadLetterReason, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                        <TextBlock Text="Reason" Classes="caption" Margin="0,0,0,2"/>
                                        <SelectableTextBlock Text="{Binding CurrentMessageOps.SelectedMessage.DeadLetterReason}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,8" IsVisible="{Binding CurrentMessageOps.SelectedMessage.DeadLetterSource, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                        <TextBlock Text="Source" Classes="caption" Margin="0,0,0,2"/>
                                        <SelectableTextBlock Text="{Binding CurrentMessageOps.SelectedMessage.DeadLetterSource}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" IsVisible="{Binding CurrentMessageOps.SelectedMessage.DeadLetterErrorDescription, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                        <TextBlock Text="Error" Classes="caption" Margin="0,0,0,2"/>
                                        <SelectableTextBlock Text="{Binding CurrentMessageOps.SelectedMessage.DeadLetterErrorDescription}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <StackPanel Spacing="12">
                            <Grid ColumnDefinitions="145,*" ColumnSpacing="12">
                                <TextBlock Text="Sequence number" Classes="message-detail-label"/>
                                <SelectableTextBlock Text="{Binding CurrentMessageOps.SelectedMessage.SequenceNumber}" Classes="message-detail-value" Grid.Column="1"/>
                            </Grid>
                            <Grid ColumnDefinitions="145,*" ColumnSpacing="12">
                                <TextBlock Text="Message ID" Classes="message-detail-label"/>
                                <SelectableTextBlock Text="{Binding CurrentMessageOps.SelectedMessage.MessageId}" Classes="message-detail-value" Grid.Column="1"/>
                            </Grid>
                            <Grid ColumnDefinitions="145,*" ColumnSpacing="12">
                                <TextBlock Text="Enqueued" Classes="message-detail-label"/>
                                <SelectableTextBlock Text="{Binding CurrentMessageOps.SelectedMessage.EnqueuedTime, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" Classes="message-detail-value" Grid.Column="1"/>
                            </Grid>
                            <Grid ColumnDefinitions="145,*" ColumnSpacing="12" IsVisible="{Binding CurrentMessageOps.SelectedMessage.Subject, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                <TextBlock Text="Subject" Classes="message-detail-label"/>
                                <SelectableTextBlock Text="{Binding CurrentMessageOps.SelectedMessage.Subject}" Classes="message-detail-value" Grid.Column="1"/>
                            </Grid>
                            <Grid ColumnDefinitions="145,*" ColumnSpacing="12" IsVisible="{Binding CurrentMessageOps.SelectedMessage.CorrelationId, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                <TextBlock Text="Correlation ID" Classes="message-detail-label"/>
                                <SelectableTextBlock Text="{Binding CurrentMessageOps.SelectedMessage.CorrelationId}" Classes="message-detail-value" Grid.Column="1"/>
                            </Grid>
                            <Grid ColumnDefinitions="145,*" ColumnSpacing="12" IsVisible="{Binding CurrentMessageOps.SelectedMessage.ContentType, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                <TextBlock Text="Content type" Classes="message-detail-label"/>
                                <SelectableTextBlock Text="{Binding CurrentMessageOps.SelectedMessage.ContentType}" Classes="message-detail-value" Grid.Column="1"/>
                            </Grid>
                            <Grid ColumnDefinitions="145,*" ColumnSpacing="12">
                                <TextBlock Text="Delivery count" Classes="message-detail-label"/>
                                <SelectableTextBlock Text="{Binding CurrentMessageOps.SelectedMessage.DeliveryCount}" Classes="message-detail-value" Grid.Column="1"/>
                            </Grid>
                        </StackPanel>
                        <StackPanel Spacing="12" IsVisible="{Binding CurrentMessageOps.FormattedApplicationProperties, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                            <TextBlock Text="APPLICATION PROPERTIES" Classes="field-group-header"/>
                            <Border Classes="message-detail-code">
                                <TextBox Text="{Binding CurrentMessageOps.FormattedApplicationProperties, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="100" MaxHeight="220" FontFamily="Cascadia Code, Consolas, Monaco, monospace" FontSize="13" Background="Transparent" BorderThickness="0" Padding="14"/>
                            </Border>
                        </StackPanel>
                        <StackPanel Spacing="12">
                            <TextBlock Text="BODY" Classes="field-group-header"/>
                            <Border Classes="message-detail-code" MinHeight="180" MaxHeight="480">
                                <controls:SyntaxHighlightedTextBox Text="{Binding CurrentMessageOps.FormattedMessageBody, Mode=OneWay}" IsJson="{Binding CurrentMessageOps.IsMessageBodyJson}" IsXml="{Binding CurrentMessageOps.IsMessageBodyXml}" MinHeight="180"/>
                            </Border>
                        </StackPanel>
                        <Expander Header="More metadata" HorizontalAlignment="Stretch">
                            <StackPanel Spacing="12">
                                <Grid ColumnDefinitions="145,*" ColumnSpacing="12" IsVisible="{Binding CurrentMessageOps.SelectedMessage.SessionId, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                    <TextBlock Text="Session ID" Classes="message-detail-label"/>
                                    <SelectableTextBlock Text="{Binding CurrentMessageOps.SelectedMessage.SessionId}" Classes="message-detail-value" Grid.Column="1"/>
                                </Grid>
                                <Grid ColumnDefinitions="145,*" ColumnSpacing="12" IsVisible="{Binding CurrentMessageOps.SelectedMessage.ExpiresAt, Converter={x:Static ObjectConverters.IsNotNull}}">
                                    <TextBlock Text="Expires" Classes="message-detail-label"/>
                                    <SelectableTextBlock Text="{Binding CurrentMessageOps.SelectedMessage.ExpiresAt, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" Classes="message-detail-value" Grid.Column="1"/>
                                </Grid>
                                <Grid ColumnDefinitions="145,*" ColumnSpacing="12" IsVisible="{Binding CurrentMessageOps.SelectedMessage.TimeToLive, Converter={x:Static ObjectConverters.IsNotNull}}">
                                    <TextBlock Text="Time to live" Classes="message-detail-label"/>
                                    <SelectableTextBlock Text="{Binding CurrentMessageOps.SelectedMessage.TimeToLive}" Classes="message-detail-value" Grid.Column="1"/>
                                </Grid>
                                <Grid ColumnDefinitions="145,*" ColumnSpacing="12" IsVisible="{Binding CurrentMessageOps.SelectedMessage.ScheduledEnqueueTime, Converter={x:Static ObjectConverters.IsNotNull}}">
                                    <TextBlock Text="Scheduled for" Classes="message-detail-label"/>
                                    <SelectableTextBlock Text="{Binding CurrentMessageOps.SelectedMessage.ScheduledEnqueueTime, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" Classes="message-detail-value" Grid.Column="1"/>
                                </Grid>
                                <Grid ColumnDefinitions="145,*" ColumnSpacing="12" IsVisible="{Binding CurrentMessageOps.SelectedMessage.To, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                    <TextBlock Text="To" Classes="message-detail-label"/>
                                    <SelectableTextBlock Text="{Binding CurrentMessageOps.SelectedMessage.To}" Classes="message-detail-value" Grid.Column="1"/>
                                </Grid>
                                <Grid ColumnDefinitions="145,*" ColumnSpacing="12" IsVisible="{Binding CurrentMessageOps.SelectedMessage.ReplyTo, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                    <TextBlock Text="Reply to" Classes="message-detail-label"/>
                                    <SelectableTextBlock Text="{Binding CurrentMessageOps.SelectedMessage.ReplyTo}" Classes="message-detail-value" Grid.Column="1"/>
                                </Grid>
                                <Grid ColumnDefinitions="145,*" ColumnSpacing="12" IsVisible="{Binding CurrentMessageOps.SelectedMessage.PartitionKey, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                    <TextBlock Text="Partition key" Classes="message-detail-label"/>
                                    <SelectableTextBlock Text="{Binding CurrentMessageOps.SelectedMessage.PartitionKey}" Classes="message-detail-value" Grid.Column="1"/>
                                </Grid>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Border>
</UserControl>
