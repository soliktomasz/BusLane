<UserControl xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:BusLane.ViewModels"
    xmlns:models="using:BusLane.Models"
    x:Class="BusLane.Views.Dialogs.SendMessageDialog"
    x:DataType="vm:MainWindowViewModel"
    x:CompileBindings="False"
    Name="SendMessageControl">
    <UserControl.Styles>
        <Style Selector="Button.composer-icon">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="8"/>
        </Style>
    </UserControl.Styles>
    <Border Classes="modal-overlay" IsVisible="{Binding ShowSendMessagePopup}">
        <Border Classes="send-message-panel" Margin="24"
            MinWidth="720" MaxWidth="960" MaxHeight="760"
            HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
                <Border Grid.Row="0" Classes="dialog-header" Padding="24,20">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Send Message" FontSize="20" FontWeight="SemiBold"/>
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                                <TextBlock Text="To" Classes="caption"/>
                                <TextBlock Grid.Column="1" Text="{Binding SendMessageViewModel.EntityName}" Classes="caption" FontWeight="SemiBold"
                                    TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding SendMessageViewModel.EntityName}"/>
                            </Grid>
                        </StackPanel>
                        <Button Grid.Column="1" Classes="subtle composer-icon" VerticalAlignment="Center"
                            Command="{Binding CancelSendMessageCommand}" ToolTip.Tip="Close composer" AutomationProperties.Name="Close message composer">
                            <LucideIcon Kind="X" Size="18"/>
                        </Button>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Padding="24,10" BorderBrush="{DynamicResource BorderDefault}" BorderThickness="0,0,0,1">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <RadioButton Classes="tab-item" Content="Compose" GroupName="SendMessageTabs" IsChecked="{Binding SendMessageViewModel.IsComposeTabSelected}"/>
                            <RadioButton Classes="tab-item" Content="Properties" GroupName="SendMessageTabs" IsChecked="{Binding SendMessageViewModel.IsPropertiesTabSelected}"/>
                            <RadioButton Classes="tab-item" Content="Custom" GroupName="SendMessageTabs" IsChecked="{Binding SendMessageViewModel.IsCustomTabSelected}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Classes="toolbar" Command="{Binding SendMessageViewModel.ImportMessagesCommand}" ToolTip.Tip="Import message from JSON file">
                                <StackPanel Orientation="Horizontal" Spacing="6"><LucideIcon Kind="Download" Size="16"/>
                                    <TextBlock Text="Import"/>
                                </StackPanel>
                            </Button>
                            <Button Name="TemplatesButton" Classes="toolbar" ToolTip.Tip="Load a saved template">
                                <StackPanel Orientation="Horizontal" Spacing="6"><LucideIcon Kind="FolderOpen" Size="16"/>
                                    <TextBlock Text="Templates"/>
                                </StackPanel>
                                <Button.Flyout>
                                    <Flyout Placement="BottomEdgeAlignedRight">
                                        <Border Width="440" MaxHeight="400" Padding="16">
                                            <StackPanel Spacing="8">
                                                <TextBlock Text="Saved Templates" Classes="body-strong"/>
                                                <TextBox AutomationProperties.Name="Search templates" Text="{Binding SendMessageViewModel.TemplateSearchQuery}"
                                                    PlaceholderText="Search templates..."
                                                    Padding="10,8"/>
                                                <ScrollViewer MaxHeight="280" HorizontalScrollBarVisibility="Disabled">
                                                    <StackPanel Spacing="4">
                                                        <ItemsControl Name="SavedTemplatesList" ItemsSource="{ReflectionBinding SendMessageViewModel.FilteredSavedMessages}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="models:SavedMessage">
                                                                    <Border BorderBrush="{DynamicResource BorderDefault}" BorderThickness="0,0,0,1" Padding="0,12">
                                                                        <Grid ColumnDefinitions="*,Auto">
                                                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap" ToolTip.Tip="{Binding Name}"/>
                                                                                <TextBlock Text="{Binding Category}"
                                                                                    Classes="caption"
                                                                                    FontSize="12"/>
                                                                                <TextBlock Text="{Binding CreatedAt, StringFormat='{}{0:MMM d, yyyy}'}"
                                                                                    Classes="caption"
                                                                                    FontSize="12"/>
                                                                            </StackPanel>
                                                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                                                                <Button Classes="primary small"
                                                                                    Content="Use"
                                                                                    Padding="12,4"
                                                                                    Command="{ReflectionBinding $parent[Window].DataContext.SendMessageViewModel.LoadMessageCommand}"
                                                                                    CommandParameter="{Binding}"/>
                                                                                <Button Classes="icon"
                                                                                    ToolTip.Tip="Duplicate template" AutomationProperties.Name="Duplicate template"
                                                                                    Command="{ReflectionBinding $parent[Window].DataContext.SendMessageViewModel.DuplicateSavedMessageCommand}"
                                                                                    CommandParameter="{Binding}">
                                                                                    <LucideIcon Kind="Copy" Size="16"/>
                                                                                </Button>
                                                                                <Button Classes="icon"
                                                                                    ToolTip.Tip="Delete template" AutomationProperties.Name="Delete template"
                                                                                    Command="{ReflectionBinding $parent[Window].DataContext.SendMessageViewModel.DeleteSavedMessageCommand}"
                                                                                    CommandParameter="{Binding}">
                                                                                    <LucideIcon Kind="Trash2" Size="16"/>
                                                                                </Button>
                                                                            </StackPanel>
                                                                        </Grid>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                        <TextBlock Text="No templates found. Save a message or try another search." TextWrapping="Wrap" TextAlignment="Center"
                                                            Classes="caption"
                                                            HorizontalAlignment="Center"
                                                            Margin="0,12"
                                                            IsVisible="{Binding !#SavedTemplatesList.ItemCount}"/>
                                                    </StackPanel>
                                                </ScrollViewer>
                                            </StackPanel>
                                        </Border>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                            <Button Classes="toolbar" Command="{Binding SendMessageViewModel.ShowSaveCommand}" ToolTip.Tip="Save this message as a template">
                                <StackPanel Orientation="Horizontal" Spacing="6"><LucideIcon Kind="Save" Size="16"/>
                                    <TextBlock Text="Save template"/>
                                </StackPanel>
                            </Button>
                            <Button Classes="toolbar" IsVisible="{Binding SendMessageViewModel.HasActiveTemplate}" Command="{Binding SendMessageViewModel.UpdateActiveTemplateCommand}" ToolTip.Tip="Update the loaded template">
                                <StackPanel Orientation="Horizontal" Spacing="6"><LucideIcon Kind="Check" Size="16"/>
                                    <TextBlock Text="Update"/>
                                </StackPanel>
                            </Button>
                            <Button Classes="subtle composer-icon" Command="{Binding SendMessageViewModel.ClearFormCommand}" ToolTip.Tip="Clear all fields" AutomationProperties.Name="Clear all message fields">
                                <LucideIcon Kind="RefreshCw" Size="16"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Classes="infobar-error" Margin="24,12,24,0"
                    IsVisible="{Binding SendMessageViewModel.ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <LucideIcon Kind="TriangleAlert" Size="16" Foreground="{DynamicResource TextDanger}" VerticalAlignment="Top" Margin="0,2,0,0"/>
                        <ScrollViewer Grid.Column="1" MaxHeight="72" HorizontalScrollBarVisibility="Disabled">
                            <TextBlock Text="{Binding SendMessageViewModel.ErrorMessage}" TextWrapping="Wrap" Foreground="{DynamicResource TextDanger}"/>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <Border Grid.Row="3" Classes="dialog-body" Padding="24,20">
                    <Grid>
                        <Grid RowDefinitions="Auto,Auto,*" RowSpacing="12" IsVisible="{Binding SendMessageViewModel.IsComposeTabSelected}">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="20">
                                <TextBlock Text="Message Body" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SendMessageViewModel.ContentType}" Classes="caption"/>
                                    <TextBlock Text="{Binding SendMessageViewModel.ActiveTemplate.Name}" Classes="caption" MaxWidth="240" TextTrimming="CharacterEllipsis"
                                        ToolTip.Tip="{Binding SendMessageViewModel.ActiveTemplate.Name}" IsVisible="{Binding SendMessageViewModel.HasActiveTemplate}"/>
                                </StackPanel>
                            </Grid>
                            <ScrollViewer Grid.Row="1" MaxHeight="104" HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding SendMessageViewModel.TemplateTokenValues.Count}">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Template values" FontSize="13" FontWeight="SemiBold"/>
                                    <ItemsControl ItemsSource="{Binding SendMessageViewModel.TemplateTokenValues}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:TemplateTokenValue">
                                                <Grid ColumnDefinitions="160,*" ColumnSpacing="12" Margin="0,0,0,6">
                                                    <TextBlock Text="{Binding Name}" Classes="caption" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                                    <TextBox Grid.Column="1" Text="{Binding Value}" AutomationProperties.Name="{Binding Name}" Padding="10,6"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                            <TextBox Grid.Row="2" Name="MessageBodyEditor" Text="{Binding SendMessageViewModel.Body}" Classes="code-editor"
                                AutomationProperties.Name="Message body" PlaceholderForeground="{DynamicResource CodeForeground}" FontSize="13" FontFamily="Cascadia Code, Consolas, Monaco, monospace" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64"
                                VerticalAlignment="Stretch" PlaceholderText="Enter JSON, XML, or plain text"/>
                        </Grid>

                        <ScrollViewer Name="MessagePropertiesScroll" HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding SendMessageViewModel.IsPropertiesTabSelected}">
                            <StackPanel Spacing="24" Margin="0,0,0,4">
                                <StackPanel Spacing="16">
                                    <TextBlock Text="Identity" FontSize="16" FontWeight="SemiBold"/>
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="20" RowDefinitions="Auto,Auto" RowSpacing="20">
                                        <StackPanel Grid.Row="0" Grid.Column="0" Spacing="6">
                                            <TextBlock Text="Content Type" Classes="field-label" Margin="0"/>
                                            <TextBox Text="{Binding SendMessageViewModel.ContentType}" AutomationProperties.Name="Content Type" PlaceholderText="application/json"/>
                                            <TextBlock Text="MIME type of the message body" Classes="caption" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="0" Grid.Column="1" Spacing="6">
                                            <TextBlock Text="Message ID" Classes="field-label" Margin="0"/>
                                            <TextBox Text="{Binding SendMessageViewModel.MessageId}" AutomationProperties.Name="Message ID" PlaceholderText="Leave empty to auto-generate"/>
                                            <TextBlock Text="Unique identifier for de-duplication" Classes="caption" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="0" Spacing="6">
                                            <TextBlock Text="Subject (Label)" Classes="field-label" Margin="0"/>
                                            <TextBox Text="{Binding SendMessageViewModel.Subject}" AutomationProperties.Name="Subject (Label)" PlaceholderText="Optional"/>

                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="1" Spacing="6">
                                            <TextBlock Text="Correlation ID" Classes="field-label" Margin="0"/>
                                            <TextBox Text="{Binding SendMessageViewModel.CorrelationId}" AutomationProperties.Name="Correlation ID" PlaceholderText="Optional"/>

                                        </StackPanel>
                                    </Grid></StackPanel>
                                <Border Height="1" Background="{DynamicResource BorderDefault}"/>
                                <StackPanel Spacing="16">
                                    <TextBlock Text="Routing &amp; sessions" FontSize="16" FontWeight="SemiBold"/>
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="20" RowDefinitions="Auto,Auto,Auto" RowSpacing="20">
                                        <StackPanel Grid.Row="0" Grid.Column="0" Spacing="6">
                                            <TextBlock Text="Session ID" Classes="field-label" Margin="0"/>
                                            <TextBox Text="{Binding SendMessageViewModel.SessionId}" AutomationProperties.Name="Session ID" PlaceholderText="Required for session-enabled entities"/>

                                        </StackPanel>
                                        <StackPanel Grid.Row="0" Grid.Column="1" Spacing="6">
                                            <TextBlock Text="Partition Key" Classes="field-label" Margin="0"/>
                                            <TextBox Text="{Binding SendMessageViewModel.PartitionKey}" AutomationProperties.Name="Partition Key" PlaceholderText="Optional"/>

                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="0" Spacing="6">
                                            <TextBlock Text="To" Classes="field-label" Margin="0"/>
                                            <TextBox Text="{Binding SendMessageViewModel.To}" AutomationProperties.Name="To" PlaceholderText="Destination"/>

                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="1" Spacing="6">
                                            <TextBlock Text="Reply To" Classes="field-label" Margin="0"/>
                                            <TextBox Text="{Binding SendMessageViewModel.ReplyTo}" AutomationProperties.Name="Reply To" PlaceholderText="Reply address"/>

                                        </StackPanel>
                                        <StackPanel Grid.Row="2" Grid.Column="0" Spacing="6">
                                            <TextBlock Text="Reply To Session ID" Classes="field-label" Margin="0"/>
                                            <TextBox Text="{Binding SendMessageViewModel.ReplyToSessionId}" AutomationProperties.Name="Reply To Session ID" PlaceholderText="Optional"/>

                                        </StackPanel>
                                    </Grid></StackPanel>
                                <Border Height="1" Background="{DynamicResource BorderDefault}"/>
                                <StackPanel Spacing="16">
                                    <TextBlock Text="Delivery" FontSize="16" FontWeight="SemiBold"/>
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="20" RowDefinitions="Auto" RowSpacing="20">
                                        <StackPanel Grid.Row="0" Grid.Column="0" Spacing="6">
                                            <TextBlock Text="Time to Live" Classes="field-label" Margin="0"/>
                                            <TextBox Text="{Binding SendMessageViewModel.TimeToLiveText}" AutomationProperties.Name="Time to Live" PlaceholderText="e.g., 00:30:00 or 1800"/>
                                            <TextBlock Text="Format: HH:MM:SS or seconds" Classes="caption" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="0" Grid.Column="1" Spacing="6">
                                            <TextBlock Text="Scheduled Enqueue Time" Classes="field-label" Margin="0"/>
                                            <TextBox Text="{Binding SendMessageViewModel.ScheduledEnqueueTimeText}" AutomationProperties.Name="Scheduled Enqueue Time" PlaceholderText="e.g., 2026-10-17T10:00:00Z"/>
                                            <TextBlock Text="ISO 8601 format" Classes="caption" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Grid></StackPanel>
                            </StackPanel>
                        </ScrollViewer>

                        <ScrollViewer HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding SendMessageViewModel.IsCustomTabSelected}">
                            <StackPanel Spacing="20">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
                                    <StackPanel Spacing="6">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="Custom Properties" FontSize="16" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding SendMessageViewModel.CustomProperties.Count}" Classes="caption" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="Add custom key-value pairs to the message." Classes="caption"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Classes="secondary" VerticalAlignment="Center" Command="{Binding SendMessageViewModel.AddCustomPropertyCommand}">
                                        <StackPanel Orientation="Horizontal" Spacing="8"><LucideIcon Kind="Plus" Size="16"/>
                                            <TextBlock Text="Add Property"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                                <Grid ColumnDefinitions="*,*,34" ColumnSpacing="12" IsVisible="{Binding SendMessageViewModel.CustomProperties.Count}">
                                    <TextBlock Text="Key" Classes="caption"/>
                                    <TextBlock Grid.Column="1" Text="Value" Classes="caption"/>
                                </Grid>
                                <ItemsControl ItemsSource="{Binding SendMessageViewModel.CustomProperties}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:CustomProperty">
                                            <Grid ColumnDefinitions="*,*,34" ColumnSpacing="12" Margin="0,0,0,12">
                                                <TextBox Text="{Binding Key}" PlaceholderText="Property key" AutomationProperties.Name="Property key"/>
                                                <TextBox Grid.Column="1" Text="{Binding Value}" PlaceholderText="Property value" AutomationProperties.Name="Property value"/>
                                                <Button Grid.Column="2" Classes="danger-subtle composer-icon" ToolTip.Tip="Remove property" AutomationProperties.Name="Remove custom property"
                                                    Command="{Binding $parent[Window].DataContext.SendMessageViewModel.RemoveCustomPropertyCommand}" CommandParameter="{Binding}">
                                                    <LucideIcon Kind="X" Size="16"/>
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <StackPanel Spacing="8" Margin="24,32" HorizontalAlignment="Center" IsVisible="{Binding !SendMessageViewModel.CustomProperties.Count}">
                                    <TextBlock Text="No custom properties" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Use Add Property to include application metadata." Classes="caption" TextAlignment="Center" TextWrapping="Wrap"/>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <Border Grid.Row="4" Classes="dialog-footer" Padding="24,16">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="24">
                        <TextBlock Text="Message body is required." Classes="caption" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                            <Button Classes="secondary" Content="Cancel" MinWidth="88" Command="{Binding CancelSendMessageCommand}"/>
                            <Button Classes="primary" MinWidth="152" Command="{Binding SendMessageViewModel.SendCommand}" IsEnabled="{Binding !SendMessageViewModel.IsSending}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <LucideIcon Kind="Send" Size="16"/>
                                    <Panel>
                                        <TextBlock Text="Send Message" IsVisible="{Binding !SendMessageViewModel.IsSending}"/>
                                        <TextBlock Text="Sending..." IsVisible="{Binding SendMessageViewModel.IsSending}"/>
                                    </Panel>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Border>
</UserControl>
