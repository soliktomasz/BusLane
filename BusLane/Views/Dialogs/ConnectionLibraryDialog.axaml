<UserControl xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:BusLane.ViewModels"
    xmlns:models="using:BusLane.Models"
    xmlns:converters="using:BusLane.Converters"
    x:Class="BusLane.Views.Dialogs.ConnectionLibraryDialog"
    x:DataType="vm:MainWindowViewModel"
    x:CompileBindings="False">
    <UserControl.Resources>
        <converters:EnvironmentTabConverter x:Key="EnvironmentTabConverter"/>
    </UserControl.Resources>
    <UserControl.Styles>
        <Style Selector="Button.connection-action">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="8"/>
        </Style>
        <Style Selector="Border.connection-row:pointerover">
            <Setter Property="Background" Value="{DynamicResource HoverBackground}"/>
        </Style>
    </UserControl.Styles>

    <Border Classes="modal-overlay" IsVisible="{Binding Connection.ShowConnectionLibrary}">
        <Border Classes="modal modal-large"
            Margin="24" Padding="0"
            HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Grid RowDefinitions="Auto,*,Auto">
                <Border Grid.Row="0" Classes="dialog-header">
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="16">
                        <StackPanel Spacing="4" VerticalAlignment="Center">
                            <TextBlock Text="My Connections" FontSize="20" FontWeight="SemiBold"/>
                            <TextBlock Text="Manage your saved Service Bus connections" Classes="caption"/>
                        </StackPanel>
                        <Button Grid.Column="1" Classes="primary" VerticalAlignment="Center"
                            IsVisible="{Binding !Connection.ConnectionLibraryViewModel.IsAddingConnection, FallbackValue=True}"
                            Command="{Binding Connection.ConnectionLibraryViewModel.StartAddConnectionCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <LucideIcon Kind="Plus" Size="16"/>
                                <TextBlock Text="Add Connection"/>
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="2" Classes="subtle connection-action" VerticalAlignment="Center"
                            AutomationProperties.Name="Close connections manager" ToolTip.Tip="Close"
                            Command="{Binding CloseConnectionLibraryCommand}">
                            <LucideIcon Kind="X" Size="18"/>
                        </Button>
                    </Grid>
                </Border>

                <Grid Grid.Row="1" RowDefinitions="Auto,*"
                    IsVisible="{Binding !Connection.ConnectionLibraryViewModel.IsAddingConnection, FallbackValue=True}">
                    <Border Grid.Row="0" Classes="dialog-body" Padding="24,16,24,12">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <RadioButton Classes="tab-item"
                                    Content="All"
                                    GroupName="EnvironmentTabs"
                                    IsChecked="{Binding Connection.ConnectionLibraryViewModel.SelectedEnvironmentTab,
                                    Converter={StaticResource EnvironmentTabConverter},
                                    ConverterParameter={x:Static models:ConnectionEnvironment.None}}"/>
                                <RadioButton Classes="tab-item"
                                    Content="Development"
                                    GroupName="EnvironmentTabs"
                                    IsChecked="{Binding Connection.ConnectionLibraryViewModel.SelectedEnvironmentTab,
                                    Converter={StaticResource EnvironmentTabConverter},
                                    ConverterParameter={x:Static models:ConnectionEnvironment.Development}}"/>
                                <RadioButton Classes="tab-item"
                                    Content="Test"
                                    GroupName="EnvironmentTabs"
                                    IsChecked="{Binding Connection.ConnectionLibraryViewModel.SelectedEnvironmentTab,
                                    Converter={StaticResource EnvironmentTabConverter},
                                    ConverterParameter={x:Static models:ConnectionEnvironment.Test}}"/>
                                <RadioButton Classes="tab-item"
                                    Content="Production"
                                    GroupName="EnvironmentTabs"
                                    IsChecked="{Binding Connection.ConnectionLibraryViewModel.SelectedEnvironmentTab,
                                    Converter={StaticResource EnvironmentTabConverter},
                                    ConverterParameter={x:Static models:ConnectionEnvironment.Production}}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Connection.ConnectionLibraryViewModel.FilteredConnections.Count}" Classes="caption"/>
                                <TextBlock Text="shown" Classes="caption"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Grid Grid.Row="1" Margin="24,0">
                        <Grid RowDefinitions="Auto,*" IsVisible="{Binding Connection.ConnectionLibraryViewModel.FilteredConnections.Count}">
                            <Grid Grid.Row="0" ColumnDefinitions="*,80,90,220" ColumnSpacing="12" Margin="12,0,12,0">
                                <TextBlock Text="Saved Connections" Classes="caption" Margin="0,0,0,10"/>
                                <TextBlock Grid.Column="1" Text="Type" Classes="caption"/>
                                <TextBlock Grid.Column="2" Text="Environment" Classes="caption"/>
                            </Grid>
                            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding Connection.ConnectionLibraryViewModel.FilteredConnections}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:SavedConnection">
                                            <Border Classes="connection-row" Padding="12,14" BorderThickness="0,1,0,0"
                                                BorderBrush="{DynamicResource BorderDefault}">
                                                <Grid ColumnDefinitions="*,80,90,220" ColumnSpacing="12">
                                                    <StackPanel Spacing="4" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                                            TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}"/>
                                                        <TextBlock Text="{Binding Endpoint}" Classes="caption" TextTrimming="CharacterEllipsis"
                                                            ToolTip.Tip="{Binding Endpoint}"/>
                                                        <TextBlock Text="{Binding EntityName}" Classes="caption" TextTrimming="CharacterEllipsis"
                                                            ToolTip.Tip="{Binding EntityName}"
                                                            IsVisible="{Binding EntityName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Text="{Binding TypeDisplayName}" FontSize="12"
                                                        VerticalAlignment="Center"
                                                        ToolTip.Tip="{Binding CreatedAt, StringFormat='Added {0:MMM d, yyyy}'}"/>
                                                    <Border Grid.Column="2" Classes="badge-env" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                        IsVisible="{Binding HasEnvironment}">
                                                        <TextBlock Text="{Binding EnvironmentDisplayName}" FontSize="11" FontWeight="SemiBold"/>
                                                    </Border>
                                                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4"
                                                        VerticalAlignment="Center" HorizontalAlignment="Right">
                                                        <Button Classes="subtle connection-action" ToolTip.Tip="Toggle favorite"
                                                            AutomationProperties.Name="Toggle favorite"
                                                            Command="{Binding $parent[Window].DataContext.Connection.ConnectionLibraryViewModel.ToggleFavoriteCommand}"
                                                            CommandParameter="{Binding}">
                                                            <Panel>
                                                                <LucideIcon Kind="Star" Size="16" IsVisible="{Binding !IsFavorite}"/>
                                                                <LucideIcon Kind="Star" Size="16" Foreground="{DynamicResource TextWarning}" IsVisible="{Binding IsFavorite}"/>
                                                            </Panel>
                                                        </Button>
                                                        <Button Classes="subtle connection-action" ToolTip.Tip="Edit connection"
                                                            AutomationProperties.Name="Edit connection"
                                                            Command="{Binding $parent[Window].DataContext.Connection.ConnectionLibraryViewModel.StartEditConnectionCommand}"
                                                            CommandParameter="{Binding}">
                                                            <LucideIcon Kind="Pencil" Size="16"/>
                                                        </Button>
                                                        <Button Classes="danger-subtle connection-action" ToolTip.Tip="Delete connection"
                                                            AutomationProperties.Name="Delete connection"
                                                            Command="{Binding $parent[Window].DataContext.Connection.ConnectionLibraryViewModel.DeleteConnectionCommand}"
                                                            CommandParameter="{Binding}">
                                                            <LucideIcon Kind="Trash2" Size="16"/>
                                                        </Button>
                                                        <Button Classes="secondary" MinHeight="34" Margin="8,0,0,0"
                                                            Command="{Binding $parent[Window].DataContext.Connection.ConnectionLibraryViewModel.SelectConnectionCommand}"
                                                            CommandParameter="{Binding}">
                                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                                <TextBlock Text="Connect"/>
                                                                <LucideIcon Kind="ArrowRight" Size="14"/>
                                                            </StackPanel>
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10" Margin="24"
                            IsVisible="{Binding !Connection.ConnectionLibraryViewModel.FilteredConnections.Count, FallbackValue=True}">
                            <LucideIcon Kind="Cable" Size="28" Foreground="{DynamicResource SubtleForeground}" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                            <TextBlock Text="No connections saved" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"
                                IsVisible="{Binding !Connection.ConnectionLibraryViewModel.SavedConnections.Count}"/>
                            <TextBlock Text="No connections in this environment" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"
                                IsVisible="{Binding Connection.ConnectionLibraryViewModel.SavedConnections.Count}"/>
                            <TextBlock Text="Add a connection or import an encrypted backup below." Classes="caption" TextWrapping="Wrap" TextAlignment="Center"
                                IsVisible="{Binding !Connection.ConnectionLibraryViewModel.SavedConnections.Count}"/>
                            <TextBlock Text="Choose another environment or add a connection." Classes="caption" TextWrapping="Wrap" TextAlignment="Center"
                                IsVisible="{Binding Connection.ConnectionLibraryViewModel.SavedConnections.Count}"/>
                            <Button Classes="secondary" HorizontalAlignment="Center" Margin="0,6,0,0"
                                Command="{Binding Connection.ConnectionLibraryViewModel.StartAddConnectionCommand}">
                                <TextBlock Text="Add Connection"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>

                <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled"
                    IsVisible="{Binding Connection.ConnectionLibraryViewModel.IsAddingConnection, FallbackValue=False}">
                    <Border Classes="dialog-body" Padding="28,24">
                        <StackPanel Spacing="20">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Add New Connection" FontSize="18" FontWeight="SemiBold"
                                    IsVisible="{Binding !Connection.ConnectionLibraryViewModel.IsEditingConnection, FallbackValue=True}"/>
                                <TextBlock Text="Edit Connection" FontSize="18" FontWeight="SemiBold"
                                    IsVisible="{Binding Connection.ConnectionLibraryViewModel.IsEditingConnection, FallbackValue=False}"/>
                                <TextBlock Text="Connection details and secure credentials" Classes="caption"/>
                            </StackPanel>
                            <Grid ColumnDefinitions="*,160"
                                ColumnSpacing="16">
                                <StackPanel Grid.Column="0" Spacing="6">
                                    <TextBlock Text="Connection name"
                                        Classes="form-section-title"/>
                                    <TextBox AutomationProperties.Name="Connection name"
                                        Text="{Binding Connection.ConnectionLibraryViewModel.NewConnectionName}"
                                        PlaceholderText="e.g., Production Service Bus"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="6">
                                    <TextBlock Text="Environment"
                                        Classes="form-section-title"/>
                                    <ComboBox AutomationProperties.Name="Environment" SelectedItem="{Binding Connection.ConnectionLibraryViewModel.NewConnectionEnvironment}"
                                        ItemsSource="{Binding Connection.ConnectionLibraryViewModel.AvailableEnvironments}"
                                        HorizontalAlignment="Stretch">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>

                            <Border Height="1"
                                Background="{DynamicResource BorderDefault}"/>

                            <StackPanel Spacing="6">
                                <TextBlock Text="Connection string"
                                    Classes="form-section-title"/>
                                <Grid ColumnDefinitions="*,Auto"
                                    ColumnSpacing="8">
                                    <TextBox Grid.Column="0"
                                        AutomationProperties.Name="Connection string"
                                        Text="{Binding Connection.ConnectionLibraryViewModel.NewConnectionString}"
                                        PlaceholderText="Endpoint=sb://...;SharedAccessKeyName=...;SharedAccessKey=..."
                                        PasswordChar="●"
                                        TextWrapping="Wrap"
                                        AcceptsReturn="False"
                                        MaxHeight="80"/>
                                    <Button Grid.Column="1"
                                        Classes="secondary"
                                        ToolTip.Tip="Test connection"
                                        Command="{Binding Connection.ConnectionLibraryViewModel.CheckConnectionCommand}"
                                        IsEnabled="{Binding Connection.ConnectionLibraryViewModel.IsCheckingConnection, Converter={x:Static BoolConverters.Not}}"
                                        VerticalAlignment="Top">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <LucideIcon Kind="PlugZap" Size="16"/>
                                            <TextBlock Text="Test"
                                                IsVisible="{Binding Connection.ConnectionLibraryViewModel.IsCheckingConnection, Converter={x:Static BoolConverters.Not}}"/>
                                            <TextBlock Text="Testing..."
                                                IsVisible="{Binding Connection.ConnectionLibraryViewModel.IsCheckingConnection}"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                                <TextBlock Text="Your connection string is encrypted and stored securely"
                                    Classes="caption"/>
                            </StackPanel>

                            <Border Classes="infobar-success"
                                IsVisible="{Binding Connection.ConnectionLibraryViewModel.CheckConnectionSuccess, FallbackValue=False}">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                    <Border Width="28"
                                        Height="28"
                                        CornerRadius="{StaticResource RadiusLarge}"
                                        Background="{DynamicResource TextSuccess}">
                                        <LucideIcon Kind="Check"
                                            Size="16"
                                            Foreground="{DynamicResource TextOnBrand}"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="{Binding Connection.ConnectionLibraryViewModel.CheckConnectionResult}"
                                            FontWeight="Medium" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Connection.ConnectionLibraryViewModel.DetectedInfo}"
                                            Classes="caption" TextWrapping="Wrap"
                                            IsVisible="{Binding Connection.ConnectionLibraryViewModel.DetectedInfo, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Classes="infobar-error">
                                <Border.IsVisible>
                                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                                        <Binding Path="Connection.ConnectionLibraryViewModel.CheckConnectionResult"
                                            Converter="{x:Static StringConverters.IsNotNullOrEmpty}"/>
                                        <Binding Path="Connection.ConnectionLibraryViewModel.CheckConnectionSuccess"
                                            Converter="{x:Static BoolConverters.Not}"/>
                                    </MultiBinding>
                                </Border.IsVisible>
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                    <Border Width="28"
                                        Height="28"
                                        CornerRadius="{StaticResource RadiusLarge}"
                                        Background="{DynamicResource TextDanger}">
                                        <LucideIcon Kind="TriangleAlert"
                                            Size="16"
                                            Foreground="{DynamicResource TextOnBrand}"/>
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="{Binding Connection.ConnectionLibraryViewModel.CheckConnectionResult}"
                                        TextWrapping="Wrap"
                                        VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <TextBlock Text="{Binding Connection.ConnectionLibraryViewModel.ValidationMessage}"
                                Foreground="{DynamicResource TextDanger}"
                                IsVisible="{Binding Connection.ConnectionLibraryViewModel.ValidationMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </ScrollViewer>

                <Border Grid.Row="2" Classes="dialog-footer" Padding="24,16"
                    IsVisible="{Binding Connection.ConnectionLibraryViewModel.IsAddingConnection, FallbackValue=False}">
                    <StackPanel Classes="dialog-footer-actions">
                        <Button Classes="secondary"
                            Command="{Binding Connection.ConnectionLibraryViewModel.CancelAddConnectionCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <LucideIcon Kind="X" Size="16"/>
                                <TextBlock Text="Cancel"/>
                            </StackPanel>
                        </Button>
                        <Button Classes="primary"
                            Command="{Binding Connection.ConnectionLibraryViewModel.ValidateAndAddConnectionCommand}"
                            IsEnabled="{Binding Connection.ConnectionLibraryViewModel.IsValidating, Converter={x:Static BoolConverters.Not}}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <LucideIcon Kind="Save" Size="16"/>
                                <Panel>
                                    <TextBlock Text="Save Connection"
                                        IsVisible="{Binding Connection.ConnectionLibraryViewModel.IsEditingConnection, Converter={x:Static BoolConverters.Not}, FallbackValue=True}"/>
                                    <TextBlock Text="Update Connection"
                                        IsVisible="{Binding Connection.ConnectionLibraryViewModel.IsEditingConnection, FallbackValue=False}"/>
                                </Panel>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <Border Grid.Row="2" Background="{DynamicResource LayerBackground}"
                    BorderBrush="{DynamicResource BorderDefault}" BorderThickness="0,1,0,0"
                    IsVisible="{Binding !Connection.ConnectionLibraryViewModel.IsAddingConnection, FallbackValue=True}">
                    <Expander Name="BackupExpander" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                        AutomationProperties.Name="Backup and management" IsExpanded="False">
                        <Expander.Header>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <LucideIcon Kind="ShieldCheck" Size="16" Foreground="{DynamicResource SubtleForeground}"/>
                                <TextBlock Text="Backup &amp; Management" FontSize="13" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Expander.Header>
                        <ScrollViewer MaxHeight="220" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="24,0,24,20" Spacing="14">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="Backup passphrase"
                                        Classes="form-section-title"/>
                                    <Grid ColumnDefinitions="*,Auto,Auto"
                                        ColumnSpacing="8">
                                        <TextBox Grid.Column="0"
                                            AutomationProperties.Name="Backup passphrase"
                                            Text="{Binding Connection.ConnectionLibraryViewModel.BackupPassphrase}"
                                            PasswordChar="●"
                                            PlaceholderText="Required for encrypted export/import"/>
                                        <Button Grid.Column="1"
                                            Classes="secondary"
                                            Command="{Binding Connection.ConnectionLibraryViewModel.ExportConnectionsBackupCommand}"
                                            IsVisible="{Binding Connection.ConnectionLibraryViewModel.SavedConnections.Count}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <LucideIcon Kind="Download" Size="16"/>
                                                <TextBlock Text="Export"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Grid.Column="2"
                                            Classes="secondary"
                                            Command="{Binding Connection.ConnectionLibraryViewModel.ImportConnectionsBackupCommand}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <LucideIcon Kind="Upload" Size="16"/>
                                                <TextBlock Text="Import"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                    <TextBlock Text="Use the same passphrase when importing this backup later."
                                        Classes="caption"/>
                                    <TextBlock Text="{Binding Connection.ConnectionLibraryViewModel.BackupErrorMessage}"
                                        Foreground="{DynamicResource TextDanger}"
                                        IsVisible="{Binding Connection.ConnectionLibraryViewModel.BackupErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                        TextWrapping="Wrap"/>
                                </StackPanel>
                                <Border BorderBrush="{DynamicResource BorderDefault}" BorderThickness="0,1,0,0" Padding="0,12,0,0"
                                    IsVisible="{Binding Connection.ConnectionLibraryViewModel.SavedConnections.Count}">
                                    <Button Classes="danger-subtle" HorizontalAlignment="Left"
                                        Command="{Binding Connection.ConnectionLibraryViewModel.ClearAllConnectionsCommand}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <LucideIcon Kind="Trash2" Size="16"/>
                                            <TextBlock Text="Clear All Connections"/>
                                        </StackPanel>
                                    </Button>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Expander>
                </Border>
            </Grid>
        </Border>
    </Border>
</UserControl>
