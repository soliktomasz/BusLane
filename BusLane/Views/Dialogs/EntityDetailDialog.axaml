<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:BusLane.ViewModels"
             x:Class="BusLane.Views.Dialogs.EntityDetailDialog"
             x:DataType="vm:MainWindowViewModel"
             x:CompileBindings="False">
    <Border Classes="modal-overlay" IsVisible="{Binding EntityOperations.ShowEntityDetailDialog}">
        <Border Classes="modal" MaxWidth="720" MaxHeight="680" Margin="24" Padding="0"
                HorizontalAlignment="Stretch" VerticalAlignment="Center">
            <Grid RowDefinitions="Auto,Auto,*,Auto">
                <Border Grid.Row="0" Classes="dialog-header" Padding="24,20">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
                        <StackPanel Spacing="6">
                            <TextBlock Text="{Binding EntityOperations.EntityDetailTitle}" FontSize="20" FontWeight="SemiBold"/>
                            <TextBlock Text="Configuration and runtime properties" Classes="caption"/>
                        </StackPanel>
                        <Button Grid.Column="1" Classes="subtle" Width="34" Height="34" Padding="8"
                                VerticalAlignment="Center" Command="{Binding EntityOperations.CloseEntityDetailDialogCommand}"
                                ToolTip.Tip="Close details" AutomationProperties.Name="Close entity details">
                            <LucideIcon Kind="X" Size="18"/>
                        </Button>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Margin="24,18,24,0" Padding="12,0,12,12"
                        BorderThickness="0,0,0,1" BorderBrush="{DynamicResource BorderDefault}">
                    <Grid ColumnDefinitions="180,*" ColumnSpacing="24">
                        <TextBlock Text="Property" Classes="caption"/>
                        <TextBlock Grid.Column="1" Text="Value" Classes="caption"/>
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding EntityOperations.EntityDetailRows}" Margin="24,0,24,20">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource BorderDefault}" BorderThickness="0,0,0,1" Padding="12,14">
                                    <Grid ColumnDefinitions="180,*" ColumnSpacing="24">
                                        <TextBlock Text="{Binding Label}" FontSize="13" Foreground="{DynamicResource SubtleForeground}"
                                                   TextWrapping="Wrap" VerticalAlignment="Top"/>
                                        <SelectableTextBlock Grid.Column="1" Text="{Binding Value}" FontSize="14"
                                                             TextWrapping="Wrap"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <Border Grid.Row="3" Classes="dialog-footer" Padding="24,16">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <LucideIcon Kind="Eye" Size="16" Foreground="{DynamicResource SubtleForeground}"/>
                            <TextBlock Text="Read-only details. Select a value to copy." Classes="caption"/>
                        </StackPanel>
                        <Button Grid.Column="1" Classes="secondary" Content="Close" MinWidth="88"
                                Command="{Binding EntityOperations.CloseEntityDetailDialogCommand}"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Border>
</UserControl>
