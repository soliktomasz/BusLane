<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="using:BusLane.Models"
             xmlns:converters="using:BusLane.Converters"
             xmlns:controls="using:BusLane.Views.Controls"
             x:Class="BusLane.Views.Controls.LiveStreamView"
             x:CompileBindings="False">

    <UserControl.Resources>
        <converters:IntEqualsConverter x:Key="IntEqualsConverter"/>
    </UserControl.Resources>

    <UserControl.Styles>
        <!-- Flat timetable rows shared with Scheduled messages and Alerts: one seam per row, instant hover tint. -->
        <Style Selector="ListBox.stream-list">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        </Style>
        <Style Selector="ListBox.stream-list ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="ListBox.stream-list ListBoxItem /template/ ContentPresenter">
            <Setter Property="CornerRadius" Value="0"/>
        </Style>
        <Style Selector="ListBox.stream-list ListBoxItem:pointerover /template/ ContentPresenter, ListBox.stream-list ListBoxItem:selected /template/ ContentPresenter, ListBox.stream-list ListBoxItem:selected:pointerover /template/ ContentPresenter, ListBox.stream-list ListBoxItem:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Border.stream-row">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderDefault}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="24,9"/>
        </Style>
        <Style Selector="ListBox.stream-list ListBoxItem:pointerover Border.stream-row">
            <Setter Property="Background" Value="{DynamicResource HoverBackground}"/>
        </Style>
        <Style Selector="ListBox.stream-list ListBoxItem:selected Border.stream-row">
            <Setter Property="Background" Value="{DynamicResource SelectedBackground}"/>
        </Style>
        <Style Selector="ListBox.stream-list ListBoxItem:focus-visible Border.stream-row">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrand}"/>
        </Style>
        <Style Selector="Border.stream-table-header">
            <Setter Property="Background" Value="{DynamicResource SurfaceSubtle}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderDefault}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="24,7"/>
        </Style>
        <Style Selector="TextBlock.col-head">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="{DynamicResource SubtleForeground}"/>
        </Style>
        <Style Selector="TextBlock.row-title">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource AppForeground}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style Selector="TextBlock.row-meta">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource SubtleForeground}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style Selector="TextBlock.row-meta.code">
            <Setter Property="FontFamily" Value="{DynamicResource MonoFont}"/>
        </Style>
        <Style Selector="TextBlock.detail-label">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource SubtleForeground}"/>
        </Style>
        <Style Selector="SelectableTextBlock.detail-value">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource AppForeground}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style Selector="Border.detail-row">
            <Setter Property="BorderBrush" Value="{DynamicResource BorderDefault}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="0,9"/>
        </Style>
        <Style Selector="StackPanel.stream-empty">
            <Setter Property="Spacing" Value="6"/>
            <Setter Property="Margin" Value="24,64"/>
            <Setter Property="MaxWidth" Value="380"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>
        <Style Selector="StackPanel.stream-empty TextBlock">
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <!-- Source picker reuses the same flat rows. -->
        <Style Selector="ListBox.source-list">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style Selector="ListBox.source-list ListBoxItem">
            <Setter Property="Padding" Value="24,9"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderDefault}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="ListBox.source-list ListBoxItem /template/ ContentPresenter">
            <Setter Property="CornerRadius" Value="0"/>
        </Style>
        <Style Selector="ListBox.source-list ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource HoverBackground}"/>
        </Style>
        <Style Selector="ListBox.source-list ListBoxItem:selected /template/ ContentPresenter, ListBox.source-list ListBoxItem:selected:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SelectedBackground}"/>
        </Style>
        <Style Selector="Border.entity-icon-queue, Border.entity-icon-topic, Border.entity-icon-subscription">
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
        </Style>
        <Style Selector="Border.entity-icon-queue TextBlock, Border.entity-icon-topic TextBlock, Border.entity-icon-subscription TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Border.source-group">
            <Setter Property="Background" Value="{DynamicResource SurfaceSubtle}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderDefault}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="24,7"/>
        </Style>
    </UserControl.Styles>

    <Grid>
        <!-- Source picker -->
        <Grid IsVisible="{Binding ShowEntitySelector}" RowDefinitions="Auto,Auto,*,Auto">
            <Border Grid.Row="0" Classes="infobar-error" Margin="24,16,24,0"
                    IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                    <LucideIcon Kind="TriangleAlert" Size="16" Foreground="{DynamicResource TextDanger}"/>
                    <SelectableTextBlock Grid.Column="1" Text="{Binding ErrorMessage}" Foreground="{DynamicResource TextDanger}"
                                         TextWrapping="Wrap" FontSize="13"/>
                </Grid>
            </Border>

            <StackPanel Grid.Row="1" Spacing="2" Margin="24,18,24,14">
                <TextBlock Text="Choose a source" Classes="body-strong" FontSize="15"/>
                <TextBlock Text="Pick a queue or subscription to watch. Messages are peeked, never received, so delivery is unaffected."
                           Classes="caption" TextWrapping="Wrap"/>
            </StackPanel>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          IsVisible="{Binding HasEntities}">
                <StackPanel>
                    <StackPanel IsVisible="{Binding AvailableQueues.Count}">
                        <Border Classes="source-group" BorderThickness="0,1,0,1">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="Queues" Classes="col-head"/>
                                <TextBlock Grid.Column="1" Text="Active" Classes="col-head"/>
                            </Grid>
                        </Border>
                        <ListBox ItemsSource="{Binding AvailableQueues}"
                                 SelectedItem="{Binding SelectedStreamEntity}"
                                 Classes="source-list"
                                 DoubleTapped="OnSourceDoubleTapped"
                                 AutomationProperties.Name="Queues">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="models:QueueInfo">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                        <Border Classes="entity-icon-queue" VerticalAlignment="Center">
                                            <TextBlock Text="Q"/>
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" Classes="row-title" FontWeight="Medium"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding ActiveMessageCount}" Classes="row-meta code"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>

                    <ItemsControl ItemsSource="{Binding AvailableTopics}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="models:TopicInfo">
                                <StackPanel>
                                    <Border Classes="source-group">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                            <Border Classes="entity-icon-topic" VerticalAlignment="Center">
                                                <TextBlock Text="T"/>
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" Classes="col-head"
                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="Active" Classes="col-head" VerticalAlignment="Center"
                                                       IsVisible="{Binding Subscriptions.Count}"/>
                                        </Grid>
                                    </Border>
                                    <ListBox ItemsSource="{Binding Subscriptions}"
                                             SelectedItem="{Binding $parent[UserControl].DataContext.SelectedStreamEntity}"
                                             Classes="source-list"
                                             DoubleTapped="OnSourceDoubleTapped"
                                             IsVisible="{Binding Subscriptions.Count}"
                                             AutomationProperties.Name="{Binding Name, StringFormat='Subscriptions of {0}'}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate DataType="models:SubscriptionInfo">
                                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" Margin="20,0,0,0">
                                                    <Border Classes="entity-icon-subscription" VerticalAlignment="Center">
                                                        <TextBlock Text="S"/>
                                                    </Border>
                                                    <TextBlock Grid.Column="1" Text="{Binding Name}" Classes="row-title" FontWeight="Medium"
                                                               VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding ActiveMessageCount}" Classes="row-meta code"
                                                               VerticalAlignment="Center"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <Border BorderBrush="{DynamicResource BorderDefault}" BorderThickness="0,0,0,1" Padding="44,9,24,9"
                                            IsVisible="{Binding !Subscriptions.Count}">
                                        <TextBlock Text="{Binding DisplayStatus}" Classes="row-meta"/>
                                    </Border>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="2" Classes="stream-empty" IsVisible="{Binding !HasEntities}">
                <LucideIcon Kind="Cable" Size="22" Foreground="{DynamicResource SubtleForeground}" HorizontalAlignment="Center"/>
                <TextBlock Text="Nothing to watch yet" Classes="body-strong"/>
                <TextBlock Text="This namespace has no queues or topic subscriptions. Create one, or connect to another namespace."
                           Classes="caption"/>
            </StackPanel>

            <Border Grid.Row="3" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource BorderDefault}"
                    BorderThickness="0,1,0,0" Padding="24,12" IsVisible="{Binding HasEntities}">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                    <TextBlock Text="Select a source, or double-click one to start."
                               Classes="caption" VerticalAlignment="Center"
                               IsVisible="{Binding SelectedStreamEntity, Converter={x:Static ObjectConverters.IsNull}}"/>
                    <TextBlock Text="{Binding SelectedStreamEntity.Name}" Classes="body-strong" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               IsVisible="{Binding SelectedStreamEntity, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                    <Button Grid.Column="1" Classes="entity-header-action primary"
                            Command="{Binding StartStreamForSelectedEntityCommand}"
                            IsEnabled="{Binding SelectedStreamEntity, Converter={x:Static ObjectConverters.IsNotNull}}"
                            AutomationProperties.Name="Start live stream">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <LucideIcon Kind="Play" Size="14"/>
                            <TextBlock Text="Start watching"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
        </Grid>

        <!-- Stream session -->
        <Grid IsVisible="{Binding ShowSession}" RowDefinitions="Auto,Auto,Auto,*">
            <Border Grid.Row="0" Classes="message-search-bar" Padding="24,12">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                    <TextBox Classes="message-header-search" Width="440" HorizontalAlignment="Left"
                             Text="{Binding FilterText, Mode=TwoWay}"
                             PlaceholderText="Filter by message ID, body, correlation, or session"
                             AutomationProperties.Name="Filter captured messages">
                        <TextBox.InnerLeftContent>
                            <LucideIcon Kind="Search" Size="14" Margin="10,0,2,0"
                                        Foreground="{DynamicResource SubtleForeground}" VerticalAlignment="Center"/>
                        </TextBox.InnerLeftContent>
                        <TextBox.InnerRightContent>
                            <Button Classes="icon-button" Command="{Binding ClearFilterCommand}" Padding="5" Margin="0,0,4,0"
                                    IsVisible="{Binding FilterText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                    ToolTip.Tip="Clear filter" AutomationProperties.Name="Clear message filter">
                                <LucideIcon Kind="X" Size="12"/>
                            </Button>
                        </TextBox.InnerRightContent>
                    </TextBox>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <TextBlock Text="{Binding CountSummary}" Classes="caption" VerticalAlignment="Center" Margin="0,0,6,0"
                                   ToolTip.Tip="{Binding MaxCapturedMessages, StringFormat='The stream keeps the newest {0} messages; older ones drop off.'}"/>
                        <ToggleButton Classes="icon-button" IsChecked="{Binding AutoScroll}" Padding="7"
                                      ToolTip.Tip="Follow newest: select each new message as it arrives"
                                      AutomationProperties.Name="Follow newest messages">
                            <LucideIcon Kind="ArrowDownToLine" Size="14"/>
                        </ToggleButton>
                        <Button Classes="icon-button" Command="{Binding ClearMessagesCommand}" Padding="7"
                                ToolTip.Tip="Clear captured messages. The stream keeps running."
                                AutomationProperties.Name="Clear captured messages">
                            <LucideIcon Kind="Eraser" Size="14"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="1" Background="{DynamicResource SurfaceDanger}" BorderBrush="{DynamicResource BorderDefault}"
                    BorderThickness="0,0,0,1" Padding="24,10"
                    IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                    <LucideIcon Kind="TriangleAlert" Size="15" Foreground="{DynamicResource TextDanger}" VerticalAlignment="Top" Margin="0,1,0,0"/>
                    <StackPanel Grid.Column="1" Spacing="2">
                        <SelectableTextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource TextDanger}"
                                             TextWrapping="Wrap" FontSize="13" FontWeight="Medium"/>
                        <TextBlock Text="BusLane keeps retrying every few seconds. Stop the stream to give up."
                                   Classes="caption" IsVisible="{Binding IsActive}"/>
                        <TextBlock Text="The stream could not start. Check the source name and your access, then resume."
                                   Classes="caption" IsVisible="{Binding !IsActive}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="2" Background="{DynamicResource SurfaceWarning}" BorderBrush="{DynamicResource BorderDefault}"
                    BorderThickness="0,0,0,1" Padding="24,8" IsVisible="{Binding IsPaused}">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                    <LucideIcon Kind="Pause" Size="14" Foreground="{DynamicResource TextWarning}" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <TextBlock Text="Paused. The list is frozen while polling continues." FontSize="13"
                                   Foreground="{DynamicResource AppForeground}"/>
                        <TextBlock Text="{Binding PausedMessageCount, StringFormat='{}{0} new waiting'}" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextWarning}"
                                   IsVisible="{Binding PausedMessageCount}"/>
                    </StackPanel>
                    <Button Grid.Column="2" Classes="subtle small" Command="{Binding TogglePauseCommand}"
                            AutomationProperties.Name="Resume updating the list">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <LucideIcon Kind="Play" Size="13"/>
                            <TextBlock Text="Show new messages"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <Grid Grid.Row="3" ColumnDefinitions="3*,1,2*" MinWidth="0">
                <Grid Grid.Column="0" RowDefinitions="Auto,*">
                    <Border Grid.Row="0" Classes="stream-table-header">
                        <Grid ColumnDefinitions="92,*,Auto" ColumnSpacing="14">
                            <TextBlock Text="Enqueued" Classes="col-head"/>
                            <TextBlock Grid.Column="1" Text="Message" Classes="col-head"/>
                            <TextBlock Grid.Column="2" Text="Sequence" Classes="col-head"/>
                        </Grid>
                    </Border>

                    <ListBox Grid.Row="1"
                             x:Name="MessageList"
                             ItemsSource="{Binding FilteredMessages}"
                             SelectedItem="{Binding SelectedMessage}"
                             Classes="stream-list"
                             AutomationProperties.Name="Captured messages">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="models:LiveStreamMessage">
                                <Border Classes="stream-row">
                                    <Grid ColumnDefinitions="92,*,Auto" ColumnSpacing="14">
                                        <TextBlock Text="{Binding EnqueuedAt, StringFormat='{}{0:HH:mm:ss.fff}'}"
                                                   Classes="row-meta code" VerticalAlignment="Top" Margin="0,1,0,0"
                                                   ToolTip.Tip="{Binding EnqueuedAt, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss.fff zzz}'}"/>
                                        <StackPanel Grid.Column="1" Spacing="3">
                                            <TextBlock Text="{Binding MessageId}" Classes="row-title"/>
                                            <TextBlock Text="{Binding BodyPreview}" Classes="row-meta code" MaxLines="1"
                                                       IsVisible="{Binding BodyPreview, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                            <StackPanel Orientation="Horizontal" Spacing="12">
                                                <TextBlock Text="{Binding CorrelationId, StringFormat='{}Correlation {0}'}" Classes="row-meta"
                                                           MaxWidth="240"
                                                           IsVisible="{Binding CorrelationId, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                                <TextBlock Text="{Binding SessionId, StringFormat='{}Session {0}'}" Classes="row-meta"
                                                           MaxWidth="200"
                                                           IsVisible="{Binding SessionId, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding SequenceNumber}" Classes="row-meta code"
                                                   VerticalAlignment="Top" Margin="0,1,0,0"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Grid.Row="1" IsVisible="{Binding !FilteredMessages.Count}">
                        <StackPanel Classes="stream-empty" IsVisible="{Binding IsConnecting}">
                            <ProgressBar IsIndeterminate="True" Width="160" Height="3" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                            <TextBlock Text="{Binding CurrentEntityName, StringFormat='Connecting to {0}'}" Classes="body-strong"/>
                            <TextBlock Text="Waiting for the first peek to answer." Classes="caption"/>
                        </StackPanel>
                        <StackPanel Classes="stream-empty">
                            <StackPanel.IsVisible>
                                <MultiBinding Converter="{x:Static BoolConverters.And}">
                                    <Binding Path="!IsConnecting"/>
                                    <Binding Path="FilterText" Converter="{x:Static StringConverters.IsNullOrEmpty}"/>
                                </MultiBinding>
                            </StackPanel.IsVisible>
                            <TextBlock Text="No messages yet" Classes="body-strong"/>
                            <TextBlock Text="Messages already in the source and any that arrive appear here, newest first."
                                       Classes="caption" IsVisible="{Binding IsStreaming}"/>
                            <TextBlock Text="The stream is stopped. Resume it to keep watching."
                                       Classes="caption" IsVisible="{Binding IsStopped}"/>
                        </StackPanel>
                        <StackPanel Classes="stream-empty"
                                    IsVisible="{Binding FilterText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                            <TextBlock Text="No captured messages match" Classes="body-strong"/>
                            <TextBlock Text="The filter checks message ID, body, correlation ID, and session ID." Classes="caption"/>
                            <Button Classes="subtle small" Content="Clear filter" HorizontalAlignment="Center" Margin="0,6,0,0"
                                    Command="{Binding ClearFilterCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <GridSplitter Grid.Column="1" Width="1" Background="{DynamicResource BorderDefault}"
                              ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"/>

                <!-- Inspector -->
                <Border Grid.Column="2" Background="{DynamicResource CardBackground}" MinWidth="280">
                    <Grid>
                        <StackPanel Classes="stream-empty" IsVisible="{Binding SelectedMessage, Converter={x:Static ObjectConverters.IsNull}}">
                            <LucideIcon Kind="PanelRight" Size="22" Foreground="{DynamicResource SubtleForeground}" HorizontalAlignment="Center"/>
                            <TextBlock Text="Select a message" Classes="body-strong"/>
                            <TextBlock Text="Its payload, broker metadata, and application properties show here." Classes="caption"/>
                        </StackPanel>

                        <Grid IsVisible="{Binding SelectedMessage, Converter={x:Static ObjectConverters.IsNotNull}}"
                              RowDefinitions="Auto,*">
                            <Border Grid.Row="0" BorderBrush="{DynamicResource BorderDefault}" BorderThickness="0,0,0,1" Padding="18,14,12,12">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <StackPanel Spacing="3">
                                        <SelectableTextBlock Text="{Binding SelectedMessage.MessageId}" FontSize="14" FontWeight="SemiBold"
                                                             TextWrapping="Wrap" Foreground="{DynamicResource AppForeground}"/>
                                        <TextBlock Classes="row-meta">
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="{}Seq {0} · {1:HH:mm:ss.fff}">
                                                    <Binding Path="SelectedMessage.SequenceNumber"/>
                                                    <Binding Path="SelectedMessage.EnqueuedAt"/>
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </StackPanel>
                                    <Button Grid.Column="1" Classes="icon-button" Padding="6" VerticalAlignment="Top"
                                            Command="{Binding CopySelectedMessageIdCommand}"
                                            ToolTip.Tip="Copy message ID" AutomationProperties.Name="Copy message ID">
                                        <LucideIcon Kind="Copy" Size="14"/>
                                    </Button>
                                </Grid>
                            </Border>

                            <TabControl Grid.Row="1" Classes="inspector-tabs message-inspector-tabs">
                                <TabItem Header="Payload">
                                    <Grid RowDefinitions="Auto,*">
                                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="18,8,12,8">
                                            <TextBlock Text="{Binding SelectedMessage.ContentType, TargetNullValue='No content type'}"
                                                       Classes="caption" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                            <Button Grid.Column="1" Classes="subtle small" Command="{Binding CopySelectedBodyCommand}"
                                                    AutomationProperties.Name="Copy message body">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <LucideIcon Kind="Copy" Size="13"/>
                                                    <TextBlock Text="Copy body"/>
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                        <controls:SyntaxHighlightedTextBox Grid.Row="1"
                                                                           Text="{Binding SelectedBody, Mode=OneWay}"
                                                                           IsJson="{Binding IsSelectedBodyJson}"
                                                                           IsXml="{Binding IsSelectedBodyXml}"/>
                                    </Grid>
                                </TabItem>
                                <TabItem Header="Metadata">
                                    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                                        <StackPanel Margin="18,6,18,14">
                                            <Border Classes="detail-row">
                                                <Grid ColumnDefinitions="112,*" ColumnSpacing="12">
                                                    <TextBlock Text="Source" Classes="detail-label"/>
                                                    <SelectableTextBlock Grid.Column="1" Classes="detail-value">
                                                        <SelectableTextBlock.Text>
                                                            <MultiBinding StringFormat="{}{0} · {1}">
                                                                <Binding Path="SelectedMessage.EntityType"/>
                                                                <Binding Path="CurrentEntityName"/>
                                                            </MultiBinding>
                                                        </SelectableTextBlock.Text>
                                                    </SelectableTextBlock>
                                                </Grid>
                                            </Border>
                                            <Border Classes="detail-row">
                                                <Grid ColumnDefinitions="112,*" ColumnSpacing="12">
                                                    <TextBlock Text="Enqueued" Classes="detail-label"/>
                                                    <SelectableTextBlock Grid.Column="1" Classes="detail-value"
                                                                         Text="{Binding SelectedMessage.EnqueuedAt, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss.fff zzz}'}"/>
                                                </Grid>
                                            </Border>
                                            <Border Classes="detail-row">
                                                <Grid ColumnDefinitions="112,*" ColumnSpacing="12">
                                                    <TextBlock Text="Sequence" Classes="detail-label"/>
                                                    <SelectableTextBlock Grid.Column="1" Classes="detail-value" Text="{Binding SelectedMessage.SequenceNumber}"/>
                                                </Grid>
                                            </Border>
                                            <Border Classes="detail-row">
                                                <Grid ColumnDefinitions="112,*" ColumnSpacing="12">
                                                    <TextBlock Text="Correlation ID" Classes="detail-label"/>
                                                    <SelectableTextBlock Grid.Column="1" Classes="detail-value"
                                                                         Text="{Binding SelectedMessage.CorrelationId, TargetNullValue='Not set'}"/>
                                                </Grid>
                                            </Border>
                                            <Border Classes="detail-row">
                                                <Grid ColumnDefinitions="112,*" ColumnSpacing="12">
                                                    <TextBlock Text="Session ID" Classes="detail-label"/>
                                                    <SelectableTextBlock Grid.Column="1" Classes="detail-value"
                                                                         Text="{Binding SelectedMessage.SessionId, TargetNullValue='Not set'}"/>
                                                </Grid>
                                            </Border>
                                            <Border Classes="detail-row" BorderThickness="0">
                                                <Grid ColumnDefinitions="112,*" ColumnSpacing="12">
                                                    <TextBlock Text="Content type" Classes="detail-label"/>
                                                    <SelectableTextBlock Grid.Column="1" Classes="detail-value"
                                                                         Text="{Binding SelectedMessage.ContentType, TargetNullValue='Not set'}"/>
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                    </ScrollViewer>
                                </TabItem>
                                <TabItem Header="Properties">
                                    <Grid>
                                        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                                            <ItemsControl ItemsSource="{Binding SelectedMessage.Properties}" Margin="18,6,18,14">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Classes="detail-row">
                                                            <Grid ColumnDefinitions="112,*" ColumnSpacing="12">
                                                                <TextBlock Text="{Binding Key}" Classes="detail-label" TextTrimming="CharacterEllipsis"
                                                                           ToolTip.Tip="{Binding Key}"/>
                                                                <SelectableTextBlock Grid.Column="1" Classes="detail-value" Text="{Binding Value}"
                                                                                     FontFamily="{DynamicResource MonoFont}" FontSize="12"/>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                        <StackPanel Classes="stream-empty" Margin="24,40"
                                                    IsVisible="{Binding SelectedMessage.Properties.Count, Converter={StaticResource IntEqualsConverter}, ConverterParameter=0}">
                                            <TextBlock Text="No application properties" Classes="body-strong"/>
                                            <TextBlock Text="The sender set no custom properties on this message." Classes="caption"/>
                                        </StackPanel>
                                    </Grid>
                                </TabItem>
                            </TabControl>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
