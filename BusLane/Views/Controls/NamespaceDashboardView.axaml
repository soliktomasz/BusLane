<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:BusLane.ViewModels.Dashboard;assembly=BusLane"
             xmlns:controls="clr-namespace:BusLane.Views.Controls;assembly=BusLane"
             mc:Ignorable="d"
             x:Class="BusLane.Views.Controls.NamespaceDashboardView"
             x:DataType="vm:NamespaceDashboardViewModel"
             x:CompileBindings="False">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto"
              Margin="26">

            <!-- Header -->
            <Border Grid.Row="0"
                    Classes="page-header-surface"
                    Margin="0,0,0,24">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <Border Grid.Column="0" Classes="metric-icon-surface" Margin="0,0,12,0">
                        <LucideIcon Kind="LayoutDashboard" Size="16"
                                    Foreground="{DynamicResource AccentBrand}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1"
                                Spacing="4"
                                VerticalAlignment="Center">
                        <TextBlock Text="Namespace Overview"
                                   Classes="heading"/>
                        <TextBlock Text="Use the inbox first, then skim the summary and supporting trends."
                                   Classes="caption"/>
                        <TextBlock Text="Topic metrics loading progressively..."
                                   Classes="caption"
                                   IsVisible="{Binding IsPartialSnapshot}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                Spacing="12"
                                VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ToggleSwitch IsChecked="{Binding AutoRefreshEnabled}"
                                         OnContent="Auto"
                                         OffContent="Auto"/>
                            <StackPanel Orientation="Horizontal"
                                        Spacing="4"
                                        VerticalAlignment="Center"
                                        IsVisible="{Binding AutoRefreshEnabled}">
                                <ComboBox ItemsSource="{Binding RefreshIntervalOptions}"
                                          SelectedItem="{Binding RefreshIntervalSeconds}"
                                          Width="78"/>
                                <TextBlock Text="sec"
                                           Classes="caption"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>

                        <Button Classes="secondary small"
                                Command="{Binding RefreshCommand}"
                                IsEnabled="{Binding !IsRefreshing}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <LucideIcon Kind="RefreshCw" Size="14"/>
                                <TextBlock Text="Refresh"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Priority Inbox -->
            <controls:NamespaceInboxView Grid.Row="1"
                                         DataContext="{Binding Inbox}"
                                         Margin="0,0,0,24"/>

            <!-- Metric Cards Row -->
            <Grid Grid.Row="2" ColumnDefinitions="*,*,*,*" ColumnSpacing="16" Margin="0,0,0,24">
                <Border Grid.Column="0" Classes="dashboard-summary-surface">
                    <controls:MetricCard DataContext="{Binding ActiveMessagesCard}"/>
                </Border>

                <Border Grid.Column="1" Classes="dashboard-summary-surface">
                    <controls:MetricCard DataContext="{Binding DeadLetterCard}"/>
                </Border>

                <Border Grid.Column="2" Classes="dashboard-summary-surface">
                    <controls:MetricCard DataContext="{Binding ScheduledCard}"/>
                </Border>

                <Border Grid.Column="3" Classes="dashboard-summary-surface">
                    <controls:MetricCard DataContext="{Binding SizeCard}"/>
                </Border>
            </Grid>

            <!-- Top Entities Lists -->
            <Grid Grid.Row="3" ColumnDefinitions="*,*" Margin="0,0,0,24">
                <controls:TopEntitiesList Grid.Column="0"
                                          DataContext="{Binding TopQueues}"
                                          Margin="0,0,12,0"/>
                <controls:TopEntitiesList Grid.Column="1"
                                          DataContext="{Binding TopTopics}"
                                          Margin="12,0,0,0"/>
            </Grid>

            <!-- Charts Grid: fixed 2x2 so every card is the same height and width -->
            <Grid Grid.Row="4"
                  ColumnDefinitions="*,*"
                  RowDefinitions="Auto,Auto"
                  ColumnSpacing="24"
                  RowSpacing="24">
                <controls:DashboardChart Grid.Row="0" Grid.Column="0" DataContext="{Binding Charts[0]}"/>
                <controls:DashboardChart Grid.Row="0" Grid.Column="1" DataContext="{Binding Charts[1]}"/>
                <controls:DashboardChart Grid.Row="1" Grid.Column="0" DataContext="{Binding Charts[2]}"/>
                <controls:DashboardChart Grid.Row="1" Grid.Column="1" DataContext="{Binding Charts[3]}"/>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
