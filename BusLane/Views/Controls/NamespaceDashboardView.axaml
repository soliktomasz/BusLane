<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:BusLane.ViewModels.Dashboard"
             xmlns:models="using:BusLane.Models.Dashboard"
             xmlns:controls="using:BusLane.Views.Controls"
             x:Class="BusLane.Views.Controls.NamespaceDashboardView"
             x:DataType="vm:NamespaceDashboardViewModel"
             x:CompileBindings="False">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="26" Spacing="20">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="4">
                    <TextBlock Text="Namespace Overview" Classes="heading"/>
                    <TextBlock Text="Find entities fast, then work highest-impact exceptions first." Classes="caption"/>
                    <TextBlock Text="Topic metrics updating progressively" Classes="caption"
                               IsVisible="{Binding IsPartialSnapshot}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button Classes="subtle small" Command="{Binding ShowHomeCommand}" Content="Home"/>
                    <Button Classes="subtle small" Command="{Binding ShowIssuesCommand}" Content="Issues"/>
                    <Button Classes="subtle small" Command="{Binding ShowAnalyticsCommand}" Content="Analytics"/>
                    <Button Classes="secondary small" Command="{Binding RefreshCommand}"
                            IsEnabled="{Binding !IsRefreshing}" Content="Refresh"/>
                </StackPanel>
            </Grid>

            <StackPanel IsVisible="{Binding IsHomeSelected}" Spacing="20">
                <controls:NamespaceEntitySearchView DataContext="{Binding EntitySearch}"/>

                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="16">
                    <Border Grid.Column="0" Classes="dashboard-summary-surface">
                        <StackPanel><TextBlock Text="NEEDS ACTION" Classes="dashboard-section-label"/>
                            <TextBlock Text="{Binding Inbox.NeedsActionCount}" Classes="heading"/></StackPanel>
                    </Border>
                    <Border Grid.Column="1" Classes="dashboard-summary-surface">
                        <controls:MetricCard DataContext="{Binding DeadLetterCard}"/>
                    </Border>
                    <Border Grid.Column="2" Classes="dashboard-summary-surface">
                        <controls:MetricCard DataContext="{Binding ActiveMessagesCard}"/>
                    </Border>
                </Grid>

                <Grid ColumnDefinitions="2*,*" ColumnSpacing="16">
                    <StackPanel Grid.Column="0" Spacing="6">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="PRIORITY WORK" Classes="dashboard-section-label"/>
                            <Button Grid.Column="1" Classes="subtle small" Command="{Binding ShowIssuesCommand}"
                                    Content="View all issues"/>
                        </Grid>
                        <controls:NamespaceInboxView DataContext="{Binding Inbox}"/>
                    </StackPanel>

                    <Border Grid.Column="1" Classes="card">
                        <StackPanel Spacing="14">
                            <TextBlock Text="CONTINUE WORK" Classes="dashboard-section-label"/>
                            <TextBlock Text="Pinned" FontWeight="SemiBold"/>
                            <ItemsControl ItemsSource="{Binding PinnedDestinations}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:NamespaceEntitySearchResult">
                                        <Button Classes="subtle small" HorizontalAlignment="Stretch"
                                                Command="{Binding $parent[UserControl].DataContext.OpenDestinationCommand}"
                                                CommandParameter="{Binding}" Content="{Binding DisplayPath}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="Recent" FontWeight="SemiBold"/>
                            <ItemsControl ItemsSource="{Binding RecentDestinations}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:NamespaceEntitySearchResult">
                                        <Button Classes="subtle small" HorizontalAlignment="Stretch"
                                                Command="{Binding $parent[UserControl].DataContext.OpenDestinationCommand}"
                                                CommandParameter="{Binding}" Content="{Binding DisplayPath}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Classes="secondary small" Command="{Binding ShowAnalyticsCommand}" Content="Open Analytics"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>

            <StackPanel IsVisible="{Binding IsIssuesSelected}" Spacing="10">
                <TextBlock Text="All Issues" Classes="title"/>
                <controls:NamespaceIssuesView DataContext="{Binding Inbox}"/>
            </StackPanel>

            <StackPanel IsVisible="{Binding IsAnalyticsSelected}" Spacing="16">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="Analytics" Classes="title"/>
                    <ComboBox Grid.Column="1" ItemsSource="{Binding TimeRangeOptions}"
                              SelectedItem="{Binding SelectedTimeRange}" Width="140"/>
                </Grid>
                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="16" RowSpacing="16">
                    <controls:DashboardChart Grid.Row="0" Grid.Column="0" DataContext="{Binding Charts[0]}"/>
                    <controls:DashboardChart Grid.Row="0" Grid.Column="1" DataContext="{Binding Charts[1]}"/>
                    <controls:DashboardChart Grid.Row="1" Grid.Column="0" DataContext="{Binding Charts[2]}"/>
                    <controls:DashboardChart Grid.Row="1" Grid.Column="1" DataContext="{Binding Charts[3]}"/>
                </Grid>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
