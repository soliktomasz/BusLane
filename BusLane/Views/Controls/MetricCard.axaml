<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:BusLane.ViewModels.Dashboard;assembly=BusLane"
             xmlns:controls="clr-namespace:BusLane.Views.Controls;assembly=BusLane"
             mc:Ignorable="d"
             x:Name="Root"
             x:Class="BusLane.Views.Controls.MetricCard"
             x:DataType="vm:MetricCardViewModel"
             x:CompileBindings="False">

    <!-- One cell of the overview health strip: title, value, change since the last refresh, recent shape. -->
    <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="6">
        <TextBlock Text="{Binding Title}" Classes="overview-metric-title"/>
        <TextBlock Grid.Row="1" Text="{Binding ValueDisplay}" Classes="overview-metric-value"/>
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="4">
            <LucideIcon Kind="TrendingUp" Size="13" Classes="overview-metric-caption-icon"
                        IsVisible="{Binding IsTrendUp}"/>
            <LucideIcon Kind="TrendingDown" Size="13" Classes="overview-metric-caption-icon"
                        IsVisible="{Binding IsTrendDown}"/>
            <TextBlock Text="{Binding TrendDisplay}" Classes="overview-metric-caption"/>
        </StackPanel>
        <Border Grid.Row="3" Height="26" Margin="0,4,0,0">
            <controls:SparklineView Values="{Binding SparklineData}"
                                    Stroke="{Binding SparklineStroke, ElementName=Root}"/>
        </Border>
    </Grid>
</UserControl>
