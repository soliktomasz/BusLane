<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:BusLane.ViewModels.Dashboard;assembly=BusLane"
             xmlns:controls="clr-namespace:BusLane.Views.Controls;assembly=BusLane"
             mc:Ignorable="d"
             x:Name="Root"
             x:Class="BusLane.Views.Controls.MetricCard"
             x:DataType="vm:MetricCardViewModel"
             x:CompileBindings="False">

    <StackPanel Spacing="6">
        <TextBlock Text="{Binding Title}"
                   Classes="caption"
                   FontWeight="SemiBold"/>

        <TextBlock Text="{Binding ValueDisplay}"
                   FontSize="30"
                   FontWeight="Bold"
                   FontFamily="Cascadia Code, Consolas, Monaco, monospace"
                   Foreground="{DynamicResource AppForeground}"/>

        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
            <TextBlock Text="{Binding TrendPercentage, StringFormat='{}{0:+0.0;-0.0;0}%'}"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="{Binding TrendForeground, ElementName=Root}"/>
            <TextBlock Text="vs prev"
                       Classes="caption"
                       VerticalAlignment="Center"/>
        </StackPanel>

        <Border Height="30"
                Padding="2,0"
                Margin="0,6,0,0">
            <controls:SparklineView Values="{Binding SparklineData}"
                                    Stroke="{Binding SparklineStroke, ElementName=Root}"/>
        </Border>
    </StackPanel>
</UserControl>
