<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sp="using:ScottPlot.Avalonia"
             x:Class="BusLane.Views.Controls.DashboardPlotView"
             Focusable="False">
    <Grid>
        <sp:AvaPlot x:Name="PlotHost"
                    IsHitTestVisible="True"/>

        <!-- Empty / no-data state (Calm Operator: quiet centered placeholder) -->
        <Border x:Name="EmptyState"
                IsVisible="False"
                Background="{DynamicResource SurfaceSubtle}"
                BorderBrush="{DynamicResource BorderMuted}"
                BorderThickness="1"
                CornerRadius="{StaticResource RadiusMedium}"
                Margin="6"
                VerticalAlignment="Stretch"
                HorizontalAlignment="Stretch">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="6">
                <LucideIcon Kind="ChartSpline" Size="22"
                            Foreground="{DynamicResource SubtleForeground}"
                            HorizontalAlignment="Center"
                            Opacity="0.45"/>
                <TextBlock x:Name="EmptyStateText"
                           Text="No data yet"
                           Classes="caption"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
