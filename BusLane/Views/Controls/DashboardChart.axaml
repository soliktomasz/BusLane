<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:BusLane.ViewModels.Dashboard;assembly=BusLane"
             xmlns:controls="clr-namespace:BusLane.Views.Controls;assembly=BusLane"
             mc:Ignorable="d"
             x:Class="BusLane.Views.Controls.DashboardChart"
             x:DataType="vm:DashboardChartViewModel"
             x:CompileBindings="False">

    <Border Classes="overview-panel" HorizontalAlignment="Stretch">
        <Grid RowDefinitions="Auto,*">
            <Border Grid.Row="0" Classes="overview-panel-header">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{Binding Title}" Classes="overview-panel-title"/>
                    <ComboBox Grid.Column="1"
                              Classes="overview-range"
                              ItemsSource="{Binding TimeRangeOptions}"
                              SelectedItem="{Binding SelectedTimeRange}"
                              AutomationProperties.Name="{Binding Title, StringFormat='Time range for {0}'}"/>
                </Grid>
            </Border>

            <controls:DashboardPlotView Grid.Row="1" Height="220" Margin="8,8,12,8" Data="{Binding PlotData}"/>
        </Grid>
    </Border>
</UserControl>
