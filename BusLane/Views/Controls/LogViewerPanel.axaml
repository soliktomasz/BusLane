<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:BusLane.ViewModels"
             xmlns:models="using:BusLane.Models.Logging"
             xmlns:converters="using:BusLane.Converters"
             x:Class="BusLane.Views.Controls.LogViewerPanel"
             x:DataType="vm:LogViewerViewModel"
             x:CompileBindings="False"
             Name="LogViewerControl"
             IsVisible="{Binding IsOpen}">
    <UserControl.Styles>
        <Style Selector="Border.log-viewer-panel-surface">
            <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
        </Style>
        <Style Selector="Button.log-icon">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="8"/>
        </Style>
        <Style Selector="Border.log-entry">
            <Setter Property="Padding" Value="24,16"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderDefault}"/>
        </Style>
        <Style Selector="Border.log-entry:pointerover">
            <Setter Property="Background" Value="{DynamicResource HoverBackground}"/>
        </Style>
        <Style Selector="TextBlock.log-level">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="TextBlock.log-level.Info">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrand}"/>
        </Style>
        <Style Selector="TextBlock.log-level.Warning">
            <Setter Property="Foreground" Value="{DynamicResource TextWarningHover}"/>
        </Style>
        <Style Selector="TextBlock.log-level.Error">
            <Setter Property="Foreground" Value="{DynamicResource TextDanger}"/>
        </Style>
        <Style Selector="TextBlock.log-level.Debug">
            <Setter Property="Foreground" Value="{DynamicResource SubtleForeground}"/>
        </Style>
    </UserControl.Styles>

    <Grid>
        <Button Background="{DynamicResource ModalOverlay}" Command="{Binding CloseCommand}"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch" BorderThickness="0"
                CornerRadius="0" Padding="0" Cursor="Arrow" Focusable="False"
                AutomationProperties.Name="Dismiss activity log">
            <Button.Template>
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}"/>
                </ControlTemplate>
            </Button.Template>
        </Button>
        <Border Classes="log-viewer-panel-surface" Width="600"
                MaxWidth="{Binding Bounds.Width, ElementName=LogViewerControl}"
                HorizontalAlignment="Right" VerticalAlignment="Stretch"
                BorderBrush="{DynamicResource BorderStrong}" BorderThickness="1,0,0,0"
                BoxShadow="-8 0 24 0 #32000000">
            <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
                <Border Grid.Row="0" Background="{DynamicResource SurfaceSubtle}"
                        BorderBrush="{DynamicResource BorderDefault}" BorderThickness="0,0,0,1"
                        Padding="24,20">
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                        <TextBlock Text="Activity Log" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Classes="secondary" Command="{Binding CopyAllCommand}"
                                IsEnabled="{Binding ShowingLogCount}" ToolTip.Tip="Copy filtered log entries">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <LucideIcon Kind="Copy" Size="16"/>
                                <TextBlock Text="Copy visible"/>
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="2" Classes="subtle log-icon" Command="{Binding CloseCommand}"
                                ToolTip.Tip="Close activity log" AutomationProperties.Name="Close activity log">
                            <LucideIcon Kind="X" Size="18"/>
                        </Button>
                    </Grid>
                </Border>

                <StackPanel Grid.Row="1" Margin="24,20,24,16" Spacing="14">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBox Text="{Binding SearchText, Mode=TwoWay}" PlaceholderText="Search messages and details"
                                 AutomationProperties.Name="Search activity log" MinHeight="36" Padding="12,8"/>
                        <Button Grid.Column="1" Classes="subtle log-icon" Margin="8,0,0,0"
                                Command="{Binding ClearSearchCommand}" ToolTip.Tip="Clear search"
                                AutomationProperties.Name="Clear search"
                                IsVisible="{Binding SearchText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                            <LucideIcon Kind="X" Size="16"/>
                        </Button>
                    </Grid>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Level" Classes="caption"/>
                            <ComboBox ItemsSource="{Binding LevelFilterOptions}" SelectedItem="{Binding SelectedLevelFilter}"
                                      HorizontalAlignment="Stretch" AutomationProperties.Name="Log level" MinHeight="36">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ., TargetNullValue='All levels'}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="6">
                            <TextBlock Text="Source" Classes="caption"/>
                            <ComboBox ItemsSource="{Binding SourceFilterOptions}" SelectedItem="{Binding SelectedSourceFilter}"
                                      HorizontalAlignment="Stretch" AutomationProperties.Name="Log source" MinHeight="36">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ., TargetNullValue='All sources'}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <Border Grid.Row="2" Padding="24,0,24,12" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource BorderDefault}">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="{Binding ShowingLogCount}" Classes="caption"/>
                            <TextBlock Text="of" Classes="caption"/>
                            <TextBlock Text="{Binding TotalLogCount}" Classes="caption"/>
                            <TextBlock Text="entries" Classes="caption"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="Newest first" Classes="caption"/>
                    </Grid>
                </Border>

                <Grid Grid.Row="3">
                    <ListBox x:Name="LogListBox" ItemsSource="{Binding FilteredLogs}" Background="Transparent" Padding="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Activity entries">
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="Background" Value="Transparent"/>
                            </Style>
                        </ListBox.Styles>
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="models:LogEntry">
                                <Border Classes="log-entry">
                                    <Border.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Copy Entry"
                                                      Command="{Binding $parent[UserControl].DataContext.CopyEntryCommand}"
                                                      CommandParameter="{Binding}">
                                                <MenuItem.Icon>
                                                    <LucideIcon Kind="Copy" Size="16"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="Copy Message"
                                                      Command="{Binding $parent[UserControl].DataContext.CopyEntryCommand}"
                                                      CommandParameter="{Binding}">
                                                <MenuItem.Icon>
                                                    <LucideIcon Kind="FileText" Size="16"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                        </ContextMenu>
                                    </Border.ContextMenu>
                                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="6">
                                        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Timestamp, StringFormat='HH:mm:ss.fff'}" Classes="caption"
                                                       ToolTip.Tip="{Binding Timestamp, StringFormat='yyyy-MM-dd HH:mm:ss.fff'}"/>
                                            <TextBlock Text="{Binding Level}" Classes="log-level"
                                                       Classes.Info="{Binding Level, Converter={x:Static converters:LogLevelToBoolConverter.Instance}, ConverterParameter=Info}"
                                                       Classes.Warning="{Binding Level, Converter={x:Static converters:LogLevelToBoolConverter.Instance}, ConverterParameter=Warning}"
                                                       Classes.Error="{Binding Level, Converter={x:Static converters:LogLevelToBoolConverter.Instance}, ConverterParameter=Error}"
                                                       Classes.Debug="{Binding Level, Converter={x:Static converters:LogLevelToBoolConverter.Instance}, ConverterParameter=Debug}"/>
                                            <TextBlock Text="{Binding Source}" Classes="caption"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Classes="subtle log-icon" VerticalAlignment="Center"
                                                Command="{Binding $parent[UserControl].DataContext.CopyEntryCommand}" CommandParameter="{Binding}"
                                                ToolTip.Tip="Copy entry" AutomationProperties.Name="Copy log entry">
                                            <LucideIcon Kind="Copy" Size="16"/>
                                        </Button>
                                        <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Message}"
                                                   FontSize="14" FontWeight="Medium" TextWrapping="Wrap"/>
                                        <SelectableTextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding Details}"
                                                             FontSize="13" Foreground="{DynamicResource SubtleForeground}" TextWrapping="Wrap"
                                                             IsVisible="{Binding Details, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Border Background="{DynamicResource CardBackground}" IsVisible="{Binding !FilteredLogs.Count}" Padding="32">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10">
                            <LucideIcon Kind="ScrollText" Size="28" Foreground="{DynamicResource SubtleForeground}"
                                        HorizontalAlignment="Center" Margin="0,0,0,6"/>
                            <TextBlock Text="No activity yet" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"
                                       IsVisible="{Binding !TotalLogCount}"/>
                            <TextBlock Text="No matching entries" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"
                                       IsVisible="{Binding TotalLogCount}"/>
                            <TextBlock Text="Activity will appear as you use BusLane." Classes="caption" TextAlignment="Center" TextWrapping="Wrap"
                                       IsVisible="{Binding !TotalLogCount}"/>
                            <TextBlock Text="Try another search, level, or source. Enable Debug logs to include debug entries."
                                       Classes="caption" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="360"
                                       IsVisible="{Binding TotalLogCount}"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Grid.Row="4" Padding="20,14" Background="{DynamicResource SurfaceSubtle}"
                        BorderBrush="{DynamicResource BorderDefault}" BorderThickness="0,1,0,0">
                    <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="10">
                        <ToggleButton Classes="pill" IsChecked="{Binding IsAutoScrollEnabled}" ToolTip.Tip="Keep the newest entries in view">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <LucideIcon Kind="ArrowDownToLine" Size="16"/>
                                <TextBlock Text="Auto-scroll"/>
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton Grid.Column="1" Classes="pill" IsChecked="{Binding IsDebugModeEnabled}" ToolTip.Tip="Include debug entries">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <LucideIcon Kind="Bug" Size="16"/>
                                <TextBlock Text="Debug logs"/>
                            </StackPanel>
                        </ToggleButton>
                        <Button Grid.Column="3" Classes="danger-subtle" Command="{Binding ClearLogsCommand}"
                                IsEnabled="{Binding TotalLogCount}" ToolTip.Tip="Clear all logs, including hidden entries">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <LucideIcon Kind="Trash2" Size="16"/>
                                <TextBlock Text="Clear all"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
