<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:BusLane.ViewModels"
             xmlns:models="using:BusLane.Models"
             xmlns:converters="using:BusLane.Converters"
             x:Class="BusLane.Views.Controls.NavigationSidebar"
             x:DataType="vm:MainWindowViewModel"
             x:CompileBindings="False">

    <UserControl.Resources>
        <converters:EntitySelectionConverter x:Key="EntitySelectionConverter"/>
        <converters:EntitySelectionBackgroundConverter x:Key="EntitySelectionBackgroundConverter"/>
    </UserControl.Resources>

    <Border Classes="sidebar"
            Classes.collapsed="{Binding !IsNavigationPanelVisible}">
        <Grid>
        <Grid RowDefinitions="Auto,*,Auto"
              IsVisible="{Binding IsNavigationPanelVisible}">
            <Border Grid.Row="0" Classes="sidebar-header">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <Viewbox Width="28" Height="28">
                            <Canvas Width="512" Height="512">
                                <Path Data="M512.0,256.0 L511.5,331.6 L510.0,362.7 L507.6,386.2 L504.2,405.7 L499.7,422.4 L494.2,437.0 L487.7,449.9 L480.1,461.2 L471.3,471.3 L461.2,480.1 L449.9,487.7 L437.0,494.2 L422.4,499.7 L405.7,504.2 L386.2,507.6 L362.7,510.0 L331.6,511.5 L256.0,512.0 L180.4,511.5 L149.3,510.0 L125.8,507.6 L106.3,504.2 L89.6,499.7 L75.0,494.2 L62.1,487.7 L50.8,480.1 L40.7,471.3 L31.9,461.2 L24.3,449.9 L17.8,437.0 L12.3,422.4 L7.8,405.7 L4.4,386.2 L2.0,362.7 L0.5,331.6 L0.0,256.0 L0.5,180.4 L2.0,149.3 L4.4,125.8 L7.8,106.3 L12.3,89.6 L17.8,75.0 L24.3,62.1 L31.9,50.8 L40.7,40.7 L50.8,31.9 L62.1,24.3 L75.0,17.8 L89.6,12.3 L106.3,7.8 L125.8,4.4 L149.3,2.0 L180.4,0.5 L256.0,0.0 L331.6,0.5 L362.7,2.0 L386.2,4.4 L405.7,7.8 L422.4,12.3 L437.0,17.8 L449.9,24.3 L461.2,31.9 L471.3,40.7 L480.1,50.8 L487.7,62.1 L494.2,75.0 L499.7,89.6 L504.2,106.3 L507.6,125.8 L510.0,149.3 L511.5,180.4 Z" Fill="{DynamicResource BrandMarkTile}"/>
                                <Rectangle Canvas.Left="101.9" Canvas.Top="154.1" Width="114.3" Height="54.7" RadiusX="27.4" RadiusY="27.4" Fill="{DynamicResource BrandMarkBar}"/>
                                <Rectangle Canvas.Left="236.1" Canvas.Top="154.1" Width="174.0" Height="54.7" RadiusX="27.4" RadiusY="27.4" Fill="{DynamicResource BrandMarkBar}"/>
                                <Rectangle Canvas.Left="101.9" Canvas.Top="228.7" Width="308.2" Height="54.7" RadiusX="27.4" RadiusY="27.4" Fill="{DynamicResource AccentBrand}"/>
                                <Rectangle Canvas.Left="101.9" Canvas.Top="303.2" Width="233.6" Height="54.7" RadiusX="27.4" RadiusY="27.4" Fill="{DynamicResource BrandMarkBar}"/>
                                <Ellipse Canvas.Left="355.4" Canvas.Top="303.2" Width="54.7" Height="54.7" Fill="{DynamicResource BrandMarkBar}"/>
                            </Canvas>
                        </Viewbox>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="BusLane" Classes="heading"/>
                            <TextBlock Text="Service Bus workspace" Classes="caption" FontSize="11"/>
                        </StackPanel>
                    </StackPanel>

                    <Button Grid.Column="1"
                            Classes="panel-toggle"
                            Command="{Binding ToggleNavigationPanelCommand}"
                            ToolTip.Tip="Hide navigation panel"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Right"
                            Margin="12,0,0,0"
                            Padding="6">
                        <LucideIcon Kind="PanelLeftClose" Size="18"/>
                    </Button>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="12,16,12,16" Spacing="18">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Workspace" Classes="sidebar-section-label"/>

                        <Border Classes="sidebar-workspace-summary"
                                IsVisible="{Binding HasActiveConnectionTab}">
                            <StackPanel Spacing="10">
                                <Grid Classes="sidebar-workspace-header"
                                      ColumnDefinitions="*,Auto"
                                      ColumnSpacing="12">
                                    <StackPanel Grid.Column="0" Spacing="8">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Border Classes="badge-success-soft">
                                                <StackPanel Orientation="Horizontal" Spacing="5">
                                                    <Ellipse Width="7"
                                                             Height="7"
                                                             Fill="{DynamicResource TextSuccess}"
                                                             VerticalAlignment="Center"/>
                                                    <TextBlock Text="Connected"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Classes="badge-env"
                                                    IsVisible="{Binding ActiveTab.SavedConnection.HasEnvironment}">
                                                <TextBlock Text="{Binding ActiveTab.SavedConnection.EnvironmentDisplayName}"
                                                           FontWeight="SemiBold"/>
                                            </Border>
                                            <Border Classes="badge-info"
                                                    IsVisible="{Binding !ActiveTab.SavedConnection.HasEnvironment}">
                                                <TextBlock Text="{Binding ActiveWorkspaceModeLabel}"/>
                                            </Border>
                                        </StackPanel>

                                        <TextBlock Text="{Binding ActiveTab.TabTitle}"
                                                   Classes="body-strong"
                                                   TextTrimming="CharacterEllipsis"/>

                                        <TextBlock Text="{Binding ActiveTab.TabSubtitle}"
                                                   Classes="caption"
                                                   ToolTip.Tip="{Binding ActiveTab.TabSubtitle}"
                                                   TextTrimming="CharacterEllipsis"
                                                   IsVisible="{Binding ActiveTab.TabSubtitle, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                    </StackPanel>

                                    <Border Grid.Column="1"
                                            Width="36"
                                            Height="36"
                                            CornerRadius="{StaticResource RadiusMedium}"
                                            Background="{DynamicResource SurfaceBrand}"
                                            HorizontalAlignment="Right">
                                        <LucideIcon Kind="Waypoints"
                                                    Size="18"
                                                    Foreground="{DynamicResource AccentBrand}"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>

                                <Border Classes="badge-danger-soft"
                                        HorizontalAlignment="Left"
                                        IsVisible="{Binding CurrentNavigation.HasDeadLetters}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <LucideIcon Kind="Inbox" Size="12"
                                                    Foreground="{DynamicResource TextDanger}"/>
                                        <TextBlock Text="{Binding CurrentNavigation.TotalDeadLetterCount, StringFormat='{}{0} dead letters'}"/>
                                    </StackPanel>
                                </Border>

                                <Grid Classes="sidebar-workspace-actions"
                                      ColumnDefinitions="*,Auto,Auto"
                                      ColumnSpacing="6">
                                    <Button Grid.Column="0"
                                            Classes="secondary small sidebar-refresh-action"
                                            Command="{Binding RefreshCommand}"
                                            ToolTip.Tip="Refresh workspace"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <LucideIcon Kind="RefreshCw" Size="14"/>
                                            <TextBlock Text="Refresh" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

                                    <Button Grid.Column="1"
                                            Classes="icon-button sidebar-secondary-action"
                                            Command="{Binding OpenNamespacePanelCommand}"
                                            ToolTip.Tip="Change namespace"
                                            IsVisible="{Binding IsActiveTabAzureMode}">
                                        <LucideIcon Kind="ArrowLeftRight" Size="14"/>
                                    </Button>

                                    <Button Grid.Column="2"
                                            Classes="danger-subtle small sidebar-disconnect-action"
                                            Command="{Binding DisconnectConnectionCommand}"
                                            ToolTip.Tip="Disconnect workspace"
                                            Padding="8">
                                        <LucideIcon Kind="PlugZap" Size="14"/>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Classes="card"
                                IsVisible="{Binding ShowNamespaceSelectionPrompt}">
                            <StackPanel Spacing="12">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Border Width="40" Height="40" CornerRadius="{StaticResource RadiusMedium}" Background="{DynamicResource SurfaceBrand}">
                                        <LucideIcon Kind="Server"
                                                    Size="18"
                                                    Foreground="{DynamicResource AccentBrand}"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Choose a namespace" FontWeight="SemiBold" FontSize="13"/>
                                        <TextBlock Text="Pick the Azure workspace you want to browse."
                                                   Classes="caption"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </StackPanel>

                                <Button Classes="primary"
                                        Command="{Binding OpenNamespacePanelCommand}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <LucideIcon Kind="Server" Size="16"/>
                                        <TextBlock Text="Select Namespace" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>

                        <Button Classes="secondary"
                                Command="{Binding LogoutCommand}"
                                IsVisible="{Binding Connection.IsAuthenticated}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <LucideIcon Kind="LogOut" Size="16"/>
                                <TextBlock Text="Sign Out"/>
                            </StackPanel>
                        </Button>

                        <Border Classes="empty-state">
                            <Border.IsVisible>
                                <MultiBinding Converter="{x:Static BoolConverters.And}">
                                    <Binding Path="!Connection.ShowAzureSections"/>
                                    <Binding Path="!HasActiveConnectionTab"/>
                                </MultiBinding>
                            </Border.IsVisible>
                            <StackPanel Spacing="14">
                                <StackPanel HorizontalAlignment="Center" Spacing="8">
                                    <LucideIcon Kind="Rocket" Size="28"
                                                HorizontalAlignment="Center"
                                                Foreground="{DynamicResource AccentBrand}"/>
                                    <TextBlock Text="Start a workspace"
                                               FontWeight="SemiBold"
                                               FontSize="16"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="Open a saved connection or sign in to Azure to start browsing queues and topics."
                                               Classes="caption"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap"/>
                                </StackPanel>

                                <Button Classes="secondary"
                                        Command="{Binding LoginCommand}"
                                        IsVisible="{Binding !Connection.IsAuthenticated}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <LucideIcon Kind="Cloud" Size="16"/>
                                        <TextBlock Text="Sign in with Azure"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Spacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="Quick switch" Classes="sidebar-section-label"/>
                            <Border Grid.Column="1"
                                    Classes="badge-muted"
                                    VerticalAlignment="Center"
                                    IsVisible="{Binding Connection.HasFavoriteConnections}">
                                <TextBlock Text="{Binding Connection.FavoriteConnections.Count}"/>
                            </Border>
                        </Grid>

                        <Button Classes="secondary"
                                Command="{Binding OpenConnectionLibraryCommand}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                <Border Grid.Column="0"
                                        Width="32"
                                        Height="32"
                                        CornerRadius="{StaticResource RadiusMedium}"
                                        Background="{DynamicResource SurfaceBrand}">
                                    <LucideIcon Kind="Library"
                                                Size="14"
                                                Foreground="{DynamicResource AccentBrand}"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="My Connections" FontWeight="SemiBold"/>
                                    <TextBlock Text="Saved connections"
                                               Classes="caption"
                                               FontSize="11"/>
                                </StackPanel>
                                <LucideIcon Grid.Column="2"
                                            Kind="ChevronRight"
                                            Size="14"
                                            Foreground="{DynamicResource SubtleForeground}"
                                            VerticalAlignment="Center"/>
                            </Grid>
                        </Button>

                        <ListBox ItemsSource="{Binding Connection.FavoriteConnections}"
                                 Classes="entity-list quick-switch-list"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 IsVisible="{Binding Connection.HasFavoriteConnections}">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="models:SavedConnection">
                                    <Button Classes="subtle sidebar-quick-switch-button"
                                            Command="{Binding $parent[Window].DataContext.ConnectToSavedConnectionCommand}"
                                            CommandParameter="{Binding}"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Stretch"
                                            Padding="0"
                                            Margin="0">
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                            <Border Grid.Column="0"
                                                    Classes="selection-indicator"
                                                    VerticalAlignment="Stretch"
                                                    Margin="0,6,0,6">
                                                <Border.IsVisible>
                                                    <MultiBinding Converter="{StaticResource EntitySelectionConverter}">
                                                        <Binding Path="."/>
                                                        <Binding Path="$parent[Window].DataContext.ActiveTab.SavedConnection"/>
                                                    </MultiBinding>
                                                </Border.IsVisible>
                                            </Border>

                                            <Border Grid.Column="1"
                                                    Classes="sidebar-quick-switch-item">
                                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                                    <Border Grid.Column="0"
                                                            Width="30"
                                                            Height="30"
                                                            CornerRadius="{StaticResource RadiusMedium}"
                                                            Background="{DynamicResource SurfaceBrand}">
                                                        <LucideIcon Kind="Cable"
                                                                    Size="13"
                                                                    Foreground="{DynamicResource AccentBrand}"
                                                                    HorizontalAlignment="Center"
                                                                    VerticalAlignment="Center"/>
                                                    </Border>

                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                        <TextBlock Text="{Binding Name}"
                                                                   FontWeight="SemiBold"
                                                                   FontSize="12"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <TextBlock Text="{Binding TypeDisplayName}"
                                                                       Classes="caption"
                                                                       FontSize="11"/>
                                                            <TextBlock Text="·"
                                                                       Classes="caption"
                                                                       FontSize="11"
                                                                       IsVisible="{Binding EntityName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                                            <TextBlock Text="{Binding EntityName}"
                                                                       Classes="caption"
                                                                       FontSize="11"
                                                                       MaxWidth="120"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       IsVisible="{Binding EntityName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                                        </StackPanel>
                                                    </StackPanel>

                                                    <Border Grid.Column="2"
                                                            Classes="badge-env"
                                                            VerticalAlignment="Center"
                                                            IsVisible="{Binding HasEnvironment}">
                                                        <TextBlock Text="{Binding EnvironmentDisplayName}"
                                                                   FontWeight="SemiBold"/>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Border Classes="sidebar-hint-card"
                                IsVisible="{Binding !Connection.HasFavoriteConnections}">
                            <TextBlock Text="Favorite connections will appear here for one-click switching."
                                       Classes="caption"
                                       TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" Classes="sidebar-utility-dock">
                <StackPanel Margin="12,10,12,12" Spacing="4">
                    <!-- More Tools Panel -->
                    <Border Classes="sidebar-more-tools-panel"
                            IsVisible="{Binding IsMoreToolsExpanded}">
                        <StackPanel Spacing="2">
                            <Button Classes="subtle sidebar-utility-button"
                                    Command="{Binding OpenLiveStreamCommand}"
                                    HorizontalAlignment="Stretch">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <LucideIcon Kind="Radio" Size="16"/>
                                    <TextBlock Text="Live Stream" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button Classes="subtle sidebar-utility-button"
                                    Command="{Binding OpenCorrelationExplorerCommand}"
                                    HorizontalAlignment="Stretch">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <LucideIcon Kind="GitBranch" Size="16"/>
                                    <TextBlock Text="Correlation Explorer" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button Classes="subtle sidebar-utility-button"
                                    Command="{Binding OpenScheduledMessagesCommand}"
                                    HorizontalAlignment="Stretch">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <LucideIcon Kind="CalendarClock" Size="16"/>
                                    <TextBlock Text="Scheduled Messages" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                    <!-- /More Tools Panel -->

                    <ToggleButton Classes="subtle sidebar-more-tools-toggle"
                                  IsChecked="{Binding IsMoreToolsExpanded, Mode=TwoWay}"
                                  AutomationProperties.Name="More tools"
                                  HorizontalAlignment="Stretch">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                            <LucideIcon Grid.Column="0" Kind="LayoutGrid" Size="16"/>
                            <TextBlock Grid.Column="1" Text="More tools" VerticalAlignment="Center"/>
                            <LucideIcon Grid.Column="2"
                                        Kind="ChevronDown"
                                        Size="16"
                                        IsVisible="{Binding !IsMoreToolsExpanded}"/>
                            <LucideIcon Grid.Column="2"
                                        Kind="ChevronUp"
                                        Size="16"
                                        IsVisible="{Binding IsMoreToolsExpanded}"/>
                        </Grid>
                    </ToggleButton>

                    <Border Classes="sidebar-utility-divider"/>

                    <Button Classes="subtle sidebar-utility-button"
                            Command="{Binding OpenOverviewCommand}"
                            IsVisible="{Binding HasActiveConnectionTab}"
                            HorizontalAlignment="Stretch">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <LucideIcon Kind="ChartBar" Size="16"/>
                            <TextBlock Text="Overview" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Classes="subtle sidebar-utility-button"
                            Command="{Binding OpenAlertsCommand}"
                            HorizontalAlignment="Stretch">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10">
                                <LucideIcon Kind="Bell" Size="16"/>
                                <TextBlock Text="Alerts" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Border Grid.Column="2"
                                    Background="{DynamicResource DangerBackground}"
                                    CornerRadius="{StaticResource RadiusMedium}"
                                    Padding="8,2"
                                    IsVisible="{Binding FeaturePanels.ActiveAlertCount}"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding FeaturePanels.ActiveAlertCount}"
                                           FontSize="11"
                                           Foreground="White"
                                           FontWeight="SemiBold"/>
                            </Border>
                        </Grid>
                    </Button>

                    <Button Classes="subtle sidebar-utility-button"
                            Command="{Binding OpenSettingsCommand}"
                            HorizontalAlignment="Stretch">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <LucideIcon Kind="Settings" Size="16"/>
                            <TextBlock Text="Settings" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
        <Grid RowDefinitions="Auto,*,Auto"
              Classes="sidebar-rail"
              IsVisible="{Binding !IsNavigationPanelVisible}">
            <StackPanel Grid.Row="0" Spacing="12" HorizontalAlignment="Center" Margin="0,14">
                <Viewbox Width="28" Height="28">
                    <Canvas Width="512" Height="512">
                        <Path Data="M512.0,256.0 L511.5,331.6 L510.0,362.7 L507.6,386.2 L504.2,405.7 L499.7,422.4 L494.2,437.0 L487.7,449.9 L480.1,461.2 L471.3,471.3 L461.2,480.1 L449.9,487.7 L437.0,494.2 L422.4,499.7 L405.7,504.2 L386.2,507.6 L362.7,510.0 L331.6,511.5 L256.0,512.0 L180.4,511.5 L149.3,510.0 L125.8,507.6 L106.3,504.2 L89.6,499.7 L75.0,494.2 L62.1,487.7 L50.8,480.1 L40.7,471.3 L31.9,461.2 L24.3,449.9 L17.8,437.0 L12.3,422.4 L7.8,405.7 L4.4,386.2 L2.0,362.7 L0.5,331.6 L0.0,256.0 L0.5,180.4 L2.0,149.3 L4.4,125.8 L7.8,106.3 L12.3,89.6 L17.8,75.0 L24.3,62.1 L31.9,50.8 L40.7,40.7 L50.8,31.9 L62.1,24.3 L75.0,17.8 L89.6,12.3 L106.3,7.8 L125.8,4.4 L149.3,2.0 L180.4,0.5 L256.0,0.0 L331.6,0.5 L362.7,2.0 L386.2,4.4 L405.7,7.8 L422.4,12.3 L437.0,17.8 L449.9,24.3 L461.2,31.9 L471.3,40.7 L480.1,50.8 L487.7,62.1 L494.2,75.0 L499.7,89.6 L504.2,106.3 L507.6,125.8 L510.0,149.3 L511.5,180.4 Z" Fill="{DynamicResource BrandMarkTile}"/>
                        <Rectangle Canvas.Left="101.9" Canvas.Top="154.1" Width="114.3" Height="54.7" RadiusX="27.4" RadiusY="27.4" Fill="{DynamicResource BrandMarkBar}"/>
                        <Rectangle Canvas.Left="236.1" Canvas.Top="154.1" Width="174.0" Height="54.7" RadiusX="27.4" RadiusY="27.4" Fill="{DynamicResource BrandMarkBar}"/>
                        <Rectangle Canvas.Left="101.9" Canvas.Top="228.7" Width="308.2" Height="54.7" RadiusX="27.4" RadiusY="27.4" Fill="{DynamicResource AccentBrand}"/>
                        <Rectangle Canvas.Left="101.9" Canvas.Top="303.2" Width="233.6" Height="54.7" RadiusX="27.4" RadiusY="27.4" Fill="{DynamicResource BrandMarkBar}"/>
                        <Ellipse Canvas.Left="355.4" Canvas.Top="303.2" Width="54.7" Height="54.7" Fill="{DynamicResource BrandMarkBar}"/>
                    </Canvas>
                </Viewbox>
                <Button Classes="entity-pane-restore-command"
                        Command="{Binding ToggleNavigationPanelCommand}"
                        ToolTip.Tip="Expand navigation">
                    <LucideIcon Kind="PanelLeftOpen" Size="18"/>
                </Button>
            </StackPanel>

            <StackPanel Grid.Row="1" Spacing="8" HorizontalAlignment="Center" Margin="0,10">
                <Button Classes="subtle icon-button"
                        Command="{Binding OpenConnectionLibraryCommand}"
                        ToolTip.Tip="My Connections">
                    <LucideIcon Kind="Library" Size="17"/>
                </Button>
                <Button Classes="subtle icon-button"
                        Command="{Binding RefreshCommand}"
                        IsVisible="{Binding HasActiveConnectionTab}"
                        ToolTip.Tip="Refresh workspace">
                    <LucideIcon Kind="RefreshCw" Size="17"/>
                </Button>
                <Button Classes="subtle icon-button"
                        Command="{Binding OpenLiveStreamCommand}"
                        ToolTip.Tip="Live Stream">
                    <LucideIcon Kind="Radio" Size="17"/>
                </Button>
                <Button Classes="subtle icon-button"
                        Command="{Binding OpenCorrelationExplorerCommand}"
                        ToolTip.Tip="Correlation Explorer">
                    <LucideIcon Kind="GitBranch" Size="17"/>
                </Button>
                <Button Classes="subtle icon-button"
                        Command="{Binding OpenScheduledMessagesCommand}"
                        ToolTip.Tip="Scheduled Messages">
                    <LucideIcon Kind="CalendarClock" Size="17"/>
                </Button>
                <Button Classes="subtle icon-button"
                        Command="{Binding OpenOverviewCommand}"
                        IsVisible="{Binding HasActiveConnectionTab}"
                        ToolTip.Tip="Overview">
                    <LucideIcon Kind="ChartBar" Size="17"/>
                </Button>
                <Button Classes="subtle icon-button"
                        Command="{Binding OpenAlertsCommand}"
                        ToolTip.Tip="Alerts">
                    <Grid>
                        <LucideIcon Kind="Bell" Size="17"/>
                        <Border Width="8"
                                Height="8"
                                CornerRadius="{StaticResource RadiusSmall}"
                                Background="{DynamicResource TextDanger}"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                IsVisible="{Binding FeaturePanels.ActiveAlertCount}"/>
                    </Grid>
                </Button>
            </StackPanel>

            <StackPanel Grid.Row="2" Spacing="8" HorizontalAlignment="Center" Margin="0,10,0,12">
                <Button Classes="subtle icon-button"
                        Command="{Binding OpenSettingsCommand}"
                        ToolTip.Tip="Settings">
                    <LucideIcon Kind="Settings" Size="17"/>
                </Button>
            </StackPanel>
        </Grid>
        </Grid>
    </Border>
</UserControl>
