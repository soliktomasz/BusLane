<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="using:BusLane.Models"
             xmlns:dialogs="using:BusLane.Views.Dialogs"
             x:Class="BusLane.Views.Controls.CorrelationExplorerView"
             x:CompileBindings="False">
    <Grid>
        <Grid RowDefinitions="Auto,Auto,*">
            <Border Grid.Row="0"
                    Classes="page-header-surface"
                    Margin="0,0,0,16">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Correlation Explorer" Classes="heading"/>
                        <TextBlock Text="Trace related loaded and streamed messages, then replay one safely."
                                   Classes="caption"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <Button Classes="secondary small"
                                Content="Filters"
                                Command="{Binding ToggleFiltersCommand}"/>
                        <Button Classes="secondary small"
                                Content="Refresh"
                                Command="{Binding RefreshCommand}"/>
                        <Button Classes="secondary small"
                                Content="Export replay history"
                                Command="{Binding ExportHistoryCommand}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="1"
                    Classes="pane-card"
                    Padding="12"
                    Margin="0,0,0,12"
                    IsVisible="{Binding ShowFilters}">
                <StackPanel Spacing="10">
                    <WrapPanel Orientation="Horizontal">
                        <StackPanel Width="190" Margin="0,0,8,8">
                            <TextBlock Text="Search" Classes="caption"/>
                            <TextBox Text="{Binding FilterText}" PlaceholderText="ID, body, property..."/>
                        </StackPanel>
                        <StackPanel Width="190" Margin="0,0,8,8">
                            <TextBlock Text="From (ISO 8601)" Classes="caption"/>
                            <TextBox Text="{Binding FilterFromText}" PlaceholderText="2026-07-28T09:00:00Z"/>
                        </StackPanel>
                        <StackPanel Width="190" Margin="0,0,8,8">
                            <TextBlock Text="To (ISO 8601)" Classes="caption"/>
                            <TextBox Text="{Binding FilterToText}" PlaceholderText="2026-07-28T10:00:00Z"/>
                        </StackPanel>
                        <StackPanel Width="190" Margin="0,0,8,8">
                            <TextBlock Text="Namespace" Classes="caption"/>
                            <TextBox Text="{Binding FilterNamespace}"/>
                        </StackPanel>
                        <StackPanel Width="190" Margin="0,0,8,8">
                            <TextBlock Text="Entity" Classes="caption"/>
                            <TextBox Text="{Binding FilterEntity}"/>
                        </StackPanel>
                        <StackPanel Width="150" Margin="0,0,8,8">
                            <TextBlock Text="Environment" Classes="caption"/>
                            <ComboBox ItemsSource="{Binding FilterEnvironmentOptions}"
                                      SelectedItem="{Binding FilterEnvironment}"
                                      PlaceholderText="Any"/>
                        </StackPanel>
                        <StackPanel Width="150" Margin="0,0,8,8">
                            <TextBlock Text="Source" Classes="caption"/>
                            <ComboBox ItemsSource="{Binding FilterSourceOptions}"
                                      SelectedItem="{Binding FilterSource}"
                                      PlaceholderText="Any"/>
                        </StackPanel>
                        <StackPanel Width="190" Margin="0,0,8,8">
                            <TextBlock Text="Correlation or session ID" Classes="caption"/>
                            <TextBox Text="{Binding FilterIdentifier}"/>
                        </StackPanel>
                        <StackPanel Width="170" Margin="0,0,8,8">
                            <TextBlock Text="Property key" Classes="caption"/>
                            <TextBox Text="{Binding FilterPropertyKey}"/>
                        </StackPanel>
                        <StackPanel Width="170" Margin="0,0,8,8">
                            <TextBlock Text="Property value" Classes="caption"/>
                            <TextBox Text="{Binding FilterPropertyValue}"/>
                        </StackPanel>
                    </WrapPanel>
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                        <TextBlock Text="{Binding FilterValidationMessage}"
                                   Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                   VerticalAlignment="Center"/>
                        <Button Grid.Column="1"
                                Classes="secondary small"
                                Content="Clear filters"
                                Command="{Binding ClearFiltersCommand}"/>
                        <Button Grid.Column="2"
                                Classes="primary small"
                                Content="Apply filters"
                                Command="{Binding ApplyFiltersCommand}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Grid Grid.Row="2" ColumnDefinitions="280,320,*" ColumnSpacing="12">
                <Border Grid.Column="0" Classes="pane-card" Padding="12">
                    <Grid RowDefinitions="Auto,*">
                        <TextBlock Grid.Row="0" Text="Correlations" Classes="title-small" Margin="4,0,0,10"/>
                        <ListBox Grid.Row="1"
                                 ItemsSource="{Binding Groups}"
                                 SelectedItem="{Binding SelectedGroup}">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="models:CorrelationGroup">
                                    <StackPanel Margin="6" Spacing="3">
                                        <TextBlock Text="{Binding DisplayId}"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Messages.Count, StringFormat='{}{0} messages'}"
                                                   Classes="caption"/>
                                        <TextBlock Text="Session fallback"
                                                   Classes="caption"
                                                   IsVisible="{Binding UsesSessionFallback}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <Border Grid.Column="1" Classes="pane-card" Padding="12">
                    <Grid RowDefinitions="Auto,*">
                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="4,0,0,10">
                            <TextBlock Text="Timeline" Classes="title-small"/>
                            <Button Grid.Column="1"
                                    Classes="secondary small"
                                    IsVisible="{Binding HasNewMessages}"
                                    Content="{Binding NewMessageCount, StringFormat='{}{0} new'}"
                                    Command="{Binding AcknowledgeNewMessagesCommand}"/>
                        </Grid>
                        <ListBox Grid.Row="1"
                                 ItemsSource="{Binding Timeline}"
                                 SelectedItem="{Binding SelectedMessage}">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="models:CorrelationMessage">
                                    <StackPanel Margin="6" Spacing="3">
                                        <TextBlock Text="{Binding EnqueuedTime, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss.fff}'}"
                                                   Classes="caption"/>
                                        <TextBlock Text="{Binding EntityName}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding MessageId}"
                                                   Classes="caption"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="{Binding Source}" Classes="caption"/>
                                            <TextBlock Text="{Binding EntityType}" Classes="caption"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Button Classes="secondary small"
                                                    Content="Set A"
                                                    Command="{Binding $parent[UserControl].DataContext.SetComparisonACommand}"
                                                    CommandParameter="{Binding}"/>
                                            <Button Classes="secondary small"
                                                    Content="Set B"
                                                    Command="{Binding $parent[UserControl].DataContext.SetComparisonBCommand}"
                                                    CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Classes="pane-card" Padding="16">
                    <Grid RowDefinitions="Auto,*">
                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="{Binding SelectedMessage.MessageId}" Classes="title-small"/>
                                <TextBlock Text="{Binding SelectedMessage.NamespaceName}" Classes="caption"/>
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Classes="secondary"
                                    Content="Compare with previous"
                                    Command="{Binding CompareWithPreviousCommand}"/>
                            <Button Grid.Column="2"
                                    Classes="primary"
                                    Content="Replay selected message"
                                    Command="{Binding OpenReplayCommand}"/>
                        </Grid>
                        <TabControl Grid.Row="1">
                            <TabItem Header="Payload">
                                <TextBox Text="{Binding SelectedMessage.Body}"
                                         Classes="code-editor"
                                         IsReadOnly="True"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"/>
                            </TabItem>
                            <TabItem Header="Metadata">
                                <ScrollViewer>
                                    <StackPanel Spacing="8" Margin="8">
                                        <TextBlock Text="{Binding SelectedMessage.CorrelationId, StringFormat='Correlation: {0}'}"/>
                                        <TextBlock Text="{Binding SelectedMessage.SessionId, StringFormat='Session: {0}'}"/>
                                        <TextBlock Text="{Binding SelectedMessage.EntityName, StringFormat='Entity: {0}'}"/>
                                        <TextBlock Text="{Binding SelectedMessage.ContentType, StringFormat='Content type: {0}'}"/>
                                        <TextBlock Text="{Binding SelectedMessage.SequenceNumber, StringFormat='Sequence: {0}'}"/>
                                    </StackPanel>
                                </ScrollViewer>
                            </TabItem>
                            <TabItem Header="Application properties">
                                <ItemsControl ItemsSource="{Binding SelectedMessage.Properties}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnDefinitions="180,*" Margin="8,4">
                                                <TextBlock Text="{Binding Key}" FontWeight="SemiBold"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </TabItem>
                            <TabItem Header="Compare">
                                <ScrollViewer>
                                    <StackPanel Spacing="12" Margin="8">
                                        <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="10">
                                            <StackPanel>
                                                <TextBlock Text="Message A" Classes="caption"/>
                                                <TextBlock Text="{Binding ComparisonMessageA.MessageId}"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="→" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Message B" Classes="caption"/>
                                                <TextBlock Text="{Binding ComparisonMessageB.MessageId}"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </Grid>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{Binding Comparison.EnqueueTimeDelta, StringFormat='Enqueue delta: {0}'}"/>
                                            <Button Classes="secondary small"
                                                    Content="Clear comparison"
                                                    Command="{Binding ClearComparisonCommand}"/>
                                        </StackPanel>
                                        <TextBlock Text="Changed metadata" Classes="title-small"/>
                                        <ItemsControl ItemsSource="{Binding Comparison.FieldChanges}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="models:MessageFieldChange">
                                                    <Grid ColumnDefinitions="150,*,*" ColumnSpacing="8" Margin="0,3">
                                                        <TextBlock Text="{Binding Field}" FontWeight="SemiBold"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding FirstValue}" TextWrapping="Wrap"/>
                                                        <TextBlock Grid.Column="2" Text="{Binding SecondValue}" TextWrapping="Wrap"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="Application properties" Classes="title-small"/>
                                        <ItemsControl ItemsSource="{Binding Comparison.PropertyChanges}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="models:MessagePropertyChange">
                                                    <Grid ColumnDefinitions="130,100,*,*" ColumnSpacing="8" Margin="0,3">
                                                        <TextBlock Text="{Binding Key}" FontWeight="SemiBold"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding Kind}"/>
                                                        <TextBlock Grid.Column="2" Text="{Binding FirstValue}" TextWrapping="Wrap"/>
                                                        <TextBlock Grid.Column="3" Text="{Binding SecondValue}" TextWrapping="Wrap"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="Body comparison" Classes="title-small"/>
                                        <WrapPanel Orientation="Horizontal">
                                            <TextBox Width="360"
                                                     MinHeight="180"
                                                     Margin="0,0,8,8"
                                                     Text="{Binding Comparison.Body.First}"
                                                     Classes="code-editor"
                                                     IsReadOnly="True"
                                                     AcceptsReturn="True"
                                                     TextWrapping="Wrap"/>
                                            <TextBox Width="360"
                                                     MinHeight="180"
                                                     Text="{Binding Comparison.Body.Second}"
                                                     Classes="code-editor"
                                                     IsReadOnly="True"
                                                     AcceptsReturn="True"
                                                     TextWrapping="Wrap"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </ScrollViewer>
                            </TabItem>
                            <TabItem Header="Replay history">
                                <ListBox ItemsSource="{Binding ReplayHistory}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="models:ReplayAuditEntry">
                                            <Grid ColumnDefinitions="150,110,*,Auto" Margin="6">
                                                <TextBlock Text="{Binding Timestamp, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Outcome}"/>
                                                <TextBlock Grid.Column="2" Text="{Binding DestinationEntity}"/>
                                                <TextBlock Grid.Column="3" Text="{Binding ResultMessage}" TextTrimming="CharacterEllipsis"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </TabItem>
                        </TabControl>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <dialogs:ReplayMessageDialog IsVisible="{Binding ShowReplayEditor}"/>
    </Grid>
</UserControl>
