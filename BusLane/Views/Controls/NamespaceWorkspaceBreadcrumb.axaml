<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:BusLane.ViewModels"
             x:Class="BusLane.Views.Controls.NamespaceWorkspaceBreadcrumb"
             x:DataType="vm:MainWindowViewModel"
             x:CompileBindings="False">
    <Border Padding="16,10"
            BorderBrush="{DynamicResource BorderDefault}"
            BorderThickness="0,0,0,1">
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Button Classes="subtle small"
                    Command="{Binding BackToOverviewCommand}"
                    AutomationProperties.Name="Back to namespace overview">
                <TextBlock Text="Overview"/>
            </Button>
            <TextBlock Text="/" Classes="caption" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding WorkspaceTopicName}"
                       Classes="caption"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       ToolTip.Tip="{Binding WorkspaceTopicName}"
                       IsVisible="{Binding WorkspaceTopicName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
            <TextBlock Text="/"
                       Classes="caption"
                       VerticalAlignment="Center"
                       IsVisible="{Binding WorkspaceTopicName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
            <TextBlock Text="{Binding WorkspaceEntityName}"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       ToolTip.Tip="{Binding WorkspaceEntityName}"/>
            <TextBlock Text="/" Classes="caption" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding WorkspaceDestinationLabel}"
                       Classes="caption"
                       VerticalAlignment="Center"/>
        </StackPanel>
    </Border>
</UserControl>
