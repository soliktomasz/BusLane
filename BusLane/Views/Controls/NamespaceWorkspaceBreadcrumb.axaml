<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:BusLane.ViewModels"
             x:Class="BusLane.Views.Controls.NamespaceWorkspaceBreadcrumb"
             x:DataType="vm:MainWindowViewModel"
             x:CompileBindings="False">
    <Border>
        <!-- One line that trims from the end instead of wrapping under the title. -->
        <DockPanel VerticalAlignment="Center">
            <DockPanel.Styles>
                <Style Selector="TextBlock">
                    <Setter Property="FontSize" Value="11"/>
                    <Setter Property="Foreground" Value="{DynamicResource SubtleForeground}"/>
                    <Setter Property="Margin" Value="0,0,6,0"/>
                </Style>
            </DockPanel.Styles>
            <TextBlock DockPanel.Dock="Left"
                       Text="Entity Explorer"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"/>
            <TextBlock DockPanel.Dock="Left" Text="/" Classes="caption" VerticalAlignment="Center"
                       IsVisible="{Binding WorkspaceEntityName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
            <TextBlock DockPanel.Dock="Left"
                       Text="{Binding WorkspaceTopicName}"
                       Classes="caption"
                       MaxWidth="160"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       ToolTip.Tip="{Binding WorkspaceTopicName}"
                       IsVisible="{Binding WorkspaceTopicName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
            <TextBlock DockPanel.Dock="Left"
                       Text="/"
                       Classes="caption"
                       VerticalAlignment="Center"
                       IsVisible="{Binding WorkspaceTopicName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
            <TextBlock Text="{Binding WorkspaceDestinationLabel}"
                       Classes="caption"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       ToolTip.Tip="{Binding WorkspaceDestinationLabel}"
                       IsVisible="{Binding WorkspaceDestinationLabel, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
        </DockPanel>
    </Border>
</UserControl>
