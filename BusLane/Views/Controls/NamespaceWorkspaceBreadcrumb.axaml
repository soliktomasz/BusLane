<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:BusLane.ViewModels"
             x:Class="BusLane.Views.Controls.NamespaceWorkspaceBreadcrumb"
             x:DataType="vm:MainWindowViewModel"
             x:CompileBindings="False">
    <Border>
        <!-- Entity kind, optional topic, then namespace: one line that trims instead of wrapping. -->
        <DockPanel VerticalAlignment="Center">
            <DockPanel.Styles>
                <Style Selector="TextBlock">
                    <Setter Property="FontSize" Value="13"/>
                    <Setter Property="Foreground" Value="{DynamicResource SubtleForeground}"/>
                    <Setter Property="VerticalAlignment" Value="Center"/>
                </Style>
                <Style Selector="TextBlock.separator">
                    <Setter Property="Margin" Value="6,0"/>
                </Style>
            </DockPanel.Styles>
            <TextBlock DockPanel.Dock="Left"
                       Text="{Binding WorkspaceEntityKindLabel}"
                       IsVisible="{Binding WorkspaceEntityKindLabel, Converter={x:Static ObjectConverters.IsNotNull}}"/>
            <TextBlock DockPanel.Dock="Left" Text="/" Classes="separator"
                       IsVisible="{Binding WorkspaceTopicName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
            <TextBlock DockPanel.Dock="Left"
                       Text="{Binding WorkspaceTopicName}"
                       MaxWidth="160"
                       TextTrimming="CharacterEllipsis"
                       ToolTip.Tip="{Binding WorkspaceTopicName}"
                       IsVisible="{Binding WorkspaceTopicName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
            <TextBlock DockPanel.Dock="Left" Text="/" Classes="separator"
                       IsVisible="{Binding WorkspaceEntityKindLabel, Converter={x:Static ObjectConverters.IsNotNull}}"/>
            <TextBlock Text="{Binding ActiveTab.TabTitle}"
                       TextTrimming="CharacterEllipsis"
                       ToolTip.Tip="{Binding ActiveTab.TabTitle}"/>
        </DockPanel>
    </Border>
</UserControl>
