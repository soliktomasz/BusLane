<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:BusLane.ViewModels.Dashboard"
             xmlns:models="using:BusLane.Models.Dashboard"
             xmlns:controls="using:BusLane.Views.Controls"
             x:Class="BusLane.Views.Controls.NamespaceEntitySearchView"
             x:DataType="vm:NamespaceEntitySearchViewModel"
             x:CompileBindings="False">
    <Grid RowDefinitions="Auto,Auto">
        <TextBox x:Name="SearchBox"
                 Grid.Row="0"
                 Classes="message-header-search"
                 Text="{Binding Query, Mode=TwoWay}"
                 PlaceholderText="Find a queue, topic, or subscription"
                 AutomationProperties.Name="Search queues, topics, and subscriptions"
                 ToolTip.Tip="Press Cmd/Ctrl+F to search"
                 KeyDown="OnSearchKeyDown">
            <TextBox.InnerLeftContent>
                <LucideIcon Kind="Search" Size="14" Margin="10,0,2,0"
                            Foreground="{DynamicResource SubtleForeground}"
                            VerticalAlignment="Center"/>
            </TextBox.InnerLeftContent>
        </TextBox>
        <Border Grid.Row="1"
                Margin="0,6,0,0"
                Classes="overview-panel"
                Padding="6"
                IsVisible="{Binding HasResults}">
            <ListBox ItemsSource="{Binding Results}"
                     SelectedItem="{Binding SelectedResult, Mode=TwoWay}"
                     Background="Transparent"
                     MaxHeight="280">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="models:NamespaceEntitySearchResult">
                        <Button Classes="menu-item"
                                Command="{Binding $parent[UserControl].DataContext.OpenResultCommand}"
                                CommandParameter="{Binding}">
                            <controls:OverviewDestinationRow/>
                        </Button>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </Grid>
</UserControl>
