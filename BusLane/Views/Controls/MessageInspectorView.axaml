<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:BusLane.ViewModels"
             xmlns:controls="using:BusLane.Views.Controls"
             x:Class="BusLane.Views.Controls.MessageInspectorView"
             x:DataType="vm:MainWindowViewModel"
             x:CompileBindings="False">
    <UserControl.Styles>
        <Style Selector="Border.inspector-header">
            <Setter Property="Padding" Value="18,16"/>
        </Style>
        <Style Selector="StackPanel.inspector-heading">
            <Setter Property="Spacing" Value="8"/>
        </Style>
        <Style Selector="TextBlock.inspector-subject">
            <Setter Property="IsVisible" Value="{Binding CurrentMessageOps.SelectedMessage.Subject, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
        </Style>
        <Style Selector="UserControl.compact Border.inspector-header">
            <Setter Property="Padding" Value="12,4"/>
        </Style>
        <Style Selector="UserControl.compact TextBlock.inspector-subject, UserControl.compact SelectableTextBlock.inspector-id, UserControl.compact StackPanel.inspector-peek, UserControl.compact Border.inspector-summary">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <Style Selector="UserControl.compact StackPanel.inspector-heading">
            <Setter Property="Spacing" Value="0"/>
        </Style>
    </UserControl.Styles>
    <Border Background="{DynamicResource CardBackground}">
        <Grid>
            <StackPanel Spacing="10" Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center"
                        IsVisible="{Binding CurrentMessageOps.SelectedMessage, Converter={x:Static ObjectConverters.IsNull}}">
                <LucideIcon Kind="PanelRight" Size="28" Foreground="{DynamicResource AccentBrand}" HorizontalAlignment="Center"/>
                <TextBlock Text="Select a message" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                <TextBlock Text="Inspect its body and properties here. Peeking leaves messages in the queue."
                           Classes="caption" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="250"/>
            </StackPanel>
            <Grid RowDefinitions="Auto,Auto,*,Auto"
                  IsVisible="{Binding CurrentMessageOps.SelectedMessage, Converter={x:Static ObjectConverters.IsNotNull}}">
                <Border Grid.Row="0" Classes="inspector-header" BorderBrush="{DynamicResource BorderDefault}" BorderThickness="0,0,0,1">
                    <StackPanel Classes="inspector-heading">
                        <Grid ColumnDefinitions="*,Auto,Auto">
                            <TextBlock Text="Message details · Read only" Classes="caption" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Classes="icon-button" Command="{Binding CurrentMessageOps.ExpandMessageDetailsCommand}"
                                    AutomationProperties.Name="Expand message details" ToolTip.Tip="Expand message details">
                                <LucideIcon Kind="Maximize2" Size="15"/>
                            </Button>
                            <Button Grid.Column="2" Classes="icon-button" Command="{Binding ClearSelectedMessageCommand}"
                                    AutomationProperties.Name="Clear inspected message" ToolTip.Tip="Clear selection">
                                <LucideIcon Kind="X" Size="15"/>
                            </Button>
                        </Grid>
                        <TextBlock Text="{Binding CurrentMessageOps.SelectedMessage.Subject}" Classes="heading inspector-subject"
                                   TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding CurrentMessageOps.SelectedMessage.Subject}"/>
                        <SelectableTextBlock Classes="inspector-id" Text="{Binding CurrentMessageOps.SelectedMessage.MessageId}" FontSize="12"
                                             TextWrapping="Wrap" Foreground="{DynamicResource SubtleForeground}"/>
                        <StackPanel Classes="inspector-peek" Orientation="Horizontal" Spacing="6">
                            <LucideIcon Kind="Eye" Size="13" Foreground="{DynamicResource AccentBrand}" VerticalAlignment="Center"/>
                            <TextBlock Text="Peek · Read only" FontSize="11" Foreground="{DynamicResource AccentBrand}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Grid.Row="1" Background="{DynamicResource SurfaceDanger}" Padding="18,12"
                        IsVisible="{Binding CurrentMessageOps.SelectedMessage.DeadLetterReason, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                    <ScrollViewer MaxHeight="100" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Spacing="5">
                            <TextBlock Text="{Binding CurrentMessageOps.SelectedMessage.DeadLetterReason}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextDanger}" TextWrapping="Wrap"/>
                            <SelectableTextBlock Text="{Binding CurrentMessageOps.SelectedMessage.DeadLetterErrorDescription}"
                                                 FontSize="12" TextWrapping="Wrap"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
                <TabControl Grid.Row="2" Classes="inspector-tabs">
                    <TabItem Header="Body">
                        <Grid RowDefinitions="Auto,*,Auto">
                            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="18,8">
                                <TextBlock Text="{Binding CurrentMessageOps.SelectedMessage.ContentType}" Classes="caption"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Classes="subtle small" Command="{Binding CopyMessageBodyCommand}"
                                        AutomationProperties.Name="Copy message body">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <LucideIcon Kind="Copy" Size="13"/><TextBlock Text="Copy body"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <controls:SyntaxHighlightedTextBox Grid.Row="1"
                                Text="{Binding CurrentMessageOps.FormattedMessageBody, Mode=OneWay}"
                                IsJson="{Binding CurrentMessageOps.IsMessageBodyJson}"
                                IsXml="{Binding CurrentMessageOps.IsMessageBodyXml}"/>
                            <Border Grid.Row="2" Classes="inspector-summary" Padding="18,14" BorderBrush="{DynamicResource BorderDefault}" BorderThickness="0,1,0,0">
                                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="12">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Sequence" Classes="caption"/>
                                        <SelectableTextBlock Text="{Binding CurrentMessageOps.SelectedMessage.SequenceNumber}" FontSize="12"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="4">
                                        <TextBlock Text="Delivery count" Classes="caption"/>
                                        <SelectableTextBlock Text="{Binding CurrentMessageOps.SelectedMessage.DeliveryCount}" FontSize="12"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Spacing="4">
                                        <TextBlock Text="Correlation ID" Classes="caption"/>
                                        <SelectableTextBlock Text="{Binding CurrentMessageOps.SelectedMessage.CorrelationId}" FontSize="12" TextWrapping="Wrap" MaxHeight="40"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4">
                                        <TextBlock Text="Time to live" Classes="caption"/>
                                        <SelectableTextBlock Text="{Binding CurrentMessageOps.SelectedMessage.TimeToLive}" FontSize="12" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </TabItem>
                    <TabItem Header="Properties">
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Spacing="14" Margin="18,14">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Enqueued" Classes="caption"/>
                                    <SelectableTextBlock Text="{Binding CurrentMessageOps.SelectedMessage.EnqueuedTime}" FontSize="12" TextWrapping="Wrap"/>
                                </StackPanel>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Expires" Classes="caption"/>
                                    <SelectableTextBlock Text="{Binding CurrentMessageOps.SelectedMessage.ExpiresAt}" FontSize="12" TextWrapping="Wrap"/>
                                </StackPanel>
                                <StackPanel Spacing="4" IsVisible="{Binding CurrentMessageOps.SelectedMessage.SessionId, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                    <TextBlock Text="Session ID" Classes="caption"/>
                                    <SelectableTextBlock Text="{Binding CurrentMessageOps.SelectedMessage.SessionId}" FontSize="12" TextWrapping="Wrap"/>
                                </StackPanel>
                                <StackPanel Spacing="4" IsVisible="{Binding CurrentMessageOps.SelectedMessage.ScheduledEnqueueTime, Converter={x:Static ObjectConverters.IsNotNull}}">
                                    <TextBlock Text="Scheduled for" Classes="caption"/>
                                    <SelectableTextBlock Text="{Binding CurrentMessageOps.SelectedMessage.ScheduledEnqueueTime}" FontSize="12" TextWrapping="Wrap"/>
                                </StackPanel>
                                <StackPanel Spacing="4" IsVisible="{Binding CurrentMessageOps.SelectedMessage.DeadLetterSource, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                    <TextBlock Text="Dead letter source" Classes="caption"/>
                                    <SelectableTextBlock Text="{Binding CurrentMessageOps.SelectedMessage.DeadLetterSource}" FontSize="12" TextWrapping="Wrap"/>
                                </StackPanel>
                                <StackPanel Spacing="6" IsVisible="{Binding CurrentMessageOps.FormattedApplicationProperties, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                    <TextBlock Text="Application properties" FontWeight="SemiBold" FontSize="12"/>
                                    <TextBox Text="{Binding CurrentMessageOps.FormattedApplicationProperties, Mode=OneWay}"
                                             IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                                             FontFamily="Cascadia Code, Consolas, Monaco, monospace" FontSize="12"
                                             Background="Transparent" BorderThickness="0" Padding="0"/>
                                </StackPanel>
                                <Button Content="Open all message properties" Classes="subtle small" HorizontalAlignment="Left"
                                        Command="{Binding CurrentMessageOps.ExpandMessageDetailsCommand}"/>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
                <Border Grid.Row="3" BorderBrush="{DynamicResource BorderDefault}" BorderThickness="0,1,0,0" Padding="12,8">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <Button Classes="subtle small" Command="{Binding ResendMessageCommand}" CommandParameter="{Binding CurrentMessageOps.SelectedMessage}">
                            <StackPanel Orientation="Horizontal" Spacing="6"><LucideIcon Kind="Send" Size="14"/><TextBlock Text="Resend"/></StackPanel>
                        </Button>
                        <Button Classes="subtle small" Command="{Binding ExportMessageCommand}" CommandParameter="{Binding CurrentMessageOps.SelectedMessage}">
                            <StackPanel Orientation="Horizontal" Spacing="6"><LucideIcon Kind="Download" Size="14"/><TextBlock Text="Export"/></StackPanel>
                        </Button>
                        <Button Classes="icon-button" Command="{Binding CloneMessageCommand}" CommandParameter="{Binding CurrentMessageOps.SelectedMessage}"
                                AutomationProperties.Name="Clone inspected message" ToolTip.Tip="Clone message">
                            <LucideIcon Kind="CopyPlus" Size="14"/>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>
