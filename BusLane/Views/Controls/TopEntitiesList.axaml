<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:BusLane.ViewModels.Dashboard;assembly=BusLane"
             xmlns:models="clr-namespace:BusLane.Models.Dashboard;assembly=BusLane"
             mc:Ignorable="d"
             x:Class="BusLane.Views.Controls.TopEntitiesList"
             x:DataType="vm:TopEntitiesListViewModel"
             x:CompileBindings="False">

    <!-- Busiest entities by active messages, with each one's share of the namespace total. -->
    <Border Classes="overview-panel">
        <StackPanel>
            <Border Classes="overview-panel-header">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{Binding Title}" Classes="overview-panel-title"/>
                    <TextBlock Grid.Column="1" Text="Messages" Classes="overview-status" VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <ItemsControl ItemsSource="{Binding Entities}" Margin="0,4,0,8">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="models:TopEntityInfo">
                        <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto" Margin="16,8" RowSpacing="6">
                            <TextBlock Text="{Binding Name}" Classes="menu-item-label"
                                       TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}"/>
                            <TextBlock Grid.Column="1" Classes="overview-figure"
                                       Text="{Binding MessageCount, StringFormat='{}{0:N0}'}"/>
                            <ProgressBar Grid.Row="1" Grid.ColumnSpan="2" Classes="overview-share"
                                         Value="{Binding PercentageOfTotal}" Maximum="100"
                                         ToolTip.Tip="{Binding PercentageOfTotal, StringFormat='{}{0:0.#}% of namespace messages'}"/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="No data yet" Classes="overview-empty-hint" Margin="16,0,16,14"
                       IsVisible="{Binding !Entities.Count}"/>
        </StackPanel>
    </Border>
</UserControl>
