<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:BusLane.ViewModels.Dashboard;assembly=BusLane"
             xmlns:models="clr-namespace:BusLane.Models.Dashboard;assembly=BusLane"
             mc:Ignorable="d"
             x:Class="BusLane.Views.Controls.TopEntitiesList"
             x:DataType="vm:TopEntitiesListViewModel"
             x:CompileBindings="False">

    <Border Classes="card dashboard-card" Padding="0">
        <Grid RowDefinitions="Auto,*">
            <Border Grid.Row="0"
                    BorderBrush="{DynamicResource BorderDefault}"
                    BorderThickness="0,0,0,1"
                    Padding="14,12">
                <TextBlock Text="{Binding Title}"
                           Classes="body-strong"
                           VerticalAlignment="Center"/>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Entities}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="models:TopEntityInfo">
                            <Border Padding="14,10"
                                    BorderThickness="0,0,0,1"
                                    BorderBrush="{DynamicResource BorderMuted}">
                                <Grid ColumnDefinitions="2*,3*,Auto"
                                      ColumnSpacing="10"
                                      VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}"
                                               FontSize="13"
                                               FontFamily="Cascadia Code, Consolas, Monaco, monospace"
                                               Foreground="{DynamicResource AppForeground}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip.Tip="{Binding Name}"/>
                                    <ProgressBar Grid.Column="1"
                                                 Value="{Binding PercentageOfTotal}"
                                                 Maximum="100"
                                                 Height="4"
                                                 MinWidth="80"
                                                 Background="{DynamicResource SurfaceSubtle}"
                                                 Foreground="{DynamicResource AccentBrand}"
                                                 VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding MessageCount, StringFormat='{}{0:N0}'}"
                                               FontSize="12"
                                               FontFamily="Cascadia Code, Consolas, Monaco, monospace"
                                               Foreground="{DynamicResource AppForeground}"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Right"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
