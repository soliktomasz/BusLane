<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:BusLane.ViewModels.Dashboard;assembly=BusLane"
             mc:Ignorable="d"
             x:Class="BusLane.Views.Controls.NamespaceInboxView"
             x:DataType="vm:NamespaceInboxViewModel"
             x:CompileBindings="False">
    <Border Classes="dashboard-inbox-surface"
            IsVisible="{Binding IsExpanded}">
        <StackPanel>
            <StackPanel Classes="overview-empty" IsVisible="{Binding IsEmpty}">
                <LucideIcon Kind="CircleCheck" Size="22" Foreground="{DynamicResource TextSuccess}"/>
                <TextBlock Text="Nothing needs attention" Classes="menu-item-label" HorizontalAlignment="Center"/>
                <TextBlock Text="Entities scored for dead letters, backlog, or alerts appear here after each refresh."
                           Classes="overview-status" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="320"/>
            </StackPanel>

            <ItemsControl ItemsSource="{Binding PriorityItems}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:NamespaceInboxItemViewModel">
                        <Border Classes="inbox-item-surface">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" RowDefinitions="Auto,Auto" RowSpacing="10">
                                <Border Grid.Column="0"
                                        Width="8" Height="8"
                                        CornerRadius="{StaticResource RadiusPill}"
                                        Background="{Binding Status, Converter={StaticResource InboxStatusToBrushConverter}}"
                                        VerticalAlignment="Top"
                                        Margin="0,6,0,0"/>
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Text="{Binding EntityName}"
                                               Classes="overview-row-title"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip.Tip="{Binding EntityName}"
                                               AutomationProperties.Name="{Binding EntityName}"/>
                                    <TextBlock Text="{Binding ReasonSummary}"
                                               Classes="overview-status"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Top">
                                    <Border Classes="overview-chip danger" IsVisible="{Binding DeadLetterCount}">
                                        <TextBlock Text="{Binding DeadLetterCount, StringFormat='{}{0:N0} dead-lettered'}"/>
                                    </Border>
                                    <Border Classes="overview-chip warning" IsVisible="{Binding HasScheduledMessages}">
                                        <TextBlock Text="{Binding ScheduledCount, StringFormat='{}{0:N0} scheduled'}"/>
                                    </Border>
                                    <Border Classes="overview-chip">
                                        <TextBlock Text="{Binding ActiveMessageCount, StringFormat='{}{0:N0} active'}"/>
                                    </Border>
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                            Orientation="Horizontal"
                                            Spacing="6"
                                            Classes="inbox-actions">
                                    <Button Classes="overview-row-action"
                                            Command="{Binding OpenMessagesCommand}"
                                            AutomationProperties.Name="Open active messages">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <LucideIcon Kind="Inbox" Size="13"/>
                                            <TextBlock Text="Messages"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="overview-row-action"
                                            Command="{Binding OpenDeadLetterCommand}"
                                            AutomationProperties.Name="Open dead-letter messages">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <LucideIcon Kind="TriangleAlert" Size="13"/>
                                            <TextBlock Text="Dead letters"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="overview-row-action"
                                            Command="{Binding OpenSessionInspectorCommand}"
                                            IsVisible="{Binding CanOpenSessionInspector}"
                                            AutomationProperties.Name="Open session inspector">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <LucideIcon Kind="Layers" Size="13"/>
                                            <TextBlock Text="Sessions"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="overview-row-action quiet"
                                            Command="{Binding MarkReviewedCommand}"
                                            ToolTip.Tip="Hide until its message or alert counts grow"
                                            AutomationProperties.Name="Mark issue reviewed">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <LucideIcon Kind="Check" Size="13"/>
                                            <TextBlock Text="Mark reviewed"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Border>
</UserControl>
