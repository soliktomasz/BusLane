<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:BusLane.ViewModels.Dashboard;assembly=BusLane"
             mc:Ignorable="d"
             x:Class="BusLane.Views.Controls.NamespaceInboxView"
             x:DataType="vm:NamespaceInboxViewModel"
             x:CompileBindings="False">
    <UserControl.Styles>
        <!-- Keep actions measured so revealing them cannot resize the row under the pointer. -->
        <Style Selector="StackPanel.inbox-actions">
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>
        <Style Selector="Border.inbox-item-surface:pointerover StackPanel.inbox-actions">
            <Setter Property="Opacity" Value="1"/>
            <Setter Property="IsHitTestVisible" Value="True"/>
        </Style>
        <Style Selector="StackPanel.inbox-actions:focus-within">
            <Setter Property="Opacity" Value="1"/>
            <Setter Property="IsHitTestVisible" Value="True"/>
        </Style>
    </UserControl.Styles>

    <Border Classes="dashboard-inbox-surface"
            IsVisible="{Binding IsExpanded}">
        <StackPanel>
            <Border Classes="dialog-section-surface"
                    Margin="16"
                    IsVisible="{Binding IsEmpty}">
                <StackPanel Spacing="6">
                    <TextBlock Text="Nothing needs attention right now."
                               Classes="title-small"/>
                    <TextBlock Text="The inbox will populate on the next namespace refresh when queues or subscriptions start changing."
                               Classes="caption"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:NamespaceInboxItemViewModel">
                        <Border Classes="inbox-item-surface">
                            <StackPanel Spacing="0">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                    <Border Grid.Column="0"
                                            Width="8" Height="8"
                                            CornerRadius="{StaticResource RadiusPill}"
                                            Background="{Binding Status, Converter={StaticResource InboxStatusToBrushConverter}}"
                                            VerticalAlignment="Top"
                                            Margin="0,6,0,0"/>
                                    <StackPanel Grid.Column="1" Spacing="3">
                                        <TextBlock Text="{Binding EntityName}"
                                                   Classes="title-small"/>
                                        <TextBlock Text="{Binding ReasonSummary}"
                                                   Classes="caption"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <Border Grid.Column="2"
                                            CornerRadius="{StaticResource RadiusPill}"
                                            Padding="8,2"
                                            VerticalAlignment="Center"
                                            Background="{Binding Status, Converter={StaticResource InboxStatusToBrushConverter}, ConverterParameter=Background}">
                                        <TextBlock Text="{Binding StatusLabel}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="{Binding Status, Converter={StaticResource InboxStatusToBrushConverter}}"/>
                                    </Border>
                                </Grid>

                                <StackPanel Orientation="Horizontal"
                                            Spacing="8"
                                            Margin="20,14,0,0"
                                            Classes="inbox-actions">
                                    <Button Classes="secondary small"
                                            Command="{Binding OpenMessagesCommand}">
                                        <TextBlock Text="Open Messages"/>
                                    </Button>
                                    <Button Classes="secondary small"
                                            Command="{Binding OpenDeadLetterCommand}">
                                        <TextBlock Text="Open DLQ"/>
                                    </Button>
                                    <Button Classes="secondary small"
                                            Command="{Binding OpenSessionInspectorCommand}"
                                            IsVisible="{Binding CanOpenSessionInspector}">
                                        <TextBlock Text="Open Sessions"/>
                                    </Button>
                                    <Button Classes="subtle small"
                                            Command="{Binding MarkReviewedCommand}">
                                        <TextBlock Text="Mark Reviewed"/>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Border>
</UserControl>
