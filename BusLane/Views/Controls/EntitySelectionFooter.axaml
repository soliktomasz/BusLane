<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:BusLane.ViewModels"
             x:Class="BusLane.Views.Controls.EntitySelectionFooter"
             x:DataType="vm:MainWindowViewModel"
             x:CompileBindings="False">
    <Border Classes="entity-selection-footer" IsVisible="{Binding CurrentNavigation.HasSelectedEntity}">
        <StackPanel Spacing="6">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <StackPanel Spacing="2">
                    <TextBlock Text="{Binding CurrentNavigation.SelectedEntityKind}"
                               FontSize="11"
                               Foreground="{DynamicResource SubtleForeground}"/>
                    <TextBlock Text="{Binding CurrentNavigation.SelectedEntityPath}"
                               FontSize="13"
                               FontWeight="Medium"
                               TextWrapping="Wrap"/>
                </StackPanel>
                <Button Classes="subtle small"
                        Content="Actions ···"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="Selected entity actions"
                        x:Name="EntityActionsButton">
                    <Button.Flyout>
                        <Flyout Placement="TopEdgeAlignedRight">
                            <StackPanel Spacing="4" MinWidth="190">
                                <Button Classes="subtle small"
                                        Content="Pin / unpin"
                                        Command="{Binding ToggleSelectedEntityPinCommand}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        Click="OnActionClick"/>
                                <StackPanel Spacing="2" IsVisible="{Binding CurrentNavigation.SelectedQueue, Converter={x:Static ObjectConverters.IsNotNull}}">
                                    <Button Classes="subtle small"
                                            Content="Details"
                                            Command="{Binding EntityOperations.OpenQueueDetailsCommand}"
                                            CommandParameter="{Binding CurrentNavigation.SelectedQueue}"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Left"
                                            Click="OnActionClick"/>
                                    <Button Classes="subtle small"
                                            Content="Open in Azure Portal"
                                            Command="{Binding EntityOperations.OpenQueueInAzurePortalCommand}"
                                            CommandParameter="{Binding CurrentNavigation.SelectedQueue}"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Left"
                                            Click="OnActionClick"/>
                                    <Button Classes="subtle small"
                                            Content="Send Message"
                                            Command="{Binding EntityOperations.SendQueueMessageCommand}"
                                            CommandParameter="{Binding CurrentNavigation.SelectedQueue}"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Left"
                                            Click="OnActionClick"/>
                                    <Button Classes="subtle small"
                                            Content="Refresh"
                                            Command="{Binding EntityOperations.RefreshQueueCommand}"
                                            CommandParameter="{Binding CurrentNavigation.SelectedQueue}"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Left"
                                            Click="OnActionClick"/>
                                    <Button Classes="subtle small"
                                            Content="Purge Active Messages"
                                            Command="{Binding EntityOperations.PurgeQueueActiveCommand}"
                                            CommandParameter="{Binding CurrentNavigation.SelectedQueue}"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Left"
                                            Foreground="{DynamicResource TextDanger}"
                                            Click="OnActionClick"/>
                                    <Button Classes="subtle small"
                                            Content="Purge Dead Letters"
                                            Command="{Binding EntityOperations.PurgeQueueDeadLettersCommand}"
                                            CommandParameter="{Binding CurrentNavigation.SelectedQueue}"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Left"
                                            Foreground="{DynamicResource TextDanger}"
                                            Click="OnActionClick"/>
                                    <Button Classes="subtle small"
                                            Content="Edit Properties"
                                            Command="{Binding EntityOperations.OpenQueueEditCommand}"
                                            CommandParameter="{Binding CurrentNavigation.SelectedQueue}"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Left"
                                            Click="OnActionClick"/>
                                    <Button Classes="subtle small"
                                            Content="Delete Queue"
                                            Command="{Binding EntityOperations.DeleteQueueRequestCommand}"
                                            CommandParameter="{Binding CurrentNavigation.SelectedQueue}"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Left"
                                            Foreground="{DynamicResource TextDanger}"
                                            Click="OnActionClick"/>
                                    <Button Classes="subtle small"
                                            Content="Copy Name"
                                            Command="{Binding EntityOperations.CopyQueueNameCommand}"
                                            CommandParameter="{Binding CurrentNavigation.SelectedQueue}"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Left"
                                            Click="OnActionClick"/>
                                </StackPanel>
                                <StackPanel Spacing="2" IsVisible="{Binding CurrentNavigation.SelectedTopic, Converter={x:Static ObjectConverters.IsNotNull}}">
                                    <Button Classes="subtle small"
                                            Content="Details"
                                            Command="{Binding EntityOperations.OpenTopicDetailsCommand}"
                                            CommandParameter="{Binding CurrentNavigation.SelectedTopic}"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Left"
                                            Click="OnActionClick"/>
                                    <Button Classes="subtle small"
                                            Content="Open in Azure Portal"
                                            Command="{Binding EntityOperations.OpenTopicInAzurePortalCommand}"
                                            CommandParameter="{Binding CurrentNavigation.SelectedTopic}"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Left"
                                            Click="OnActionClick"/>
                                    <Button Classes="subtle small"
                                            Content="Send Message to Topic"
                                            Command="{Binding EntityOperations.SendTopicMessageCommand}"
                                            CommandParameter="{Binding CurrentNavigation.SelectedTopic}"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Left"
                                            Click="OnActionClick"/>
                                    <Button Classes="subtle small"
                                            Content="Create Subscription"
                                            Command="{Binding OpenCreateSubscriptionDialogCommand}"
                                            CommandParameter="{Binding CurrentNavigation.SelectedTopic}"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Left"
                                            Click="OnActionClick"/>
                                    <Button Classes="subtle small"
                                            Content="Refresh Subscriptions"
                                            Command="{Binding EntityOperations.RefreshTopicCommand}"
                                            CommandParameter="{Binding CurrentNavigation.SelectedTopic}"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Left"
                                            Click="OnActionClick"/>
                                    <Button Classes="subtle small"
                                            Content="Edit Properties"
                                            Command="{Binding EntityOperations.OpenTopicEditCommand}"
                                            CommandParameter="{Binding CurrentNavigation.SelectedTopic}"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Left"
                                            Click="OnActionClick"/>
                                    <Button Classes="subtle small"
                                            Content="Delete Topic"
                                            Command="{Binding EntityOperations.DeleteTopicRequestCommand}"
                                            CommandParameter="{Binding CurrentNavigation.SelectedTopic}"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Left"
                                            Foreground="{DynamicResource TextDanger}"
                                            Click="OnActionClick"/>
                                    <Button Classes="subtle small"
                                            Content="Copy Name"
                                            Command="{Binding EntityOperations.CopyTopicNameCommand}"
                                            CommandParameter="{Binding CurrentNavigation.SelectedTopic}"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Left"
                                            Click="OnActionClick"/>
                                </StackPanel>
                                <StackPanel Spacing="2" IsVisible="{Binding CurrentNavigation.SelectedSubscription, Converter={x:Static ObjectConverters.IsNotNull}}">
                                    <Button Classes="subtle small"
                                            Content="Details"
                                            Command="{Binding OpenSubscriptionDetailDialogCommand}"
                                            CommandParameter="{Binding CurrentNavigation.SelectedSubscription}"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Left"
                                            Click="OnActionClick"/>
                                    <Button Classes="subtle small"
                                            Content="Open in Azure Portal"
                                            Command="{Binding EntityOperations.OpenSubscriptionInAzurePortalCommand}"
                                            CommandParameter="{Binding CurrentNavigation.SelectedSubscription}"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Left"
                                            Click="OnActionClick"/>
                                    <Button Classes="subtle small"
                                            Content="Manage Filters/Rules"
                                            Command="{Binding EntityOperations.OpenSubscriptionRulesDialogCommand}"
                                            CommandParameter="{Binding CurrentNavigation.SelectedSubscription}"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Left"
                                            Click="OnActionClick"/>
                                    <Button Classes="subtle small"
                                            Content="Purge Active Messages"
                                            Command="{Binding EntityOperations.PurgeSubscriptionActiveCommand}"
                                            CommandParameter="{Binding CurrentNavigation.SelectedSubscription}"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Left"
                                            Foreground="{DynamicResource TextDanger}"
                                            Click="OnActionClick"/>
                                    <Button Classes="subtle small"
                                            Content="Purge Dead Letters"
                                            Command="{Binding EntityOperations.PurgeSubscriptionDeadLettersCommand}"
                                            CommandParameter="{Binding CurrentNavigation.SelectedSubscription}"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Left"
                                            Foreground="{DynamicResource TextDanger}"
                                            Click="OnActionClick"/>
                                    <Button Classes="subtle small"
                                            Content="Refresh"
                                            Command="{Binding EntityOperations.RefreshSubscriptionCommand}"
                                            CommandParameter="{Binding CurrentNavigation.SelectedSubscription}"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Left"
                                            Click="OnActionClick"/>
                                    <Button Classes="subtle small"
                                            Content="Edit Properties"
                                            Command="{Binding EntityOperations.OpenSubscriptionEditCommand}"
                                            CommandParameter="{Binding CurrentNavigation.SelectedSubscription}"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Left"
                                            Click="OnActionClick"/>
                                    <Button Classes="subtle small"
                                            Content="Delete Subscription"
                                            Command="{Binding EntityOperations.DeleteSubscriptionRequestCommand}"
                                            CommandParameter="{Binding CurrentNavigation.SelectedSubscription}"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Left"
                                            Foreground="{DynamicResource TextDanger}"
                                            Click="OnActionClick"/>
                                    <Button Classes="subtle small"
                                            Content="Copy Path"
                                            Command="{Binding EntityOperations.CopySubscriptionPathCommand}"
                                            CommandParameter="{Binding CurrentNavigation.SelectedSubscription}"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Left"
                                            Click="OnActionClick"/>
                                </StackPanel>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </Grid>
            <TextBlock Text="{Binding CurrentNavigation.SelectedEntitySummary}"
                       FontSize="11"
                       Foreground="{DynamicResource SubtleForeground}"
                       TextWrapping="Wrap"/>
        </StackPanel>
    </Border>
</UserControl>
