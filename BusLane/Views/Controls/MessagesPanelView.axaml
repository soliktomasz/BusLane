<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:BusLane.ViewModels"
             xmlns:models="using:BusLane.Models"
             xmlns:controls="using:BusLane.Views.Controls"
             xmlns:converters="using:BusLane.Converters"
             x:Class="BusLane.Views.Controls.MessagesPanelView"
             x:DataType="vm:MainWindowViewModel"
             x:CompileBindings="False">

    <UserControl.Resources>
        <converters:IntEqualsConverter x:Key="IntEqualsConverter"/>
        <!-- Search, selection and bulk actions sit under the Active / Dead letter tabs; one definition serves both. -->
        <DataTemplate x:Key="MessageSearchBarTemplate" x:DataType="vm:MainWindowViewModel">
            <Border Classes="message-search-bar">
                <StackPanel Spacing="10">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBox x:Name="MessageSearchTextBox"
                                 Classes="message-header-search"
                                 Text="{Binding CurrentMessageOps.MessageSearchText, Mode=TwoWay}"
                                 PlaceholderText="Search loaded messages"
                                 AutomationProperties.Name="Search loaded messages"
                                 ToolTip.Tip="Search loaded messages by ID, body, correlation ID, or subject">
                            <TextBox.InnerLeftContent>
                                <LucideIcon Kind="Search" Size="14" Margin="10,0,2,0"
                                            Foreground="{DynamicResource SubtleForeground}"
                                            VerticalAlignment="Center"/>
                            </TextBox.InnerLeftContent>
                            <TextBox.InnerRightContent>
                                <Button Classes="icon-button message-header-clear"
                                        Command="{Binding ClearMessageSearchCommand}"
                                        IsVisible="{Binding CurrentMessageOps.MessageSearchText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                        AutomationProperties.Name="Clear message search"
                                        ToolTip.Tip="Clear search">
                                    <LucideIcon Kind="X" Size="13"/>
                                </Button>
                            </TextBox.InnerRightContent>
                        </TextBox>
                        <ToggleButton Grid.Column="1"
                                      Classes="pill message-header-select"
                                      IsChecked="{Binding CurrentMessageOps.IsMultiSelectMode, Mode=TwoWay}"
                                      ToolTip.Tip="Toggle multi-select mode (⌘M / Ctrl+M)">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <LucideIcon Kind="SquareCheck" Size="14"/>
                                <TextBlock Text="Select"/>
                            </StackPanel>
                        </ToggleButton>
                    </Grid>
                        <!-- Bulk Actions Bar (visible when multi-select mode is active) -->
                        <Border Classes="message-search-surface">
                            <Border.IsVisible>
                                <MultiBinding Converter="{x:Static BoolConverters.And}">
                                    <Binding Path="CurrentMessageOps.IsMultiSelectMode"/>
                                    <Binding Path="CurrentNavigation.IsSessionInspectorTabSelected"
                                             Converter="{x:Static BoolConverters.Not}"/>
                                </MultiBinding>
                            </Border.IsVisible>
                            <Grid RowDefinitions="Auto,Auto" RowSpacing="8">
                                <StackPanel Grid.Column="0"
                                            Orientation="Horizontal"
                                            Spacing="8"
                                            VerticalAlignment="Center">
                                    <Border Classes="badge-info" Padding="8,4">
                                        <TextBlock Text="{Binding CurrentMessageOps.SelectedMessagesCount, StringFormat='{}{0} selected'}"
                                                   FontWeight="SemiBold"
                                                   FontSize="12"/>
                                    </Border>
                                    <Button Classes="subtle small"
                                            Content="Select All"
                                            Command="{Binding SelectAllMessagesCommand}"
                                            Padding="8,4"/>
                                    <Button Classes="subtle small"
                                            Content="Deselect All"
                                            Command="{Binding DeselectAllMessagesCommand}"
                                            Padding="8,4"/>
                                </StackPanel>

                                <StackPanel Grid.Row="1"
                                            Orientation="Horizontal"
                                            Spacing="6"
                                            HorizontalAlignment="Right">
                                    <Button Classes="secondary small"
                                            Command="{Binding BulkResendMessagesCommand}"
                                            Padding="10,6"
                                            ToolTip.Tip="Resend selected messages">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <LucideIcon Kind="Send" Size="12"/>
                                            <TextBlock Text="Resend"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="secondary small"
                                            Command="{Binding ResubmitDeadLetterMessagesAsyncCommand}"
                                            IsVisible="{Binding CurrentNavigation.ShowDeadLetter}"
                                            Padding="10,6"
                                            ToolTip.Tip="Resubmit selected messages from dead letter queue">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <LucideIcon Kind="RefreshCw" Size="12"/>
                                            <TextBlock Text="Resubmit"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="secondary small"
                                            IsEnabled="{Binding CurrentMessageOps.HasSelectedMessages}"
                                            Padding="10,6"
                                            ToolTip.Tip="Export selected messages">
                                        <Button.Flyout>
                                            <Flyout Placement="BottomEdgeAlignedRight">
                                                <StackPanel Spacing="4" MinWidth="170">
                                                    <Button Classes="subtle small"
                                                            Command="{Binding ExportSelectedMessagesCommand}"
                                                            HorizontalAlignment="Stretch"
                                                            HorizontalContentAlignment="Left">
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <LucideIcon Kind="FileText" Size="13"/>
                                                            <TextBlock Text="Full message"/>
                                                        </StackPanel>
                                                    </Button>
                                                    <Button Classes="subtle small"
                                                            Command="{Binding ExportSelectedMessageBodiesCommand}"
                                                            HorizontalAlignment="Stretch"
                                                            HorizontalContentAlignment="Left">
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <LucideIcon Kind="FileText" Size="13"/>
                                                            <TextBlock Text="Body only"/>
                                                        </StackPanel>
                                                    </Button>
                                                </StackPanel>
                                            </Flyout>
                                        </Button.Flyout>
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <LucideIcon Kind="Download" Size="12"/>
                                            <TextBlock Text="Export"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="danger-outline small"
                                            Command="{Binding BulkDeleteMessagesAsyncCommand}"
                                            Padding="10,6"
                                            ToolTip.Tip="Delete selected messages">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <LucideIcon Kind="Trash2" Size="12"/>
                                            <TextBlock Text="Delete"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                    <TextBlock Text="{Binding CurrentMessageOps.LockedMessageValidationMessage}"
                               Foreground="{DynamicResource TextDanger}"
                               TextWrapping="Wrap"
                               IsVisible="{Binding CurrentMessageOps.LockedMessageValidationMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid RowDefinitions="Auto,*">
    <!-- Entity header spans list and inspector: identity on the left, entity actions on the right. -->
    <Border Grid.Row="0" Classes="message-command-bar">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Button Classes="entity-pane-restore-command"
                        Command="{Binding ShowEntityPaneCommand}"
                        IsVisible="{Binding !IsCurrentEntityPaneVisible}"
                        ToolTip.Tip="Show entity pane">
                    <LucideIcon Kind="PanelLeftOpen" Size="16"
                                Foreground="{DynamicResource AccentBrand}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                </Button>
                <Border Classes="entity-header-icon"
                        IsVisible="{Binding WorkspaceEntityKindLabel, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <Panel>
                        <LucideIcon Kind="Inbox" Size="18"
                                    IsVisible="{Binding WorkspaceEntityKindLabel, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=Queues}"/>
                        <LucideIcon Kind="Megaphone" Size="18"
                                    IsVisible="{Binding WorkspaceEntityKindLabel, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=Topics}"/>
                        <LucideIcon Kind="ListOrdered" Size="18"
                                    IsVisible="{Binding WorkspaceEntityKindLabel, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=Subscriptions}"/>
                    </Panel>
                </Border>
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                <WrapPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding WorkspaceEntityName}" Classes="entity-header-title"
                               TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding WorkspaceEntityName}"
                               IsVisible="{Binding WorkspaceEntityName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                    <TextBlock Text="Messages" Classes="entity-header-title"
                               IsVisible="{Binding WorkspaceEntityName, Converter={x:Static StringConverters.IsNullOrEmpty}}"/>
                    <Border Classes="badge-info"
                            Padding="8,4"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center"
                            IsVisible="{Binding CurrentMessageOps.IsSessionScoped}">
                        <TextBlock Text="{Binding CurrentMessageOps.SessionScopeLabel}" FontSize="12"
                                   MaxWidth="180" TextTrimming="CharacterEllipsis"
                                   ToolTip.Tip="{Binding CurrentMessageOps.SessionScopeLabel}"/>
                    </Border>
                    <Button Classes="subtle small"
                            Command="{Binding CurrentMessageOps.ClearSessionScopeCommand}"
                            IsVisible="{Binding CurrentMessageOps.IsSessionScoped}"
                            Margin="4,0,0,0"
                            Padding="8,6">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <LucideIcon Kind="X" Size="12"/>
                            <TextBlock Text="Clear Session"/>
                        </StackPanel>
                    </Button>
                </WrapPanel>
                <controls:NamespaceWorkspaceBreadcrumb/>
            </StackPanel>
            <StackPanel Grid.Column="2" Classes="entity-header-actions" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Classes="entity-header-action outline collapsible message-header-utility"
                        AutomationProperties.Name="Refresh messages"
                        Command="{Binding LoadMessagesCommand}"
                        ToolTip.Tip="Refresh messages"
                        IsVisible="{Binding CurrentNavigation.IsSessionInspectorTabSelected, Converter={x:Static BoolConverters.Not}}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <LucideIcon Kind="RefreshCw" Size="14"/>
                        <TextBlock Text="Refresh"/>
                    </StackPanel>
                </Button>
                <Button Classes="primary entity-header-action message-header-send"
                        Command="{Binding OpenSendMessagePopupCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <LucideIcon Kind="Plus" Size="15"/>
                        <TextBlock Text="Send message"/>
                    </StackPanel>
                                <Button.IsVisible>
                                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                                        <Binding Path="CurrentNavigation.IsSessionInspectorTabSelected" Converter="{x:Static BoolConverters.Not}"/>
                                        <MultiBinding Converter="{x:Static BoolConverters.Or}">
                                            <Binding Path="CurrentNavigation.SelectedQueue" Converter="{x:Static ObjectConverters.IsNotNull}"/>
                                            <Binding Path="CurrentNavigation.SelectedTopic" Converter="{x:Static ObjectConverters.IsNotNull}"/>
                                        </MultiBinding>
                                    </MultiBinding>
                                </Button.IsVisible>
                </Button>
                <Button x:Name="MoreActionsButton"
                        Classes="entity-header-action outline icon-only message-header-utility"
                        AutomationProperties.Name="More message actions"
                        ToolTip.Tip="More message actions"
                        IsVisible="{Binding CurrentNavigation.IsSessionInspectorTabSelected, Converter={x:Static BoolConverters.Not}}">
                                    <Button.Flyout>
                        <Flyout Placement="BottomEdgeAlignedRight" FlyoutPresenterClasses="menu-flyout">
                            <StackPanel Spacing="2" Width="296">
                                <TextBlock Text="Sort by enqueued time" Classes="menu-group-label"/>
                                <Button Classes="menu-item" Command="{Binding SetSortOrderCommand}" CommandParameter="{x:True}"
                                        Click="OnMoreMenuItemClick" AutomationProperties.Name="Sort newest first">
                                    <Grid ColumnDefinitions="20,*" ColumnSpacing="10">
                                        <LucideIcon Kind="Check" Size="15" Classes="menu-check"
                                                    IsVisible="{Binding CurrentMessageOps.SortDescending}"/>
                                        <TextBlock Grid.Column="1" Text="Newest first" Classes="menu-item-label"/>
                                    </Grid>
                                </Button>
                                <Button Classes="menu-item" Command="{Binding SetSortOrderCommand}" CommandParameter="{x:False}"
                                        Click="OnMoreMenuItemClick" AutomationProperties.Name="Sort oldest first">
                                    <Grid ColumnDefinitions="20,*" ColumnSpacing="10">
                                        <LucideIcon Kind="Check" Size="15" Classes="menu-check"
                                                    IsVisible="{Binding !CurrentMessageOps.SortDescending}"/>
                                        <TextBlock Grid.Column="1" Text="Oldest first" Classes="menu-item-label"/>
                                    </Grid>
                                </Button>

                                <Border Classes="menu-separator"/>

                                <Button Classes="menu-item" Command="{Binding CurrentMessageOps.ReceiveLockedMessagesCommand}"
                                        Click="OnMoreMenuItemClick">
                                    <Grid ColumnDefinitions="20,*" ColumnSpacing="10">
                                        <LucideIcon Kind="LockKeyhole" Size="15"/>
                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <TextBlock Text="Receive locked" Classes="menu-item-label"/>
                                            <TextBlock Text="Lock a page to complete, abandon, defer, or dead-letter."
                                                       Classes="menu-item-description"/>
                                        </StackPanel>
                                    </Grid>
                                </Button>
                                <Border Classes="menu-item-static">
                                    <Grid ColumnDefinitions="20,*" ColumnSpacing="10" RowDefinitions="Auto,Auto">
                                        <LucideIcon Kind="Clock" Size="15"/>
                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <TextBlock Text="Receive deferred" Classes="menu-item-label"/>
                                            <TextBlock Text="Sequence numbers, separated by commas."
                                                       Classes="menu-item-description"/>
                                        </StackPanel>
                                        <Grid Grid.Row="1" Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="6" Margin="0,8,0,0">
                                            <TextBox Classes="menu-input"
                                                     Text="{Binding CurrentMessageOps.DeferredSequenceNumbersText, Mode=TwoWay}"
                                                     PlaceholderText="e.g. 12, 34, 56"
                                                     AutomationProperties.Name="Deferred sequence numbers"/>
                                            <Button Grid.Column="1" Classes="secondary small menu-input-action"
                                                    Content="Receive"
                                                    Command="{Binding CurrentMessageOps.ReceiveDeferredMessagesCommand}"
                                                    Click="OnMoreMenuItemClick"
                                                    AutomationProperties.Name="Receive deferred messages"/>
                                        </Grid>
                                    </Grid>
                                </Border>

                                <Border Classes="menu-separator"/>

                                <Button Classes="menu-item destructive" Command="{Binding PurgeMessagesCommand}"
                                        Click="OnMoreMenuItemClick">
                                    <Grid ColumnDefinitions="20,*" ColumnSpacing="10">
                                        <LucideIcon Kind="Trash2" Size="15"/>
                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <TextBlock Text="Purge messages" Classes="menu-item-label"/>
                                            <TextBlock Text="Shows a preview first. Purged messages can't be recovered."
                                                       Classes="menu-item-description"/>
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                    <LucideIcon Kind="Ellipsis" Size="16"/>
                </Button>
            </StackPanel>
        </Grid>
    </Border>

    <Grid x:Name="InspectorWorkspaceGrid" Grid.Row="1" ColumnDefinitions="*,5,360">
    <Border x:Name="MessageListPane" Grid.Column="0" Classes="pane-card" Padding="0">
        <Grid RowDefinitions="Auto,*">
                    <Border Grid.Row="0"
                            Classes="message-search-surface"
                            Margin="16,12,16,0"
                            IsVisible="{Binding CurrentMessageOps.LockedMessages.Count}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Locked messages" Classes="body-strong"/>
                            <ItemsControl ItemsSource="{Binding CurrentMessageOps.LockedMessages}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:ReceivedMessageInfo">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,2">
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{Binding Message.MessageId}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Message.SequenceNumber, StringFormat='Seq {0}'}"
                                                           Foreground="{DynamicResource SubtleForeground}"/>
                                                <TextBlock Text="{Binding LockedUntil, StringFormat='Lock until {0:HH:mm:ss}'}"
                                                           Foreground="{DynamicResource SubtleForeground}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                                <Button Classes="primary small"
                                                        Content="Complete"
                                                        IsEnabled="{Binding CanSettle}"
                                                        Command="{Binding $parent[Window].DataContext.CurrentMessageOps.CompleteLockedMessageCommand}"
                                                        CommandParameter="{Binding}"/>
                                                <Button Classes="subtle small"
                                                        Content="Abandon"
                                                        IsEnabled="{Binding CanSettle}"
                                                        Command="{Binding $parent[Window].DataContext.CurrentMessageOps.AbandonLockedMessageCommand}"
                                                        CommandParameter="{Binding}"/>
                                                <Button Classes="subtle small"
                                                        Content="Defer"
                                                        IsEnabled="{Binding CanSettle}"
                                                        Command="{Binding $parent[Window].DataContext.CurrentMessageOps.DeferLockedMessageCommand}"
                                                        CommandParameter="{Binding}"/>
                                                <Button Classes="subtle small"
                                                        Content="Renew"
                                                        IsEnabled="{Binding CanSettle}"
                                                        Command="{Binding $parent[Window].DataContext.CurrentMessageOps.RenewLockedMessageCommand}"
                                                        CommandParameter="{Binding}"/>
                                                <Button Classes="danger-subtle small"
                                                        Content="DLQ"
                                                        IsEnabled="{Binding CanSettle}"
                                                        Command="{Binding $parent[Window].DataContext.CurrentMessageOps.DeadLetterLockedMessageCommand}"
                                                        CommandParameter="{Binding}"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

            <!-- Tab Content Area -->
            <TabControl Grid.Row="1"
                        Classes="message-tabs"
                        SelectedIndex="{Binding CurrentNavigation.SelectedMessageTabIndex}">

                <TabItem Classes="message-tab">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Active"/>
                            <Border Classes="counter-active" VerticalAlignment="Center">
                                <TextBlock Text="{Binding CurrentNavigation.CurrentActiveMessageCount}"/>
                            </Border>
                        </StackPanel>
                    </TabItem.Header>
                    <TabItem.Content>
                        <Grid RowDefinitions="Auto,Auto,*,Auto">
                            <ContentControl Grid.Row="0" Content="{Binding}" ContentTemplate="{StaticResource MessageSearchBarTemplate}"/>
                            <Border Grid.Row="1" Padding="16,8" BorderBrush="{DynamicResource BorderDefault}" BorderThickness="0,0,0,1"
                                    Background="{DynamicResource SurfaceSubtle}">
                                <DockPanel>
                                    <!-- Reserves the row checkbox width so headers stay over their columns in Select mode. -->
                                    <CheckBox DockPanel.Dock="Left" Margin="0,0,10,0" Opacity="0" MinHeight="0" Height="0" VerticalAlignment="Top"
                                              IsHitTestVisible="False" Focusable="False" IsTabStop="False"
                                              AutomationProperties.AccessibilityView="Raw"
                                              IsVisible="{Binding CurrentMessageOps.IsMultiSelectMode}"/>
                                    <Grid ColumnDefinitions="*,*,92,28" ColumnSpacing="12">
                                        <TextBlock Text="Subject / sequence" Classes="caption" FontSize="11"/>
                                        <TextBlock Grid.Column="1" Text="Message ID" Classes="caption" FontSize="11"/>
                                        <TextBlock Grid.Column="2" Text="Enqueued" Classes="caption" FontSize="11"/>
                                    </Grid>
                                </DockPanel>
                            </Border>
                            <Border Grid.Row="1"
                                    Classes="inline-loading-surface"
                                    Margin="8,8,8,0"
                                    IsVisible="{Binding CurrentMessageOps.IsLoadingMessages}">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <ProgressBar IsIndeterminate="True"
                                                 Width="120"
                                                 Height="3"
                                                 VerticalAlignment="Center"/>
                                    <TextBlock Text="Loading messages"
                                               Classes="caption"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <ListBox Grid.Row="2"
                                     ItemsSource="{Binding CurrentMessageOps.FilteredMessages}"
                                     SelectedItem="{Binding CurrentMessageOps.SelectedMessage, Mode=TwoWay}"
                                     IsEnabled="{Binding !CurrentMessageOps.IsLoadingMessages}"
                                     Background="Transparent"
                                     Classes="message-table" Padding="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            </Style>
                        </ListBox.Styles>
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="models:MessageInfo"><controls:MessageRowView/></DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                            <Border Grid.Row="2"
                                    Classes="message-empty-state"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    MaxWidth="360">
                                <Border.IsVisible>
                                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                                        <Binding Path="CurrentNavigation.CurrentEntityName" Converter="{x:Static StringConverters.IsNullOrEmpty}"/>
                                        <Binding Path="!CurrentMessageOps.IsLoadingMessages"/>
                                    </MultiBinding>
                                </Border.IsVisible>
                                <StackPanel Spacing="8" HorizontalAlignment="Center">
                                    <LucideIcon Kind="Inbox" Size="24"
                                                Foreground="{DynamicResource MutedForeground}"
                                                HorizontalAlignment="Center"/>
                                    <TextBlock Text="Choose an entity"
                                               Classes="body-strong"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="Select a queue or subscription to load messages."
                                               Classes="caption"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="2"
                                    Classes="message-empty-state"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    MaxWidth="360">
                                <Border.IsVisible>
                                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                                        <Binding Path="CurrentNavigation.CurrentEntityName" Converter="{x:Static StringConverters.IsNotNullOrEmpty}"/>
                                        <Binding Path="!CurrentMessageOps.FilteredMessages.Count"/>
                                        <Binding Path="CurrentMessageOps.MessageSearchText" Converter="{x:Static StringConverters.IsNullOrEmpty}"/>
                                        <Binding Path="!CurrentMessageOps.IsLoadingMessages"/>
                                    </MultiBinding>
                                </Border.IsVisible>
                                <StackPanel Spacing="8" HorizontalAlignment="Center">
                                    <LucideIcon Kind="Inbox" Size="24"
                                                Foreground="{DynamicResource MutedForeground}"
                                                HorizontalAlignment="Center"/>
                                    <TextBlock Text="No active messages"
                                               Classes="body-strong"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="This entity has no active messages on the current page."
                                               Classes="caption"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="2"
                                    Classes="message-empty-state"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    MaxWidth="360">
                                <Border.IsVisible>
                                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                                        <Binding Path="CurrentNavigation.CurrentEntityName" Converter="{x:Static StringConverters.IsNotNullOrEmpty}"/>
                                        <Binding Path="!CurrentMessageOps.FilteredMessages.Count"/>
                                        <Binding Path="CurrentMessageOps.MessageSearchText" Converter="{x:Static StringConverters.IsNotNullOrEmpty}"/>
                                        <Binding Path="!CurrentMessageOps.IsLoadingMessages"/>
                                    </MultiBinding>
                                </Border.IsVisible>
                                <StackPanel Spacing="8" HorizontalAlignment="Center">
                                    <LucideIcon Kind="Search" Size="24"
                                                Foreground="{DynamicResource MutedForeground}"
                                                HorizontalAlignment="Center"/>
                                    <TextBlock Text="No messages match your search"
                                               Classes="body-strong"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="Try a different message ID, body term, correlation ID, or subject."
                                               Classes="caption"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <controls:MessagePaginationFooterView Grid.Row="3"
                                                                  Margin="8,8,8,0"
                                                                  DataContext="{Binding CurrentMessageOps}"/>
                        </Grid>
                    </TabItem.Content>
                </TabItem>

                <TabItem Classes="message-tab">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Dead Letter"/>
                            <Border Classes="counter-dead" VerticalAlignment="Center">
                                <TextBlock Text="{Binding CurrentNavigation.CurrentDeadLetterCount}"/>
                            </Border>
                        </StackPanel>
                    </TabItem.Header>
                    <!-- Loading indicator for dead letter messages -->
                    <TabItem.Content>
                        <Grid RowDefinitions="Auto,Auto,*,Auto">
                            <ContentControl Grid.Row="0" Content="{Binding}" ContentTemplate="{StaticResource MessageSearchBarTemplate}"/>
                            <Border Grid.Row="1" Padding="16,8" BorderBrush="{DynamicResource BorderDefault}" BorderThickness="0,0,0,1"
                                    Background="{DynamicResource SurfaceSubtle}">
                                <DockPanel>
                                    <!-- Reserves the row checkbox width so headers stay over their columns in Select mode. -->
                                    <CheckBox DockPanel.Dock="Left" Margin="0,0,10,0" Opacity="0" MinHeight="0" Height="0" VerticalAlignment="Top"
                                              IsHitTestVisible="False" Focusable="False" IsTabStop="False"
                                              AutomationProperties.AccessibilityView="Raw"
                                              IsVisible="{Binding CurrentMessageOps.IsMultiSelectMode}"/>
                                    <Grid ColumnDefinitions="*,*,92,28" ColumnSpacing="12">
                                        <TextBlock Text="Subject / sequence" Classes="caption" FontSize="11"/>
                                        <TextBlock Grid.Column="1" Text="Message ID" Classes="caption" FontSize="11"/>
                                        <TextBlock Grid.Column="2" Text="Enqueued" Classes="caption" FontSize="11"/>
                                    </Grid>
                                </DockPanel>
                            </Border>
                            <Border Grid.Row="1"
                                    Classes="inline-loading-surface"
                                    Margin="8,8,8,0"
                                    IsVisible="{Binding CurrentMessageOps.IsLoadingMessages}">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <ProgressBar IsIndeterminate="True"
                                                 Width="120"
                                                 Height="3"
                                                 VerticalAlignment="Center"/>
                                    <TextBlock Text="Loading dead letter messages"
                                               Classes="caption"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <ListBox Grid.Row="2"
                                     ItemsSource="{Binding CurrentMessageOps.FilteredMessages}"
                                     SelectedItem="{Binding CurrentMessageOps.SelectedMessage, Mode=TwoWay}"
                                     IsEnabled="{Binding !CurrentMessageOps.IsLoadingMessages}"
                                     Background="Transparent"
                                     Classes="message-table" Padding="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            </Style>
                        </ListBox.Styles>
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="models:MessageInfo"><controls:MessageRowView/></DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                            <Border Grid.Row="2"
                                    Classes="message-empty-state"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    MaxWidth="360">
                                <Border.IsVisible>
                                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                                        <Binding Path="CurrentNavigation.CurrentEntityName" Converter="{x:Static StringConverters.IsNullOrEmpty}"/>
                                        <Binding Path="!CurrentMessageOps.IsLoadingMessages"/>
                                    </MultiBinding>
                                </Border.IsVisible>
                                <StackPanel Spacing="8" HorizontalAlignment="Center">
                                    <LucideIcon Kind="Inbox" Size="24"
                                                Foreground="{DynamicResource MutedForeground}"
                                                HorizontalAlignment="Center"/>
                                    <TextBlock Text="Choose an entity"
                                               Classes="body-strong"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="Select a queue or subscription to inspect dead letters."
                                               Classes="caption"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="2"
                                    Classes="message-empty-state"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    MaxWidth="360">
                                <Border.IsVisible>
                                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                                        <Binding Path="CurrentNavigation.CurrentEntityName" Converter="{x:Static StringConverters.IsNotNullOrEmpty}"/>
                                        <Binding Path="!CurrentMessageOps.FilteredMessages.Count"/>
                                        <Binding Path="CurrentMessageOps.MessageSearchText" Converter="{x:Static StringConverters.IsNullOrEmpty}"/>
                                        <Binding Path="!CurrentMessageOps.IsLoadingMessages"/>
                                    </MultiBinding>
                                </Border.IsVisible>
                                <StackPanel Spacing="8" HorizontalAlignment="Center">
                                    <LucideIcon Kind="ShieldCheck" Size="24"
                                                Foreground="{DynamicResource MutedForeground}"
                                                HorizontalAlignment="Center"/>
                                    <TextBlock Text="No dead-letter messages"
                                               Classes="body-strong"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="The current entity has no dead-letter messages on this page."
                                               Classes="caption"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="2"
                                    Classes="message-empty-state"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    MaxWidth="360">
                                <Border.IsVisible>
                                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                                        <Binding Path="CurrentNavigation.CurrentEntityName" Converter="{x:Static StringConverters.IsNotNullOrEmpty}"/>
                                        <Binding Path="!CurrentMessageOps.FilteredMessages.Count"/>
                                        <Binding Path="CurrentMessageOps.MessageSearchText" Converter="{x:Static StringConverters.IsNotNullOrEmpty}"/>
                                        <Binding Path="!CurrentMessageOps.IsLoadingMessages"/>
                                    </MultiBinding>
                                </Border.IsVisible>
                                <StackPanel Spacing="8" HorizontalAlignment="Center">
                                    <LucideIcon Kind="Search" Size="24"
                                                Foreground="{DynamicResource MutedForeground}"
                                                HorizontalAlignment="Center"/>
                                    <TextBlock Text="No messages match your search"
                                               Classes="body-strong"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="Try a different message ID, body term, correlation ID, reason, or subject."
                                               Classes="caption"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <controls:MessagePaginationFooterView Grid.Row="3"
                                                                  Margin="8,8,8,0"
                                                                  DataContext="{Binding CurrentMessageOps}"/>
                        </Grid>
                    </TabItem.Content>
                </TabItem>

                <TabItem Classes="message-tab"
                         IsVisible="{Binding CurrentNavigation.CanShowSessionInspector}">
                    <TabItem.Header>
                        <TextBlock Text="Sessions"/>
                    </TabItem.Header>
                    <TabItem.Content>
                        <Grid RowDefinitions="Auto,*,Auto">
                            <Border Grid.Row="0"
                                    Classes="form-section"
                                    Margin="8,8,8,0">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                    <StackPanel Grid.Column="0" Spacing="4">
                                        <TextBlock Text="Discovered sessions"
                                                   FontWeight="SemiBold"
                                                   FontSize="13"/>
                                        <TextBlock Text="Session IDs are discovered from active and dead-letter message peeks."
                                                   Classes="caption"
                                                   Foreground="{DynamicResource SubtleForeground}"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Classes="subtle small"
                                            Command="{Binding CurrentSessionInspector.LoadSessionsCommand}"
                                            Padding="10,8">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <LucideIcon Kind="RefreshCw" Size="12"/>
                                            <TextBlock Text="Refresh Sessions"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>

                            <ListBox Grid.Row="1"
                                     ItemsSource="{Binding CurrentSessionInspector.Sessions}"
                                     SelectedItem="{Binding CurrentSessionInspector.SelectedSession}"
                                     Background="Transparent"
                                     Classes="message-table" Padding="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.Styles>
                                    <Style Selector="ListBoxItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    </Style>
                                </ListBox.Styles>
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <VirtualizingStackPanel/>
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="models:SessionInspectorItem">
                                        <Border Classes="card" Padding="12" Margin="0,0,0,8">
                                            <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
                                                <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                                                    <StackPanel Grid.Column="0" Spacing="4">
                                                        <TextBlock Text="{Binding SessionId}"
                                                                   FontWeight="SemiBold"
                                                                   FontSize="13"/>
                                                        <TextBlock Text="{Binding State, StringFormat='State: {0}'}"
                                                                   Classes="caption"
                                                                   Foreground="{DynamicResource SubtleForeground}"
                                                                   IsVisible="{Binding State, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                                    </StackPanel>
                                                    <Button Grid.Column="1"
                                                            Classes="primary small"
                                                            Command="{Binding $parent[Window].DataContext.CurrentSessionInspector.OpenSessionMessagesCommand}"
                                                            CommandParameter="{Binding}"
                                                            Padding="10,8">
                                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                                            <LucideIcon Kind="ArrowRight" Size="12"/>
                                                            <TextBlock Text="Open Messages"/>
                                                        </StackPanel>
                                                    </Button>
                                                </Grid>

                                                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="6">
                                                    <Border Classes="badge-muted" Padding="6,3">
                                                        <TextBlock Text="{Binding ActiveMessageCount, StringFormat='Active: {0}'}"
                                                                   FontSize="10"
                                                                   Foreground="{DynamicResource SubtleForeground}"/>
                                                    </Border>
                                                    <Border Classes="badge-muted" Padding="6,3">
                                                        <TextBlock Text="{Binding DeadLetterMessageCount, StringFormat='DLQ: {0}'}"
                                                                   FontSize="10"
                                                                   Foreground="{DynamicResource SubtleForeground}"/>
                                                    </Border>
                                                    <Border Classes="badge-info"
                                                            Padding="6,3"
                                                            IsVisible="{Binding HasDeadLetter}">
                                                        <TextBlock Text="Dead Letter Present" FontSize="10"/>
                                                    </Border>
                                                </StackPanel>

                                                <StackPanel Grid.Row="2" Spacing="2">
                                                    <TextBlock Text="{Binding LastActivityAt, StringFormat='Last activity: {0:yyyy-MM-dd HH:mm:ss}'}"
                                                               Classes="caption"
                                                               Foreground="{DynamicResource SubtleForeground}"/>
                                                    <TextBlock Text="{Binding LockedUntil, StringFormat='Locked until: {0:yyyy-MM-dd HH:mm:ss}'}"
                                                               Classes="caption"
                                                               Foreground="{DynamicResource SubtleForeground}"
                                                               IsVisible="{Binding LockedUntil, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <Border Grid.Row="0"
                                    Grid.RowSpan="3"
                                    IsVisible="{Binding CurrentSessionInspector.IsLoadingSessions}"
                                    Background="{DynamicResource LoadingOverlay}"
                                    IsHitTestVisible="True">
                                <Border Background="{DynamicResource CardBackground}"
                                        Padding="32,24"
                                        CornerRadius="{StaticResource RadiusLarge}"
                                        BorderThickness="1"
                                        BorderBrush="{DynamicResource BorderDefault}"
                                        BoxShadow="0 12 32 0 #38000000"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        MinWidth="280">
                                    <StackPanel Spacing="16" HorizontalAlignment="Center">
                                        <ProgressBar IsIndeterminate="True"
                                                     Width="200"
                                                     Height="4"
                                                     Foreground="{DynamicResource AccentBrand}"
                                                     Background="{DynamicResource BorderDefault}"/>
                                        <StackPanel Spacing="8" HorizontalAlignment="Center">
                                            <TextBlock Text="Loading Sessions"
                                                       FontSize="16"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource AppForeground}"
                                                       HorizontalAlignment="Center"/>
                                            <TextBlock Text="Please wait while we inspect the available sessions..."
                                                       FontSize="13"
                                                       Foreground="{DynamicResource SubtleForeground}"
                                                       HorizontalAlignment="Center"
                                                       TextAlignment="Center"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </Border>
                        </Grid>
                    </TabItem.Content>
                </TabItem>
            </TabControl>
        </Grid>
    </Border>
    <GridSplitter x:Name="InspectorSplitter" Grid.Column="1" Classes="workspace-splitter"
                  ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                  HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                  AutomationProperties.Name="Resize message list and inspector"/>
    <Border x:Name="InspectorHost" Grid.Column="2">
        <Border.IsVisible>
            <MultiBinding Converter="{x:Static BoolConverters.And}">
                <Binding Path="CurrentNavigation.IsSessionInspectorTabSelected" Converter="{x:Static BoolConverters.Not}"/>
                <Binding Path="CurrentMessageOps.LockedMessages.Count" Converter="{StaticResource IntEqualsConverter}" ConverterParameter="0"/>
                <Binding Path="CurrentMessageOps.IsMultiSelectMode" Converter="{x:Static BoolConverters.Not}"/>
            </MultiBinding>
        </Border.IsVisible>
        <controls:MessageInspectorView x:Name="InspectorPanel"/>
    </Border>
    </Grid>
    </Grid>
</UserControl>
